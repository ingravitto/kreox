---
import Base from '../layouts/Base.astro';
import { NIVELACION } from '../data/site';
---
<Base title="Gracias | KREOX" description="Hemos recibido tu consulta. El departamento comercial de KREOX te responderá lo antes posible." noindex>
  <section class="section">
    <div class="container prose">
      <h1>¡Gracias! Hemos recibido tu mensaje</h1>
      <p class="lead">Nuestro departamento comercial te responderá lo antes posible. Si quieres la tarifa 2027, pídela por WhatsApp.</p>
      <p>Mientras tanto, puedes calcular cuántos niveladores necesitas con nuestra <a href={`${NIVELACION}calculadora/`}>calculadora</a>.</p>
      <a class="btn btn--dark" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>
