---
import PageHero from '../components/PageHero.astro';
import imgHeroBg from '../assets/img/packaging-kreox-kalzo-kuna.jpg';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaTarifa from '../components/CtaTarifa.astro';
import { NIVELACION, AZULEJOS, SITE } from '../data/site';
import imgFabrica from '../assets/img/hero-productos-kreox.jpg';
import SelloPatentado from '../components/SelloPatentado.astro';
import EneIcon from '../components/EneIcon.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import { getNoticias } from '../data/noticias';

const noticias = (await getNoticias()).filter((n) => n.data.category === 'empresa' || n.data.category === 'comunidad').slice(0, 3);
---
<Base
  overlay
  title="KREOX · Fabricante español de sistemas de nivelación"
  description="KREOX, fabricante familiar de tercera generación en Ibi (Alicante). Diseñamos y fabricamos en España niveladores para mortero autonivelante y azulejos."
  breadcrumbs={[{ name: 'Empresa', url: '/empresa/' }]}
>
  <PageHero
    eyebrow="Tercera generación"
    title="Tres generaciones fabricando en"
    accent="Ibi (Alicante)"
    lead="Búsqueda constante de la perfección en la mejora de nuestros productos. Somos <strong>fabricantes nacionales</strong>."
    bg={imgHeroBg}
    bgAlt="Bolsas de Kalzo y Kuña Antimanchas KREOX"
    crumbs={[{ name: 'Empresa', url: '/empresa/' }]}
  />
  <section class="section">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow">Nos gusta definirnos</span>
        <h2>Somos fabricantes nacionales</h2>
        <p class="lead">Diseñamos y fabricamos en España los niveladores <a class="link" href={`${NIVELACION}piko/`}>PIKO</a> y <a class="link" href={`${NIVELACION}nivelador-universal/`}>Universal</a> para mortero autonivelante, y el <a class="link" href={AZULEJOS}>sistema de nivelación para azulejos</a> Kalzo, Kuña y Alikates.</p>
        <p class="muted">KREOX es una marca de {SITE.legalName}</p>
      </div>
      <Image src={imgFabrica} alt="Gama de productos KREOX: niveladores PIKO y Universal, Kalzos y Kuñas" widths={[600, 1100]} sizes="(min-width: 960px) 520px, 92vw" class="photo" />
    </div>
  </section>
  <section class="section section--paper">
    <div class="container">
      <div class="section-head"><h2>Lo que supone ser fabricante</h2></div>
      <div class="grid grid-4">
        <div class="card"><h3>Precio competitivo</h3><p class="muted mt-0">Precio de fabricante nacional.</p></div>
        <div class="card"><h3>Calidad garantizada</h3><p class="muted mt-0">Las mejoras se prueban en obra real antes de lanzarlas.</p></div>
        <div class="card"><h3>Agilidad de pedidos</h3><p class="muted mt-0">Fabricación nacional, sin esperas de importación.</p></div>
        <div class="card"><h3>Made in Spain</h3><p class="muted mt-0">Diseño y fabricación en España con material reciclado.</p></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div>
        <h2>Innovación y patentes</h2>
        <p>Nuestros niveladores para mortero autonivelante son <strong>productos patentados</strong>, y cada año incorporamos mejoras que nacen de la experiencia de los profesionales en obra: en 2026, la anilla con aditivo de fibra, el nuevo color de alta visibilidad y la base reforzada del Nivelador Universal.</p>
        <p>Nuestros productos ofrecen además un agarre superior y se fabrican con material reciclado.</p>
      </div>
      <div class="seals">
        <SelloPatentado size={170} />
        <div class="made-badge"><EneIcon size={110} /><span>Diseñado y fabricado en España</span></div>
      </div>
    </div>
  </section>
  <section class="section section--paper">
    <div class="container split split--top">
      <div>
        <span class="eyebrow">Dónde estamos</span>
        <h2>Fabricamos en Ibi, en la Foia de Castalla (Alicante)</h2>
        <p>Desde nuestras instalaciones en Ibi diseñamos, fabricamos y enviamos los niveladores para mortero autonivelante y el sistema de colocación de azulejos KREOX. Atendemos a profesionales y distribuidores, y tenemos un contacto específico para distribución y exportación.</p>
        <p class="muted">KREOX forma parte de AIMPLAS, AIJU e IBIAE, la Asociación de Empresarios de la Foia de Castalla.</p>
      </div>
      <address class="card place">
        <strong>{SITE.legalName}</strong>
        <span>{SITE.address.street}</span>
        <span>{SITE.address.postalCode} {SITE.address.city} ({SITE.address.region})</span>
        <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp {SITE.whatsappDisplay}<span class="visually-hidden"> (se abre en una nueva ventana)</span></a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={`mailto:${SITE.emailExport}`}>Exportación: {SITE.emailExport}</a>
        <a class="arrow-link" href="/contacto/">Ir a contacto</a>
      </address>
    </div>
  </section>
  {noticias.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Noticias</span><h2>La vida en KREOX</h2></div>
        <div class="grid grid-3">{noticias.map((n) => <NoticiaCard n={n} />)}</div>
      </div>
    </section>
  )}
  <CtaTarifa />
</Base>
<style>
  .photo { border-radius: var(--radius-xl); width: 100%; }
  .seals { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; justify-content: center; background: var(--ink); border-radius: var(--radius); padding: 40px 32px; }
  .place { display: grid; gap: 6px; font-style: normal; }
  .place strong { margin-bottom: 4px; }
  .place a:not(.arrow-link) { color: var(--ink); }
  .place .arrow-link { margin-top: 10px; }
  .made-badge { display: grid; justify-items: center; gap: 10px; color: var(--white); font-size: .85rem; text-align: center; max-width: 160px; }
</style>
