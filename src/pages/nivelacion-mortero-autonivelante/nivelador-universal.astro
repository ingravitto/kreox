---
import ProductPage from '../../components/ProductPage.astro';
import { NIVELACION, PRODUCTOS, M2_POR_NIVELADOR } from '../../data/site';
import { FAQ_UNIVERSAL } from '../../data/faqs';
import { productSchema, faqSchema } from '../../data/schema';

import imgProducto from '../../assets/img/nivelador-universal-recrecido-kreox.png';
import imgBg from '../../assets/img/hf-universal-recrecido-vertido.jpg';
import imgPlano from '../../assets/img/nivelador-universal-medidas-plano.png';
import imgArandela from '../../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../../assets/img/anilla-metalica-niveladora-universal.png';
import imgPiko from '../../assets/img/piko-nivelador-suelo-radiante-kreox.png';

const P = PRODUCTOS.universal;
const url = `${NIVELACION}nivelador-universal/`;
const M = P.medidas;

const schema = [
  productSchema({
    id: url,
    name: P.nombreCompleto,
    alternateName: ['Nivelador Universal KREOX'],
    description: 'Nivelador con base plana y reforzada para marcar la altura de acabado del mortero autonivelante en recrecidos sobre cualquier superficie. Regulable por láser, reutilizable, sin óxido y con recambios por piezas. Unos 250 g por unidad.',
    images: [imgProducto.src, imgPlano.src],
    weightG: P.pesoG,
    related: `${NIVELACION}piko/`,
    props: [
      ['Uso', P.uso],
      ['Apoyo', P.fijacion],
      ['Presentación', `Caja de ${P.caja} unidades`],
      ['Densidad recomendada', `1 nivelador cada ${M2_POR_NIVELADOR} m² aprox.`],
      ['Medidas (mm)', `Fuste ${M.altoMm}; base ${M.baseAltoMm} de alto y Ø${M.baseMm}; arandela Ø${M.arandelaMm}`],
      ['Compatibilidad láser', 'Láser habitual y láser con receptor'],
      ['Recambios', 'Base niveladora universal, anilla metálica niveladora universal, arandela niveladora'],
      ['Patente', 'Producto patentado'],
    ],
  }),
  faqSchema(FAQ_UNIVERSAL),
];
---
<ProductPage
  kind="universal"
  name="Nivelador Universal"
  seo={{
    title: 'Nivelador Universal para recrecido con autonivelante | KREOX',
    description: 'Nivelador Universal KREOX: base plana y reforzada para recrecidos con mortero autonivelante sobre cualquier superficie. Reutilizable y con recambios.',
    schema,
    image: imgProducto.src,
  }}
  hero={{
    eyebrow: 'Nivelador de mortero autonivelante',
    title: 'Nivelador Universal para',
    accent: 'recrecidos',
    lead: `Base plana y reforzada para marcar la altura del mortero sobre <strong>forjado, solera o pavimento existente</strong>. <strong>${P.pesoG} g</strong>, sin óxido y con recambios por piezas.`,
    bg: imgBg,
    bgAlt: 'Mortero autonivelante avanzando entre Niveladores Universales sobre una solera',
    product: imgProducto,
    productAlt: 'Nivelador Universal de KREOX con base verde lima y fuste azul',
  }}
  kpis={[
    { v: String(P.pesoG), u: 'g', l: 'Peso por unidad' },
    { v: String(M.baseMm), u: 'mm', l: 'Diámetro de base' },
    { v: String(P.caja), u: 'uds', l: 'Por caja' },
    { v: '3', u: 'piezas', l: 'Con recambio' },
  ]}
  plano={{ img: imgPlano, alt: `Plano con medidas del Nivelador Universal: fuste de ${M.altoMm} mm, base de ${M.baseAltoMm} mm de alto y ${M.baseMm} mm de diámetro, arandela de ${M.arandelaMm} mm` }}
  specs={[
    ['Uso', 'Recrecidos y nivelación de pavimentos con mortero autonivelante'],
    ['Apoyo', 'Base plana y estable (reforzada en 2026)'],
    ['Peso', `≈ ${P.pesoG} g`],
    ['Medidas', `Fuste ${M.altoMm} mm · base ${M.baseAltoMm} mm de alto y Ø${M.baseMm} mm · fuste ${M.fusteMm} mm · arandela Ø${M.arandelaMm} mm`],
    ['Presentación', `Caja de ${P.caja} unidades`],
    ['Colocación', `1 nivelador cada ${M2_POR_NIVELADOR} m² aprox.`],
    ['Regulación', 'Anilla deslizante; versión 2026 con aditivo de fibra'],
    ['Láser', 'Habitual y con receptor'],
    ['Recambios', `<a href="${NIVELACION}recambios/">Base, anilla metálica y arandela</a>`],
    ['Origen', 'Diseñado y fabricado en Ibi (Alicante) · patentado'],
  ]}
  steps={[
    { title: 'Apoya el nivelador', text: `Sobre la superficie a recrecer: la base plana lo mantiene estable. Aproximadamente uno cada ${M2_POR_NIVELADOR} m².` },
    { title: 'Marca la cota', text: 'Con un láser nivelador, habitual o con receptor.' },
    { title: 'Ajusta la anilla', text: 'Deslízala hasta la línea marcada por el láser.' },
    { title: 'Vierte y retira', text: 'Mortero hasta la anilla; retira el nivelador y límpialo para la siguiente obra.' },
  ]}
  video={{ src: '/videos/nivelador-universal-instalacion.mp4', poster: '/videos/nivelador-universal-instalacion-poster.jpg', text: 'Instalación real: marcado con láser con receptor y ajuste de la anilla.', duration: 119 }}
  parts={[
    { img: imgBase, alt: 'Base niveladora universal de recambio', name: 'Base niveladora universal', caja: 'Reforzada 2026 · caja de 40' },
    { img: imgAnilla, alt: 'Anilla metálica niveladora universal de recambio', name: 'Anilla metálica', caja: 'Caja de 40' },
    { img: imgArandela, alt: 'Arandela niveladora con aditivo de fibra', name: 'Arandela niveladora', caja: 'Caja de 150' },
  ]}
  other={{ name: '¿Suelo radiante con placa de aislamiento?', text: 'Usa el PIKO, que se clava y pesa solo 20 g →', href: `${NIVELACION}piko/`, img: imgPiko, alt: 'PIKO' }}
  film={{ src: '/videos/universal-vertido-recrecido.mp4', poster: imgBg, label: 'Vertido de mortero autonivelante en un recrecido con Niveladores Universales', title: 'Recrecido perfecto', accent: 'sobre cualquier soporte.' }}
  faqs={FAQ_UNIVERSAL}
  faqTitle="Preguntas frecuentes sobre el Nivelador Universal"
  cta={{ title: '¿Tienes un recrecido en marcha?', text: 'Pide por WhatsApp la tarifa 2027 de Niveladores Universales y recambios.' }}
/>
