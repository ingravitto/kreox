---
import ProductPage from '../../components/ProductPage.astro';
import { NIVELACION, PRODUCTOS, M2_POR_NIVELADOR } from '../../data/site';
import { FAQ_PIKO } from '../../data/faqs';
import { productSchema, faqSchema } from '../../data/schema';

import imgProducto from '../../assets/img/piko-nivelador-suelo-radiante-kreox.png';
import imgBg from '../../assets/img/suelo-radiante-piko-bn.jpg';
import imgPlano from '../../assets/img/piko-medidas-plano.png';
import imgComo from '../../assets/img/piko-como-funciona-suelo-radiante.png';
import imgLaser from '../../assets/img/piko-laser-receptor-suelo-radiante.jpg';
import imgCaja from '../../assets/img/caja-100-piko.jpg';
import imgLimpieza from '../../assets/img/piko-limpieza-reutilizable.jpg';
import imgTriPesado from '../../assets/img/tripodes-acero-pesados.jpg';
import imgTriOxido from '../../assets/img/tripodes-acero-oxidados.jpg';
import imgArandela from '../../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../../assets/img/anilla-metalica-niveladora-universal.png';
import imgUni from '../../assets/img/nivelador-universal-recrecido-kreox.png';

const P = PRODUCTOS.piko;
const url = `${NIVELACION}piko/`;
const M = P.medidas;

const schema = [
  productSchema({
    id: url,
    name: P.nombreCompleto,
    alternateName: ['PIKO KREOX', 'Nivelador Aislamiento 1 PiKo'],
    description: 'Nivelador para mortero autonivelante que se clava en la placa de aislamiento del suelo radiante y marca la altura de acabado con una anilla regulable por láser. Sustituye al trípode de acero: unos 20 g por unidad, no se oxida y es reutilizable.',
    images: [imgProducto.src, imgPlano.src],
    weightG: P.pesoG,
    related: `${NIVELACION}nivelador-universal/`,
    props: [
      ['Uso', P.uso],
      ['Fijación', P.fijacion],
      ['Presentación', `Caja de ${P.caja} unidades`],
      ['Densidad recomendada', `1 nivelador cada ${M2_POR_NIVELADOR} m² aprox.`],
      ['Medidas (mm)', `Fuste ${M.altoMm} + punta ${M.puntaMm}; base Ø${M.baseMm}; arandela Ø${M.arandelaMm}`],
      ['Compatibilidad láser', 'Láser habitual y láser con receptor'],
      ['Reutilizable', 'Sí'],
      ['Patente', 'Producto patentado'],
    ],
  }),
  faqSchema(FAQ_PIKO),
];
---
<ProductPage
  kind="piko"
  name="PIKO"
  seo={{
    title: 'PIKO · Nivelador de mortero autonivelante para suelo radiante | KREOX',
    description: 'PIKO de KREOX sustituye al trípode de acero en suelo radiante: 20 g, sin óxido, reutilizable y compatible con láser. Producto patentado, fabricado en España.',
    schema,
    image: imgProducto.src,
  }}
  hero={{
    eyebrow: 'Nivelador para suelo radiante',
    title: 'PIKO, el nivelador para mortero autonivelante en',
    accent: 'suelo radiante',
    lead: `El <strong>PIKO de KREOX</strong> se clava en la placa de aislamiento y marca la altura exacta del mortero autonivelante. Sustituye al trípode de acero: <strong>${P.pesoG} gramos frente a cerca de 1 kg</strong>, <strong>sin óxido</strong> y <strong>reutilizable</strong>. Compatible con láser habitual o con receptor.`,
    bg: imgBg,
    bgAlt: 'Suelo radiante con niveladores PIKO clavados antes del vertido',
    product: imgProducto,
    productAlt: 'PIKO de KREOX, nivelador azul con anilla verde lima para mortero autonivelante',
  }}
  kpis={[
    { v: String(P.pesoG), u: 'g', l: 'Peso por unidad' },
    { v: String(M.altoMm + M.puntaMm), u: 'mm', l: 'Altura total' },
    { v: String(P.caja), u: 'uds', l: 'Por caja' },
    { v: String(M2_POR_NIVELADOR), u: 'm²', l: 'Por nivelador (aprox.)' },
  ]}
  plano={{ img: imgPlano, alt: `Plano con medidas del PIKO: fuste de ${M.altoMm} mm, punta de ${M.puntaMm} mm, base de ${M.baseMm} mm y arandela de ${M.arandelaMm} mm` }}
  specs={[
    ['Uso', 'Mortero autonivelante sobre placa de aislamiento de suelo radiante'],
    ['Fijación', 'Punta que se clava en el aislamiento'],
    ['Peso', `≈ ${P.pesoG} g`],
    ['Medidas', `Fuste ${M.altoMm} mm + punta ${M.puntaMm} mm · base Ø${M.baseMm} mm · fuste ${M.fusteMm} mm · arandela Ø${M.arandelaMm} mm`],
    ['Presentación', `Caja de ${P.caja} unidades`],
    ['Colocación', `1 nivelador cada ${M2_POR_NIVELADOR} m² aprox.`],
    ['Regulación', 'Anilla deslizante; versión 2026 con aditivo de fibra'],
    ['Láser', 'Habitual y con receptor'],
    ['Recambio', `<a href="${NIVELACION}recambios/">Arandela niveladora</a> (caja de 150)`],
    ['Origen', 'Diseñado y fabricado en Ibi (Alicante) · patentado'],
  ]}
  steps={[
    { title: 'Clava el PIKO', text: `En la placa de aislamiento del suelo radiante, sin herramientas. Aproximadamente uno cada ${M2_POR_NIVELADOR} m².` },
    { title: 'Marca la cota', text: 'Con un láser nivelador, habitual o con receptor.' },
    { title: 'Ajusta la anilla', text: 'Deslízala hasta la línea marcada por el láser.' },
    { title: 'Vierte y retira', text: 'Mortero hasta la anilla. Después retira el PIKO y límpialo para la próxima obra.' },
  ]}
  stepsMedia={[
    { img: imgComo, alt: 'Esquema del PIKO clavado en la placa de aislamiento con la anilla a la altura del mortero autonivelante' },
    { img: imgLaser, alt: 'Instalador ajustando un PIKO sobre placa de tetones con láser y receptor' },
  ]}
  gallery={[
    { img: imgTriPesado, alt: 'Operario cargando decenas de trípodes de acero', caption: 'Trípodes: pesados', good: false },
    { img: imgTriOxido, alt: 'Trípodes de acero oxidados por el mortero', caption: 'Trípodes: se oxidan', good: false },
    { img: imgCaja, alt: 'Caja con 100 niveladores PIKO', caption: 'PIKO: 100 uds por caja', good: true },
    { img: imgLimpieza, alt: 'PIKO limpiándose en un cubo de agua para reutilizarlo', caption: 'PIKO: se limpia con agua', good: true },
  ]}
  parts={[
    { img: imgArandela, alt: 'Arandela niveladora con aditivo de fibra', name: 'Arandela niveladora', caja: 'Recambio del PIKO · caja de 150' },
    { img: imgBase, alt: 'Base niveladora universal', name: 'Base niveladora universal', caja: 'Para el Universal · caja de 40' },
    { img: imgAnilla, alt: 'Anilla metálica niveladora universal', name: 'Anilla metálica', caja: 'Para el Universal · caja de 40' },
  ]}
  other={{ name: '¿Superficie dura, sin aislamiento?', text: 'Usa el Nivelador Universal, con base plana para recrecidos →', href: `${NIVELACION}nivelador-universal/`, img: imgUni, alt: 'Nivelador Universal' }}
  faqs={FAQ_PIKO}
  faqTitle="Preguntas frecuentes sobre el PIKO"
  cta={{ title: '¿Vas a nivelar un suelo radiante?', text: 'Pide la tarifa 2026 y te asesoramos sobre cuántos PIKO necesitas para tu obra.' }}
/>
