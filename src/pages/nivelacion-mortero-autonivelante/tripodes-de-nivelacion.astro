---
import PageHero from '../../components/PageHero.astro';
import imgHeroBg from '../../assets/img/suelo-radiante-piko-bn.jpg';
import WeightBars from '../../components/WeightBars.astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CompareTripode from '../../components/CompareTripode.astro';
import Faq from '../../components/Faq.astro';
import CtaContacto from '../../components/CtaContacto.astro';
import { NIVELACION, PRODUCTOS, M2_POR_NIVELADOR } from '../../data/site';
import { faqSchema } from '../../data/schema';
import { FAQ_TRIPODE } from '../../data/faqs';
import imgTriPesado from '../../assets/img/tripodes-acero-pesados.jpg';
import imgTriOxido from '../../assets/img/tripodes-acero-oxidados.jpg';
import imgTriMortero from '../../assets/img/tripode-acero-en-mortero.jpg';
import imgCaja from '../../assets/img/caja-100-piko.jpg';
import imgLimpieza from '../../assets/img/piko-limpieza-reutilizable.jpg';
import imgLaser from '../../assets/img/piko-laser-receptor-suelo-radiante.jpg';

const url = `${NIVELACION}tripodes-de-nivelacion/`;
const n = Math.ceil(100 / M2_POR_NIVELADOR);
const faqs = FAQ_TRIPODE;
---
<Base
  overlay
  title="Trípodes de nivelación: alternativa sin óxido | KREOX"
  description="¿Vas a comprar trípodes de nivelación (arañas) para mortero autonivelante? PIKO y Nivelador Universal los sustituyen: 20 g, sin óxido y reutilizables."
  breadcrumbs={[{ name: 'Nivelación autonivelante', url: NIVELACION }, { name: 'Trípodes de nivelación', url }]}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Trípodes de nivelación · comparativa"
    title="La alternativa a los"
    accent="trípodes de nivelación"
    lead={`Antes de comprar más arañas de acero, haz la cuenta: 100 m² son unos ${n} puntos de nivel. Con trípodes, <strong>unos ${(n * PRODUCTOS.tripode.pesoG) / 1000} kg</strong> que cargar, limpiar y vigilar que no se oxiden. Con PIKO, <strong>unos ${(n * PRODUCTOS.piko.pesoG) / 1000} kg</strong> que caben en una caja.`}
    bg={imgHeroBg}
    crumbs={[{ name: 'Nivelación', url: NIVELACION }, { name: 'Trípodes de nivelación', url }]}
  />
  <section class="section section--tight">
    <div class="container container--narrow">
      <h2>Qué es un trípode de nivelación</h2>
      <p class="lead">Un trípode de nivelación, al que en obra también se le llama araña, es un soporte metálico de tres patas con una varilla roscada y una tuerca o placa que se sube o se baja hasta la cota de acabado. Se reparten por toda la superficie, se ajustan con el láser y el mortero autonivelante (la «solera líquida») se vierte hasta su marca. Hace bien su trabajo, pero pesa, hay que asentar las tres patas y el acero sufre con el mortero.</p>
      <p>Los niveladores de KREOX hacen lo mismo: marcan la cota punto a punto. El <a href={`${NIVELACION}piko/`}>PIKO</a> se clava en la placa del suelo radiante y el <a href={`${NIVELACION}nivelador-universal/`}>Nivelador Universal</a> se apoya sobre forjado, solera o pavimento existente.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <WeightBars />
      <div data-reveal><span class="eyebrow">Tabla comparativa</span><h2>Punto por punto</h2><p class="lead">Peso, óxido, limpieza, colocación, transporte, recambios y precio.</p></div>
    </div>
    <div class="container" style="margin-top:48px"><CompareTripode /></div>
  </section>

  <section class="section section--paper">
    <div class="container grid grid-2">
      <div>
        <h2>Lo que da guerra de las arañas de acero</h2>
        <ul class="list">
          <li><strong>Pesado y voluminoso:</strong> cerca de 1 kg por trípode.</li>
          <li><strong>Óxido y difícil limpieza:</strong> el pH alcalino del mortero corroe el acero.</li>
          <li><strong>Colocación lenta:</strong> cada pata debe quedar en la posición correcta.</li>
          <li><strong>Más caro por unidad.</strong></li>
        </ul>
        <div class="grid grid-3 pics">
          <Image src={imgTriPesado} alt="Trípodes de acero pesados cargados por un operario" widths={[316]} />
          <Image src={imgTriOxido} alt="Trípodes de acero oxidados" widths={[316]} />
          <Image src={imgTriMortero} alt="Trípode de acero sumergido en mortero autonivelante" widths={[316]} />
        </div>
      </div>
      <div>
        <h2>Lo que cambia con el PIKO</h2>
        <ul class="list">
          <li><strong>Ligero y pequeño:</strong> unos {PRODUCTOS.piko.pesoG} g; {PRODUCTOS.piko.caja} unidades en una caja.</li>
          <li><strong>Reutilizable y fácil de limpiar:</strong> no se oxida.</li>
          <li><strong>Colocación rápida:</strong> se clava en el aislamiento y su anilla visual facilita verificar el nivel.</li>
          <li><strong>Más económico por unidad.</strong></li>
        </ul>
        <div class="grid grid-3 pics">
          <Image src={imgCaja} alt="Caja de 100 PIKO" widths={[316]} />
          <Image src={imgLimpieza} alt="PIKO limpiándose con agua" widths={[316]} />
          <Image src={imgLaser} alt="PIKO ajustado con láser con receptor sobre suelo radiante" widths={[316]} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="lead">¿Sin aislamiento debajo? En recrecidos sobre forjado, solera o pavimento antiguo, el trípode se sustituye por el <a href={`${NIVELACION}nivelador-universal/`}>Nivelador Universal</a>: base plana, sin patas que asentar y con recambios por pieza. Para saber cuántos te hacen falta, usa la <a href={`${NIVELACION}calculadora/`}>calculadora de niveladores</a>.</p>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaContacto tema="tripode" interes="piko" />
</Base>
<style>
  .list { padding-left: 1.2em; }
  .list li { margin-bottom: 0.5em; }
  .pics { gap: 10px; margin-top: 16px; grid-template-columns: repeat(3, 1fr); }
  .pics :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 10px; }
</style>
