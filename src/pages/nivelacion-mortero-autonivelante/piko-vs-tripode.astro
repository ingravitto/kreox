---
import PageHero from '../../components/PageHero.astro';
import imgHeroBg from '../../assets/img/suelo-radiante-piko-bn.jpg';
import WeightBars from '../../components/WeightBars.astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CompareTripode from '../../components/CompareTripode.astro';
import Faq from '../../components/Faq.astro';
import CtaTarifa from '../../components/CtaTarifa.astro';
import { NIVELACION, PRODUCTOS, M2_POR_NIVELADOR } from '../../data/site';
import { faqSchema } from '../../data/schema';
import { FAQ_TRIPODE } from '../../data/faqs';
import imgTriPesado from '../../assets/img/tripodes-acero-pesados.jpg';
import imgTriOxido from '../../assets/img/tripodes-acero-oxidados.jpg';
import imgTriMortero from '../../assets/img/tripode-acero-en-mortero.jpg';
import imgCaja from '../../assets/img/caja-100-piko.jpg';
import imgLimpieza from '../../assets/img/piko-limpieza-reutilizable.jpg';
import imgLaser from '../../assets/img/piko-laser-receptor-suelo-radiante.jpg';

const url = `${NIVELACION}piko-vs-tripode/`;
const n = Math.ceil(100 / M2_POR_NIVELADOR);
const faqs = FAQ_TRIPODE;
---
<Base
  overlay
  title="PIKO vs trípode de acero para mortero autonivelante | KREOX"
  description="Comparativa entre el trípode de acero y el nivelador PIKO de KREOX: peso, óxido, limpieza, colocación y coste para nivelar mortero autonivelante."
  breadcrumbs={[{ name: 'Nivelación autonivelante', url: NIVELACION }, { name: 'PIKO vs trípode', url }]}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Comparativa"
    title="PIKO frente al"
    accent="trípode de acero"
    lead={`Para nivelar 100 m² se necesitan unos ${n} puntos de nivel. Con trípodes de acero son <strong>unos ${(n * PRODUCTOS.tripode.pesoG) / 1000} kg</strong> que cargar, limpiar y vigilar que no se oxiden. Con PIKO, <strong>unos ${(n * PRODUCTOS.piko.pesoG) / 1000} kg</strong> en una caja.`}
    bg={imgHeroBg}
    crumbs={[{ name: 'Nivelación', url: NIVELACION }, { name: 'PIKO vs trípode', url }]}
  />
  <section class="section">
    <div class="container split">
      <WeightBars />
      <div data-reveal><span class="eyebrow">Tabla comparativa</span><h2>Punto por punto</h2><p class="lead">Peso, óxido, limpieza, colocación, transporte, recambios y precio.</p></div>
    </div>
    <div class="container" style="margin-top:48px"><CompareTripode /></div>
  </section>

  <section class="section section--paper">
    <div class="container grid grid-2">
      <div>
        <h2>El problema del trípode de acero</h2>
        <ul class="list">
          <li><strong>Pesado y voluminoso:</strong> cerca de 1 kg por trípode.</li>
          <li><strong>Óxido y difícil limpieza:</strong> el pH alcalino del mortero corroe el acero.</li>
          <li><strong>Colocación lenta:</strong> cada pata debe quedar en la posición correcta.</li>
          <li><strong>Más caro por unidad.</strong></li>
        </ul>
        <div class="grid grid-3 pics">
          <Image src={imgTriPesado} alt="Trípodes de acero pesados cargados por un operario" widths={[316]} />
          <Image src={imgTriOxido} alt="Trípodes de acero oxidados" widths={[316]} />
          <Image src={imgTriMortero} alt="Trípode de acero sumergido en mortero autonivelante" widths={[316]} />
        </div>
      </div>
      <div>
        <h2>La alternativa: PIKO</h2>
        <ul class="list">
          <li><strong>Ligero y pequeño:</strong> unos {PRODUCTOS.piko.pesoG} g; {PRODUCTOS.piko.caja} unidades en una caja.</li>
          <li><strong>Reutilizable y fácil de limpiar:</strong> no se oxida.</li>
          <li><strong>Colocación rápida:</strong> se clava en el aislamiento y su anilla visual facilita verificar el nivel.</li>
          <li><strong>Más económico por unidad.</strong></li>
        </ul>
        <div class="grid grid-3 pics">
          <Image src={imgCaja} alt="Caja de 100 PIKO" widths={[316]} />
          <Image src={imgLimpieza} alt="PIKO limpiándose con agua" widths={[316]} />
          <Image src={imgLaser} alt="PIKO ajustado con láser con receptor sobre suelo radiante" widths={[316]} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="lead">¿Trabajas sobre superficie dura, sin aislamiento? El <a href={`${NIVELACION}nivelador-universal/`}>Nivelador Universal</a> ofrece las mismas ventajas con base plana para recrecidos.</p>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaTarifa />
</Base>
<style>
  .list { padding-left: 1.2em; }
  .list li { margin-bottom: 0.5em; }
  .pics { gap: 10px; margin-top: 16px; grid-template-columns: repeat(3, 1fr); }
  .pics :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 10px; }
</style>
