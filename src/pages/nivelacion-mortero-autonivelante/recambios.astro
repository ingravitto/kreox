---
import PageHero from '../../components/PageHero.astro';
import imgHeroBg from '../../assets/img/hero-productos-kreox.jpg';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaTarifa from '../../components/CtaTarifa.astro';
import Faq from '../../components/Faq.astro';
import { NIVELACION } from '../../data/site';
import { productSchema, faqSchema } from '../../data/schema';
import imgArandela from '../../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../../assets/img/anilla-metalica-niveladora-universal.png';

const url = `${NIVELACION}recambios/`;
const items = [
  { id: 'arandela-niveladora', name: 'Arandela niveladora', img: imgArandela, para: 'PIKO y Nivelador Universal', caja: 150, alt: 'Arandela niveladora verde lima de recambio para PIKO y Nivelador Universal', text: 'La pieza que marca la altura del mortero. Versión 2026 con aditivo de fibra: más resistente al uso continuo y en un color más visible en obra.' },
  { id: 'base-niveladora-universal', name: 'Base niveladora universal', img: imgBase, para: 'Nivelador Universal', caja: 40, alt: 'Base niveladora universal verde lima de recambio', text: 'Base plana y reforzada que da estabilidad al Nivelador Universal sobre cualquier superficie. Más dura y resistente durante el fraguado.' },
  { id: 'anilla-metalica-niveladora-universal', name: 'Anilla metálica niveladora universal', img: imgAnilla, para: 'Nivelador Universal', caja: 40, alt: 'Anilla metálica niveladora universal de recambio', text: 'Pieza metálica de la base del Nivelador Universal, disponible como recambio para alargar la vida del sistema.' },
];
// FAQ construidas solo con los datos de esta página (piezas, compatibilidad y cajas) y las reglas de tarifa.
const [arandela, base, anilla] = items;
const faqs = [
  { q: '¿Qué recambios hay para los niveladores KREOX?', a: `Tres piezas: la ${arandela.name.toLowerCase()} (para ${arandela.para}), la ${base.name.toLowerCase()} y la ${anilla.name.toLowerCase()} (las dos para el ${base.para}).` },
  { q: '¿Qué recambio lleva el PIKO?', a: `La ${arandela.name.toLowerCase()}, que es la pieza que marca la altura del mortero. La versión 2026 lleva aditivo de fibra y un color más visible en obra.` },
  { q: '¿Por qué comprar recambios y no niveladores nuevos?', a: 'Porque los niveladores son reutilizables: se retiran tras el vertido, se limpian y se vuelven a usar. Si una pieza se desgasta, se cambia solo esa pieza.' },
  { q: '¿Cómo se venden los recambios?', a: `En cajas: ${arandela.name.toLowerCase()}, ${arandela.caja} unidades; ${base.name.toLowerCase()}, ${base.caja} unidades; ${anilla.name.toLowerCase()}, ${anilla.caja} unidades.` },
  { q: '¿Cómo consigo el precio de los recambios?', a: 'Escríbenos por WhatsApp y te enviamos la tarifa 2027 con los precios de niveladores y recambios.' },
];
const schema = items.map((it) =>
  productSchema({ id: `${url}#${it.id}`, name: it.name, description: `${it.text} Recambio para ${it.para}. Caja de ${it.caja} unidades.`, images: [it.img.src], props: [['Compatible con', it.para], ['Presentación', `Caja de ${it.caja} unidades`]] }),
).concat([faqSchema(faqs)]);
---
<Base
  overlay
  title="Recambios para niveladores de mortero autonivelante | KREOX"
  description="Recambios para PIKO y Nivelador Universal: arandela niveladora, base y anilla metálica. Cambia solo la pieza gastada y alarga la vida del sistema."
  breadcrumbs={[{ name: 'Nivelación autonivelante', url: NIVELACION }, { name: 'Recambios', url }]}
  schema={schema}
>
  <PageHero
    compact
    eyebrow="Recambios y accesorios"
    title="Recambios para niveladores"
    accent="PIKO y Universal"
    lead="Cuando una pieza se desgasta, <strong>cambias solo esa pieza</strong>: alargas la vida del sistema y bajas el coste por obra frente a comprar trípodes nuevos."
    bg={imgHeroBg}
    crumbs={[{ name: 'Nivelación', url: NIVELACION }, { name: 'Recambios', url }]}
  />
  <section class="section section--tight">
    <div class="container">
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Recambio</th><th scope="col">Para</th><th scope="col">Presentación</th></tr></thead>
          <tbody>
            {items.map((it) => <tr><th scope="row"><a class="link" href={`#${it.id}`}>{it.name}</a></th><td>{it.para}</td><td>Caja de {it.caja} uds</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container grid">
      {items.map((it) => (
        <article class="card item" id={it.id}>
          <div class="img"><Image src={it.img} alt={it.alt} widths={[300, 600]} sizes="260px" /></div>
          <div>
            <h2>{it.name}</h2>
            <p>{it.text}</p>
            <ul class="checks">
              <li>Compatible con: {it.para}</li>
              <li>Caja de {it.caja} unidades</li>
              <li>Fabricado en España</li>
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <a class="card" href={`${NIVELACION}piko/`}><h3>PIKO →</h3><p class="muted mt-0">Nivelador para suelo radiante. Usa la arandela niveladora.</p></a>
      <a class="card" href={`${NIVELACION}nivelador-universal/`}><h3>Nivelador Universal →</h3><p class="muted mt-0">Para recrecidos. Usa base, anilla metálica y arandela.</p></a>
    </div>
  </section>

  <Faq faqs={faqs} title="Preguntas sobre recambios" />
  <CtaTarifa title="Pide recambios" text="Pide por WhatsApp la tarifa 2027 de recambios y te los enviamos con tu próximo pedido." />
</Base>
<style>
  .item { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 720px) { .item { grid-template-columns: 260px 1fr; } }
  .img { background: var(--sand-soft); border-radius: 12px; padding: 16px; }
  .img :global(img) { width: 100%; height: 220px; object-fit: contain; }
  .item h2 { font-size: 1.4rem; }
  a.card { text-decoration: none; color: inherit; }
</style>
