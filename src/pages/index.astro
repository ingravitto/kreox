---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import Marquee from '../components/Marquee.astro';
import WeightBars from '../components/WeightBars.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import CtaTarifa from '../components/CtaTarifa.astro';
import AutoVideo from '../components/AutoVideo.astro';
import { NIVELACION, AZULEJOS, PRODUCTOS, M2_POR_NIVELADOR } from '../data/site';
import { TILE_PRODUCTS } from '../data/azulejos';
import { getNoticias } from '../data/noticias';

import imgHero from '../assets/img/hf-hero-video-poster.jpg';
import imgPiko from '../assets/img/piko-nivelador-suelo-radiante-kreox.png';
import imgUni from '../assets/img/nivelador-universal-recrecido-kreox.png';
import imgSuelo from '../assets/img/hf-piko-suelo-radiante-laser.jpg';
import imgUniVertido from '../assets/img/hf-universal-recrecido-vertido.jpg';
import imgDetalle from '../assets/img/hf-anilla-fibra-macro.jpg';
import imgArandela from '../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../assets/img/anilla-metalica-niveladora-universal.png';
import imgLineas from '../assets/img/lineas-azulejos.jpg';
import imgFabrica from '../assets/img/niveladores-piko-universal-kreox.jpg';
import SelloPatentado from '../components/SelloPatentado.astro';

const noticias = await getNoticias();
const destacadas = [...noticias.filter((n) => n.data.category === 'nivelacion'), ...noticias.filter((n) => n.data.category !== 'nivelacion')].slice(0, 3);

const steps = [
  { title: 'Coloca', text: `Un nivelador cada ${M2_POR_NIVELADOR} m² aprox.: PIKO clavado en el aislamiento o Universal apoyado.` },
  { title: 'Marca con láser', text: 'Láser habitual o con receptor: los dos sirven.' },
  { title: 'Ajusta la anilla', text: 'Hasta la línea del láser. La anilla es tu referencia visual.' },
  { title: 'Vierte y reutiliza', text: 'Mortero hasta la anilla; retira, limpia y a la siguiente obra.' },
];
---
<Base
  title="KREOX · Niveladores para mortero autonivelante y azulejos"
  description="Fabricante español de niveladores para mortero autonivelante (PIKO y Universal) y sistemas de colocación de azulejos. Material reciclado. Tarifa 2027 por WhatsApp."
  overlay
>
  <!-- HERO -->
  <section class="hero section--dark">
    <Image src={imgHero} alt="Niveladores PIKO y Universal de KREOX sobre mortero autonivelante recién vertido" widths={[960, 1600, 1920]} sizes="100vw" class="hero-bg" loading="eager" fetchpriority="high" />
    <div class="hero-video"><AutoVideo src="/videos/hero-niveladores-kreox.mp4" poster={imgHero} label="PIKO y Nivelador Universal sobre mortero autonivelante" /></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-in on-dark">
      <span class="eyebrow">Innovation for construction</span>
      <h1>Niveladores para mortero autonivelante <span class="sand">fabricados en España</span></h1>
      <p class="lead">PIKO y Nivelador Universal sustituyen al trípode de acero: <strong>hasta 50 veces más ligeros, sin óxido y reutilizables</strong>.</p>
      <div class="btn-row">
        <a class="btn btn--sand" href={PRODUCTOS.piko.url}>Descubre PIKO <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
        <a class="btn btn--ghost" href={PRODUCTOS.universal.url}>Nivelador Universal</a>
      </div>
      <dl class="stats">
        <div><dt><em>{PRODUCTOS.piko.pesoG}</em> g</dt><dd>Pesa un PIKO</dd></div>
        <div><dt>≈ 1 kg</dt><dd>Pesa un trípode</dd></div>
        <div><dt><em>0</em></dt><dd>Óxido</dd></div>
        <div><dt>{PRODUCTOS.piko.caja}</dt><dd>PIKO por caja</dd></div>
      </dl>
    </div>
    <a class="scroll" href="#niveladores" aria-label="Ir a los niveladores"><span></span></a>
  </section>

  <!-- SELECTOR RÁPIDO -->
  <section class="chooser" aria-labelledby="chooser-h">
    <div class="container">
      <h2 id="chooser-h" class="ch-h">¿Qué vas a nivelar?</h2>
      <ul class="ch-list">
        <li><a href={PRODUCTOS.piko.url}><span class="ch-k">Suelo radiante</span><span class="ch-v">PIKO →</span></a></li>
        <li><a href={PRODUCTOS.universal.url}><span class="ch-k">Recrecido sobre forjado o solera</span><span class="ch-v">Nivelador Universal →</span></a></li>
        <li><a href={AZULEJOS}><span class="ch-k">Colocación de azulejos</span><span class="ch-v">Kalzo y Kuñas →</span></a></li>
        <li><a href={`${NIVELACION}calculadora/`}><span class="ch-k">¿Cuántos necesito?</span><span class="ch-v">Calculadora →</span></a></li>
      </ul>
    </div>
  </section>

  <Marquee items={['Producto patentado', 'Fabricado en España', 'Material reciclado', 'Sin óxido', 'Reutilizable', 'Compatible con láser', 'Tercera generación']} />

  <!-- PRODUCTOS -->
  <section class="section" id="niveladores">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Nivelación con mortero autonivelante</span>
          <h2>Dos niveladores. Un mismo método.</h2>
        </div>
        <p class="muted side" data-reveal>Marca la cota con láser, ajusta la anilla y vierte. Elige según el soporte de tu obra.</p>
      </div>
      <div class="bento">
        <a class="prod p1" href={PRODUCTOS.piko.url} data-reveal>
          <div class="pimg"><Image src={imgPiko} alt="PIKO de KREOX, nivelador para suelo radiante" widths={[420, 640]} sizes="(min-width: 960px) 360px, 80vw" /></div>
          <div class="ptext">
            <span class="chip chip--sand">Suelo radiante</span>
            <h3>PIKO</h3>
            <p>Se clava en la placa de aislamiento. Sustituye al trípode con solo {PRODUCTOS.piko.pesoG} g.</p>
            <ul class="specs-inline"><li>{PRODUCTOS.piko.medidas.altoMm} mm</li><li>{PRODUCTOS.piko.pesoG} g</li><li>Caja {PRODUCTOS.piko.caja}</li></ul>
            <span class="arrow-link">Ver PIKO</span>
          </div>
        </a>
        <a class="prod p2" href={PRODUCTOS.universal.url} data-reveal style="--d:.1s">
          <div class="pimg"><Image src={imgUni} alt="Nivelador Universal de KREOX para recrecidos" widths={[420, 640]} sizes="(min-width: 960px) 360px, 80vw" /></div>
          <div class="ptext">
            <span class="chip chip--sand">Recrecidos</span>
            <h3>Nivelador Universal</h3>
            <p>Base plana y reforzada para apoyarlo sobre cualquier superficie.</p>
            <ul class="specs-inline"><li>Base Ø{PRODUCTOS.universal.medidas.baseMm} mm</li><li>{PRODUCTOS.universal.pesoG} g</li><li>Caja {PRODUCTOS.universal.caja}</li></ul>
            <span class="arrow-link">Ver Universal</span>
          </div>
        </a>
        <a class="mini m1" href={`${NIVELACION}calculadora/`} data-reveal>
          <span class="eyebrow">Herramienta</span>
          <h3>¿Cuántos niveladores necesito?</h3>
          <span class="big">m² → uds</span>
          <span class="arrow-link">Calcular</span>
        </a>
        <a class="mini m2" href={`${NIVELACION}recambios/`} data-reveal style="--d:.1s">
          <span class="eyebrow">Recambios</span>
          <h3>Cambia solo la pieza gastada</h3>
          <div class="parts">
            <Image src={imgArandela} alt="Arandela niveladora" widths={[160]} sizes="64px" />
            <Image src={imgBase} alt="Base niveladora universal" widths={[160]} sizes="64px" />
            <Image src={imgAnilla} alt="Anilla metálica niveladora universal" widths={[160]} sizes="64px" />
          </div>
          <span class="arrow-link">Ver recambios</span>
        </a>
        <a class="mini m3" href={`${NIVELACION}piko-vs-tripode/`} data-reveal style="--d:.2s">
          <span class="eyebrow">Comparativa</span>
          <h3>PIKO frente al trípode de acero</h3>
          <span class="big">1 kg → 20 g</span>
          <span class="arrow-link">Comparar</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PESO -->
  <section class="section section--paper">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow">Adiós al trípode de acero</span>
        <h2>Menos peso, cero óxido, más obra.</h2>
        <p class="lead">Los trípodes metálicos pesan cerca de 1 kg, se corroen con el pH alcalino del mortero y hay que asentar sus tres patas. Los niveladores KREOX se colocan en segundos, se limpian con agua y llevan una anilla visual para comprobar el nivel.</p>
        <div class="btn-row">
          <a class="btn btn--dark" href={`${NIVELACION}piko-vs-tripode/`}>Ver comparativa completa</a>
        </div>
      </div>
      <WeightBars />
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="how section section--dark grain">
    <Image src={imgSuelo} alt="Niveladores PIKO clavados en un suelo radiante con la línea del láser a la altura de las anillas" widths={[960, 1920]} sizes="100vw" class="how-bg" />
    <div class="how-shade" aria-hidden="true"></div>
    <div class="container rel how-grid">
      <div>
        <div class="section-head" data-reveal>
          <span class="eyebrow">Cómo funciona</span>
          <h2>Nivelado perfecto en 4 pasos</h2>
          <p>Sin trípodes que asentar ni óxido que limpiar. Compatible con láser habitual y con láser con receptor.</p>
        </div>
        <Steps steps={steps} dark />
      </div>
      <figure class="reel" data-reveal>
        <div class="reel-v" data-inview-wrap>
        <video data-inview controls muted loop preload="none" playsinline data-poster="/videos/reel-kreox-piko-universal-poster.jpg" width="720" height="1280" aria-label="Vídeo: cómo se nivela un suelo con PIKO y Nivelador Universal">
          <source src="/videos/reel-kreox-piko-universal.mp4" type="video/mp4" />
          Tu navegador no puede reproducir el vídeo. <a href="/videos/reel-kreox-piko-universal.mp4">Descárgalo aquí</a>.
        </video>
        <button type="button" class="unmute" data-unmute><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9H3zm13.5 3a4.5 4.5 0 00-2.5-4v8a4.5 4.5 0 002.5-4zM14 3.2v2.1a7 7 0 010 13.4v2.1a9 9 0 000-17.6z" fill="currentColor"/></svg>Activar sonido</button>
        </div>
        <figcaption>Cómo se nivela un suelo, en 30 segundos</figcaption>
      </figure>
    </div>
  </section>

  <!-- EN OBRA (vídeos) -->
  <section class="section section--dark film">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">En obra</span>
          <h2>El mortero sube. <span class="sand">La anilla manda.</span></h2>
        </div>
        <p class="muted side" data-reveal>El autonivelante fluye hasta la anilla de cada nivelador y queda plano. Sin trípodes, sin óxido.</p>
      </div>
      <div class="film-grid">
        <a class="clip" href={PRODUCTOS.piko.url} data-reveal>
          <AutoVideo src="/videos/piko-vertido-suelo-radiante.mp4" poster={imgSuelo} label="Vertido de mortero autonivelante sobre suelo radiante con niveladores PIKO" />
          <span class="clip-cap"><span class="chip chip--sand">PIKO</span> Suelo radiante <span class="arrow-link">Ver</span></span>
        </a>
        <a class="clip" href={PRODUCTOS.universal.url} data-reveal style="--d:.1s">
          <AutoVideo src="/videos/universal-vertido-recrecido.mp4" poster={imgUniVertido} label="Vertido de mortero autonivelante en un recrecido con Niveladores Universales" />
          <span class="clip-cap"><span class="chip chip--sand">Universal</span> Recrecidos <span class="arrow-link">Ver</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- NOVEDADES -->
  <section class="section">
    <div class="container split">
      <div class="nov-media" data-reveal>
        <Image src={imgDetalle} alt="Detalle de la anilla verde lima con aditivo de fibra sobre el fuste azul del PIKO" widths={[600, 1100]} sizes="(min-width: 960px) 560px, 92vw" class="nov-img" />
        <div class="nov-sello"><SelloPatentado size={132} /></div>
      </div>
      <div data-reveal>
        <span class="eyebrow">Novedades 2026</span>
        <h2>Anilla con fibra, nuevo color y base reforzada.</h2>
        <ul class="checks">
          <li>Anilla con aditivo de fibra: más vida útil y regulación más firme.</li>
          <li>Nuevo color de alta visibilidad en obra.</li>
          <li>Base del Nivelador Universal más dura y segura al retirarla.</li>
          <li>Todo probado en obra real antes de lanzarlo.</li>
        </ul>
        <div class="btn-row"><a class="btn btn--dark" href="/noticias/sistemas-de-nivelacion-para-mortero-autonivelante/">Leer la novedad</a></div>
      </div>
    </div>
  </section>

  <!-- AZULEJOS -->
  <section class="tiles section section--paper">
    <Image src={imgLineas} alt="" widths={[960]} sizes="60vw" class="lineart" />
    <div class="container rel">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Soluciones para</span>
          <h2>La colocación de azulejos</h2>
        </div>
        <a class="btn btn--ghost side" href={AZULEJOS} data-reveal>Ver todas las soluciones</a>
      </div>
      <div class="grid grid-4">
        {TILE_PRODUCTS.map((p, i) => (
          <a class="tile" href={`${AZULEJOS}${p.slug}/`} data-reveal style={`--d:${i * 0.08}s`}>
            <div class="tile-img"><Image src={p.img} alt={p.alt} widths={[300, 600]} sizes="(min-width: 960px) 280px, 45vw" /></div>
            <h3>{p.name}</h3>
            <span class="arrow-link">Ver</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EMPRESA -->
  <section class="section section--graphite grain">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow">Tercera generación</span>
        <h2>Búsqueda constante de la perfección.</h2>
        <p class="lead">Kreox nace de la experiencia transmitida durante años por las tres generaciones de nuestra familia. Somos fabricantes nacionales, en Ibi (Alicante).</p>
        <dl class="stats">
          <div><dt>3ª</dt><dd>Generación</dd></div>
          <div><dt>100<em class="sand">%</em></dt><dd>Hecho en España</dd></div>
          <div><dt>♻</dt><dd>Material reciclado</dd></div>
        </dl>
        <div class="btn-row"><a class="btn btn--sand" href="/empresa/">Conócenos</a></div>
      </div>
      <div data-reveal><Image src={imgFabrica} alt="Niveladores PIKO y Universal de KREOX, fabricados en Ibi (Alicante)" widths={[600, 1100]} sizes="(min-width: 960px) 560px, 92vw" class="fab" /></div>
    </div>
  </section>

  <!-- NOTICIAS -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Noticias</span>
          <h2>Lo último de KREOX</h2>
        </div>
        <a class="btn btn--ghost side" href="/noticias/" data-reveal>Todas las noticias</a>
      </div>
      <div class="grid grid-3">{destacadas.map((n) => <NoticiaCard n={n} />)}</div>
    </div>
  </section>

  <CtaTarifa />
</Base>

<style>
  .rel { position: relative; }
  .chooser { background: var(--ink); border-top: 1px solid var(--line-dark); padding: 28px 0 36px; }
  .ch-h { color: var(--white); font-size: 1.05rem; font-weight: 500; letter-spacing: 0; margin-bottom: 16px; }
  .ch-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .ch-list a { display: flex; flex-direction: column; gap: 4px; min-height: 76px; justify-content: center; padding: 16px 20px; border-radius: var(--radius); border: 1px solid var(--line-dark); background: rgba(255,255,255,.04); color: var(--on-dark); text-decoration: none; transition: border-color .25s, background .25s, transform .25s var(--ease); }
  .ch-list a:hover, .ch-list a:focus-visible { border-color: var(--sand); background: rgba(199,178,154,.08); transform: translateY(-2px); }
  .ch-k { font-size: .9rem; color: var(--on-dark-soft); }
  .ch-v { font-size: 1.1rem; font-weight: 600; color: var(--white); }
  /* Hero */
  .hero { position: relative; min-height: min(100svh, 820px); display: flex; align-items: center; overflow: hidden; padding: calc(var(--header-h) + 32px) 0 clamp(40px, 5vw, 64px); }
  .hero-bg, .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 75% center; }
  .hero-video :global(video) { object-position: 70% center; background: transparent; }
  .hero-video :global(.av-toggle) { bottom: 22%; right: 8%; }
  @media (min-width: 960px) {
    .hero { background: #050505; }
    .hero-bg, .hero-video { inset: auto 0 auto auto; top: 50%; width: min(72%, 1180px); height: auto; aspect-ratio: 16 / 9; transform: translateY(-46%); }
    .hero-bg, .hero-video :global(video) { object-position: center; -webkit-mask-image: radial-gradient(ellipse 62% 60% at 60% 56%, #000 48%, transparent 100%); mask-image: radial-gradient(ellipse 62% 60% at 60% 56%, #000 48%, transparent 100%); }
    .hero-shade { background: linear-gradient(0deg, rgba(18,18,17,.85) 0%, rgba(18,18,17,0) 40%) !important; }
  }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18,18,17,.92) 0%, rgba(18,18,17,.6) 38%, rgba(18,18,17,0) 62%), linear-gradient(0deg, rgba(18,18,17,.85) 0%, rgba(18,18,17,0) 40%); }
  .hero-in { position: relative; z-index: 1; }
  @media (max-width: 959px) {
    .hero { align-items: flex-start; padding-bottom: 36vh; background: #050505; }
    .hero .stats { display: none; }
    .hero-bg, .hero-video { inset: auto 0 0 0; top: auto; height: 40vh; }
    .hero-bg, .hero-video :global(video) { object-position: 62% center; -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 32%); mask-image: linear-gradient(180deg, transparent 0%, #000 32%); }
    .scroll { display: none; }
  }
  @media (max-width: 959px) { .hero-shade { display: none; } }
  .hero h1 { max-width: 19ch; font-size: clamp(2.2rem, 4.3vw, 3.9rem); }
  .hero .lead { max-width: 560px; color: var(--on-dark); }
  .hero .stats { max-width: 640px; margin-top: clamp(28px, 3.5vw, 44px); }
  .hero .stats dt { font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .hero .btn-row { margin-top: 1.5em; }
  .hero .lead, .hero .btn-row, .hero .stats { animation: rise 1s var(--ease) both; }
  .hero .lead { animation-delay: .2s; } .hero .btn-row { animation-delay: .3s; } .hero .stats { animation-delay: .45s; }
  .scroll { position: absolute; right: var(--gutter); bottom: 40px; width: 26px; height: 44px; border: 1px solid rgba(255,255,255,.4); border-radius: 99px; display: none; }
  .scroll span { position: absolute; left: 50%; top: 9px; width: 3px; height: 8px; border-radius: 3px; background: var(--sand); translate: -50% 0; animation: wheel 1.8s ease-in-out infinite; }
  @media (min-width: 960px) { .scroll { display: block; } }
  @keyframes heroZoom { from { transform: scale(1.1); } to { transform: scale(1); } }
  @keyframes rise { from { transform: translateY(18px); } to { transform: none; } }
  @keyframes wheel { 0% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 0 40px; margin-bottom: clamp(36px, 5vw, 64px); }
  .head-row .section-head { margin-bottom: 0; }
  .side { max-width: 340px; margin: 16px 0 0; }

  /* Bento de productos */
  .bento { display: grid; gap: 18px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .bento { grid-template-columns: repeat(6, 1fr); } .p1, .p2 { grid-column: span 3; } .mini { grid-column: span 2; } }
  .prod { position: relative; display: grid; background: #000; color: var(--on-dark); border-radius: var(--radius-xl); overflow: hidden; text-decoration: none; isolation: isolate; transition: transform .45s var(--ease); }
  .prod:hover { transform: translateY(-6px); }
  .prod::before { content: ''; position: absolute; inset: auto -20% -40% -20%; height: 70%; background: radial-gradient(ellipse at center, rgba(200,225,29,.18), transparent 65%); z-index: -1; transition: opacity .45s; opacity: .6; }
  .prod:hover::before { opacity: 1; }
  .pimg { overflow: hidden; }
  .pimg :global(img) { width: 100%; max-height: 420px; object-fit: contain; transition: transform .8s var(--ease); }
  .prod:hover .pimg :global(img) { transform: scale(1.04); }
  .ptext { padding: 4px clamp(24px, 3vw, 36px) clamp(26px, 3vw, 36px); }
  .ptext h3 { color: var(--white); font-size: clamp(1.8rem, 3vw, 2.5rem); margin: 18px 0 10px; letter-spacing: -0.03em; }
  .ptext p { color: var(--on-dark-soft); }
  .specs-inline { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-wrap: wrap; gap: 0; }
  .specs-inline li { font-size: 0.8rem; letter-spacing: .08em; color: var(--white); padding: 0 14px; border-left: 1px solid var(--line-dark); }
  .specs-inline li:first-child { padding-left: 0; border: 0; }
  .prod .arrow-link { color: var(--sand); }
  .mini { display: flex; flex-direction: column; gap: 6px; padding: clamp(22px, 2.6vw, 30px); border-radius: var(--radius-xl); background: var(--paper); text-decoration: none; transition: transform .45s var(--ease), background .3s; min-height: 240px; }
  .mini:hover { transform: translateY(-6px); background: var(--sand-soft); }
  .mini .eyebrow { margin-bottom: .4em; }
  .mini h3 { margin: 0; }
  .mini .big { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 600; letter-spacing: -0.03em; color: var(--sand-strong); margin: auto 0 10px; }
  .mini .arrow-link { margin-top: auto; }
