---
// English version of /gracias/ (not indexed)
import Base from '../../layouts/Base.astro';
import { PATHS } from '../../i18n/routes';
const R = PATHS.en;
---
<Base title="Thank you | KREOX" description="We have received your message. The KREOX sales team will reply as soon as possible." noindex>
  <section class="section">
    <div class="container prose">
      <h1>Thank you! We have received your message</h1>
      <p class="lead">Our sales team will reply as soon as possible. If it is urgent, message us on WhatsApp.</p>
      <p>In the meantime, you can work out how many levelers you need with our <a href={R.calculadora}>calculator</a>.</p>
      <a class="btn btn--dark" href={R.home}>Back to home</a>
    </div>
  </section>
</Base>
