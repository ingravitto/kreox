---
// English version of /colocacion-azulejos/
import PageHero from '../../../components/PageHero.astro';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import CtaContacto from '../../../components/CtaContacto.astro';
import { SITE, waConsulta } from '../../../data/site';
import { PATHS } from '../../../i18n/routes';
import { TILE_PRODUCTS_EN, TILE_FAQ_EN } from '../../../data/en/tiles';
import { faqSchema } from '../../../data/schema';
import imgSistema from '../../../assets/img/sistema-nivelacion-azulejos-kreox.png';

const R = PATHS.en;
---
<Base
  overlay
  title="Tile levelling system for tile installation | KREOX"
  description="KREOX Kalzo spacer clip, Kuña levelling wedge, stain-resistant Kuña and Alikates: a tile levelling system made in Spain from recycled material."
  breadcrumbs={[{ name: 'Tile installation', url: R.azulejos }]}
  schema={[faqSchema(TILE_FAQ_EN)]}
>
  <PageHero
    eyebrow="Solutions for"
    title="Tile"
    accent="installation"
    lead="Kalzos, Kuñas and Alikates to lay ceramic tiles flat and without lippage, made in Spain from recycled material."
    product={imgSistema}
    productAlt="KREOX Kalzo and Kuña: 100% recycled material, better grip and clean break"
    crumbs={[{ name: 'Tile installation', url: R.azulejos }]}
  >
    <div class="chips" style="margin-top:24px"><span class="chip chip--sand">Compatible with every wedge</span><span class="chip">Clean break</span><span class="chip">Tiles from 3 to 15 mm</span></div>
    <div class="btn-row">
      <a class="btn btn--sand" href={waConsulta('azulejos', 'en')} target="_blank" rel="noopener">Ask us on WhatsApp<span class="visually-hidden"> (opens WhatsApp)</span></a>
    </div>
  </PageHero>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head"><h2>Products</h2></div>
      <div class="grid grid-4">
        {TILE_PRODUCTS_EN.map((p) => (
          <a class="card prod" href={`${R.azulejos}${p.slug}/`}>
            <Image src={p.img} alt={p.alt} widths={[300, 600]} sizes="(min-width: 900px) 260px, 45vw" />
            <h3>{p.name}</h3>
            <p class="muted">{p.intro}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="card">
        <h3>Do you also work with liquid screed?</h3>
        <p class="muted">If you also pour liquid screed, our Insulation and Universal Screed Levellers replace the metal tripod.</p>
        <a href={R.nivelacion}>See screed levelling systems →</a>
      </div>
    </div>
  </section>

  <Faq faqs={TILE_FAQ_EN} />
  <CtaContacto interes="azulejos" />
</Base>
<style>
  .prod { text-decoration: none; color: inherit; }
  .prod :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; margin-bottom: 14px; }
  .prod p { margin: 0; }
</style>
