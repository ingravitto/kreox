---
// English version of /nivelacion-mortero-autonivelante/calculadora/
import PageHero from '../../../components/PageHero.astro';
import imgHeroBg from '../../../assets/img/suelo-radiante-piko-bn.jpg';
import Base from '../../../layouts/Base.astro';
import Calculadora from '../../../components/Calculadora.astro';
import Faq from '../../../components/Faq.astro';
import CtaContacto from '../../../components/CtaContacto.astro';
import { PRODUCTOS, M2_POR_NIVELADOR } from '../../../data/site';
import { PATHS } from '../../../i18n/routes';
import { faqSchema } from '../../../data/schema';
import { FAQ_CALCULADORA_EN } from '../../../data/en/faqs';

const R = PATHS.en;
const url = R.calculadora;
const rows = [25, 50, 100, 200, 500, 1000].map((m2) => {
  const uds = Math.ceil(m2 / M2_POR_NIVELADOR);
  return { m2, uds, piko: Math.ceil(uds / PRODUCTOS.piko.caja), uni: Math.ceil(uds / PRODUCTOS.universal.caja) };
});
const faqs = FAQ_CALCULADORA_EN;
---
<Base
  overlay
  title="Leveller calculator for liquid screed | KREOX"
  description="Work out how many Insulation or Universal Screed Levellers you need for your liquid screed job: units, boxes and weight versus metal tripods."
  breadcrumbs={[{ name: 'Screed levellers', url: R.nivelacion }, { name: 'Calculator', url }]}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    compact
    eyebrow="Liquid screed · tool"
    title="Leveller"
    accent="calculator"
    lead="Square metres → levellers, boxes and the weight you save compared with the tripod."
    bg={imgHeroBg}
    crumbs={[{ name: 'Levelling', url: R.nivelacion }, { name: 'Calculator', url }]}
  />
  <section class="section section--tight calc-wrap">
    <div class="container container--narrow"><Calculadora /></div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <h2>Quick quantity table</h2>
        <p>With one leveller every {M2_POR_NIVELADOR} m². Insulation Screed Levellers come in boxes of {PRODUCTOS.piko.caja} and Universal Screed Levellers in boxes of {PRODUCTOS.universal.caja}.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Area</th><th scope="col">Levellers</th><th scope="col">Boxes (insulation)</th><th scope="col">Boxes (universal)</th></tr></thead>
          <tbody>
            {rows.map((r) => <tr><th scope="row">{r.m2.toLocaleString('en-US')} m²</th><td>{r.uds.toLocaleString('en-US')}</td><td>{r.piko}</td><td>{r.uni}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="muted">Approximate quantities. Please confirm them for your job with our sales team.</p>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaContacto />
</Base>
