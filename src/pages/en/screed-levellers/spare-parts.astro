---
// English version of /nivelacion-mortero-autonivelante/recambios/
import PageHero from '../../../components/PageHero.astro';
import imgHeroBg from '../../../assets/img/hero-productos-kreox.jpg';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import CtaContacto from '../../../components/CtaContacto.astro';
import Faq from '../../../components/Faq.astro';
import { PATHS } from '../../../i18n/routes';
import { productSchema, faqSchema } from '../../../data/schema';
import imgArandela from '../../../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../../../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../../../assets/img/anilla-metalica-niveladora-universal.png';

const R = PATHS.en;
const url = R.recambios;
const items = [
  { id: 'levelling-washer', name: 'Levelling washer', img: imgArandela, para: 'PIKO and Nivelador Universal', caja: 150, alt: 'Lime-green levelling washer spare part for PIKO and Nivelador Universal', text: 'The part that marks the height of the screed. 2026 version with fibre additive: more resistant to continuous use and in a colour that is easier to see on site.' },
  { id: 'universal-levelling-base', name: 'Universal levelling base', img: imgBase, para: 'Nivelador Universal', caja: 40, alt: 'Lime-green universal levelling base spare part', text: 'Flat, reinforced base that keeps the Nivelador Universal stable on any surface. Harder and more resistant during setting.' },
  { id: 'universal-metal-levelling-ring', name: 'Universal metal levelling ring', img: imgAnilla, para: 'Nivelador Universal', caja: 40, alt: 'Universal metal levelling ring spare part', text: 'Metal part of the Nivelador Universal base, available as a spare part to extend the life of the system.' },
];
// FAQ built only from the data on this page (parts, compatibility and boxes) and WhatsApp contact.
const [washer, base, ring] = items;
const faqs = [
  { q: 'What spare parts are there for KREOX levellers?', a: `Three parts: the ${washer.name.toLowerCase()} (for ${washer.para}), the ${base.name.toLowerCase()} and the ${ring.name.toLowerCase()} (both for the ${base.para}).` },
  { q: 'Which spare part does the PIKO use?', a: `The ${washer.name.toLowerCase()}, the part that marks the height of the screed. The current version has a fibre additive and a colour that is easier to see on site.` },
  { q: 'Why buy spare parts instead of new levellers?', a: 'Because the levellers are reusable: they are removed after pouring, cleaned and used again. If a part wears out, only that part is replaced.' },
  { q: 'How are the spare parts sold?', a: `In boxes: ${washer.name.toLowerCase()}, ${washer.caja} units; ${base.name.toLowerCase()}, ${base.caja} units; ${ring.name.toLowerCase()}, ${ring.caja} units.` },
  { q: 'How do I get spare part prices?', a: 'Message us on WhatsApp with the parts you need and we will send you leveller and spare part prices.' },
];
const schema = items.map((it) =>
  productSchema({ id: `${url}#${it.id}`, name: it.name, description: `${it.text} Spare part for ${it.para}. Box of ${it.caja} units.`, images: [it.img.src], category: 'Screed levellers', props: [['Compatible with', it.para], ['Packaging', `Box of ${it.caja} units`]] }),
).concat([faqSchema(faqs)]);
---
<Base
  overlay
  title="Spare parts for screed levellers | KREOX"
  description="Spare parts for PIKO and Nivelador Universal: levelling washer, base and metal ring. Replace only the worn part and extend the life of the system."
  breadcrumbs={[{ name: 'Screed levellers', url: R.nivelacion }, { name: 'Spare parts', url }]}
  schema={schema}
>
  <PageHero
    compact
    eyebrow="Spare parts and accessories"
    title="Spare parts for"
    accent="PIKO and Universal levellers"
    lead="When a part wears out, <strong>you replace only that part</strong>: you extend the life of the system and lower the cost per job compared with buying new tripods."
    bg={imgHeroBg}
    crumbs={[{ name: 'Levelling', url: R.nivelacion }, { name: 'Spare parts', url }]}
  />
  <section class="section section--tight">
    <div class="container">
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Spare part</th><th scope="col">For</th><th scope="col">Packaging</th></tr></thead>
          <tbody>
            {items.map((it) => <tr><th scope="row"><a class="link" href={`#${it.id}`}>{it.name}</a></th><td>{it.para}</td><td>Box of {it.caja} units</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container grid">
      {items.map((it) => (
        <article class="card item" id={it.id}>
          <div class="img"><Image src={it.img} alt={it.alt} widths={[300, 600]} sizes="260px" /></div>
          <div>
            <h2>{it.name}</h2>
            <p>{it.text}</p>
            <ul class="checks">
              <li>Compatible with: {it.para}</li>
              <li>Box of {it.caja} units</li>
              <li>Made in Spain</li>
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <a class="card" href={R.piko}><h3>PIKO →</h3><p class="muted mt-0">Leveller for underfloor heating. Uses the levelling washer.</p></a>
      <a class="card" href={R.universal}><h3>Nivelador Universal →</h3><p class="muted mt-0">For screeds. Uses the base, metal ring and washer.</p></a>
    </div>
  </section>

  <Faq faqs={faqs} title="Questions about spare parts" />
  <CtaContacto title="Order spare parts" text="Message us on WhatsApp with the parts you need and we will send them with your next order." interes="recambios" />
</Base>
<style>
  .item { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 720px) { .item { grid-template-columns: 260px 1fr; } }
  .img { background: var(--sand-soft); border-radius: 12px; padding: 16px; }
  .img :global(img) { width: 100%; height: 220px; object-fit: contain; }
  .item h2 { font-size: 1.4rem; }
  a.card { text-decoration: none; color: inherit; }
</style>
