---
// English version of /nivelacion-mortero-autonivelante/nivelador-universal/
import ProductPage from '../../../components/ProductPage.astro';
import { PRODUCTOS, M2_POR_NIVELADOR } from '../../../data/site';
import { PATHS } from '../../../i18n/routes';
import { FAQ_UNIVERSAL_EN } from '../../../data/en/faqs';
import { productSchema, faqSchema } from '../../../data/schema';

import imgProducto from '../../../assets/img/nivelador-universal-recrecido-kreox.png';
import imgBg from '../../../assets/img/hf-universal-recrecido-vertido.jpg';
import imgFilm from '../../../assets/img/hf-universal-mortero-a-la-anilla.jpg';
import imgPlano from '../../../assets/img/nivelador-universal-medidas-plano.png';
import imgArandela from '../../../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../../../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../../../assets/img/anilla-metalica-niveladora-universal.png';
import imgPiko from '../../../assets/img/piko-nivelador-suelo-radiante-kreox.png';

const P = PRODUCTOS.universal;
const R = PATHS.en;
const url = R.universal;
const M = P.medidas;

const schema = [
  productSchema({
    id: url,
    name: 'KREOX Universal Screed Leveller',
    alternateName: ['Nivelador Universal', 'Nivelador Universal KREOX', P.nombreCompleto, 'Universal raised leveller'],
    description: 'Leveller with a flat, reinforced base to mark the datum height of liquid screed in screeds on any surface. Laser adjustable, reusable, rust-free and with spare parts by piece. About 250 g per unit.',
    images: [imgProducto.src, imgPlano.src],
    weightG: P.pesoG,
    category: 'Screed levellers',
    related: R.piko,
    props: [
      ['Use', 'Screeds on any surface'],
      ['Support', 'Rests on its flat base'],
      ['Packaging', `Box of ${P.caja} units`],
      ['Screed', 'Cement-based or anhydrite liquid screed'],
      ['Recommended density', `1 leveller per m² approx.`],
      ['Dimensions (mm)', `Shaft ${M.altoMm}; base ${M.baseAltoMm} high and Ø${M.baseMm}; washer Ø${M.arandelaMm}`],
      ['Laser compatibility', 'Standard laser and laser with receiver'],
      ['Spare parts', 'Universal levelling base, universal metal levelling ring, levelling washer'],
      ['Patent', 'Patented product'],
    ],
  }),
  faqSchema(FAQ_UNIVERSAL_EN),
];
---
<ProductPage
  kind="universal"
  name="Universal Screed Leveller"
  seo={{
    title: 'Universal Screed Leveller for liquid screed | KREOX',
    description: 'The KREOX Universal Screed Leveller has a flat, reinforced base for liquid screed on any surface. Reusable, with spare parts. Made in Spain.',
    schema,
    image: imgProducto.src,
  }}
  hero={{
    eyebrow: 'Flat-base screed leveller',
    title: 'Universal Screed Leveller for',
    accent: 'slabs and subfloors',
    lead: `A flat, reinforced base to mark the height of the screed on a <strong>slab, subfloor or existing floor</strong>. <strong>${P.pesoG} g</strong>, rust-free and with spare parts by piece.`,
    bg: imgBg,
    bgAlt: 'Liquid screed flowing between Universal Screed Levellers on a slab',
    product: imgProducto,
    productAlt: 'KREOX Universal Screed Leveller with a lime-green base and blue shaft',
  }}
  kpis={[
    { v: String(P.pesoG), u: 'g', l: 'Weight per unit' },
    { v: String(M.baseMm), u: 'mm', l: 'Base diameter' },
    { v: String(P.caja), u: 'units', l: 'Per box' },
    { v: '3', u: 'parts', l: 'Replaceable' },
  ]}
  plano={{ img: imgPlano, alt: `Universal Screed Leveller dimension drawing: ${M.altoMm} mm shaft, base ${M.baseAltoMm} mm high and ${M.baseMm} mm in diameter, ${M.arandelaMm} mm washer` }}
  specs={[
    ['Use', 'Screeds and floor levelling with liquid screed'],
    ['Support', 'Flat, stable, reinforced base'],
    ['Weight', `≈ ${P.pesoG} g`],
    ['Dimensions', `Shaft ${M.altoMm} mm · base ${M.baseAltoMm} mm high and Ø${M.baseMm} mm · shaft ${M.fusteMm} mm · washer Ø${M.arandelaMm} mm`],
    ['Packaging', `Box of ${P.caja} units`],
    ['Placement', `1 leveller per m² approx.`],
    ['Adjustment', 'Sliding ring with fibre additive'],
    ['Laser', 'Standard and with receiver'],
    ['Spare parts', `<a href="${R.recambios}">Base, metal ring and washer</a>`],
    ['Origin', 'Designed and made in Ibi (Alicante, Spain) · patented'],
  ]}
  steps={[
    { title: 'Set the leveller down', text: `On the surface to be screeded: the flat base keeps it stable. Roughly one per m².` },
    { title: 'Mark the level', text: 'With a laser level, standard or with receiver.' },
    { title: 'Adjust the ring', text: 'Slide it up to the line marked by the laser.' },
    { title: 'Pour and remove', text: 'Screed up to the ring; remove the leveller and clean it for the next job.' },
  ]}
  video={{ src: '/videos/nivelador-universal-instalacion.mp4', poster: '/videos/nivelador-universal-instalacion-poster.jpg', text: 'Real installation: marking with a laser with receiver and adjusting the ring. Audio in Spanish.', duration: 119 }}
  parts={[
    { img: imgBase, alt: 'Universal levelling base spare part', name: 'Universal levelling base', caja: 'Reinforced · box of 40' },
    { img: imgAnilla, alt: 'Universal metal levelling ring spare part', name: 'Metal ring', caja: 'Box of 40' },
    { img: imgArandela, alt: 'Levelling washer with fibre additive', name: 'Levelling washer', caja: 'Box of 150' },
  ]}
  other={{ name: 'Underfloor heating with insulation board?', text: 'Use the Insulation Screed Leveller: it is pushed in and weighs just 20 g →', href: R.piko, img: imgPiko, alt: 'Insulation Screed Leveller' }}
  film={{ src: '/videos/universal-vertido-recrecido-v2.mp4', poster: imgFilm, label: 'Pouring liquid screed over a slab with Universal Screed Levellers', title: 'On a slab, a floor deck', accent: 'or an old tiled floor.' }}
  faqs={FAQ_UNIVERSAL_EN}
  faqTitle="Universal Screed Leveller: frequently asked questions"
  cta={{ title: 'Got a screed under way?', text: 'Message us on WhatsApp and we will help you with Universal Screed Levellers and spare parts for your screed.' }}
/>
