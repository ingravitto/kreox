---
// English version of /nivelacion-mortero-autonivelante/tripodes-de-nivelacion/
import PageHero from '../../../components/PageHero.astro';
import imgHeroBg from '../../../assets/img/suelo-radiante-piko-bn.jpg';
import WeightBars from '../../../components/WeightBars.astro';
import Base from '../../../layouts/Base.astro';
import VsCards from '../../../components/VsCards.astro';
import CompareTripode from '../../../components/CompareTripode.astro';
import Faq from '../../../components/Faq.astro';
import CtaContacto from '../../../components/CtaContacto.astro';
import { PRODUCTOS, M2_POR_NIVELADOR } from '../../../data/site';
import { PATHS } from '../../../i18n/routes';
import { faqSchema } from '../../../data/schema';
import { FAQ_TRIPODE_EN } from '../../../data/en/faqs';

const R = PATHS.en;
const url = R.vsTripode;
const n = Math.ceil(100 / M2_POR_NIVELADOR);
const faqs = FAQ_TRIPODE_EN;
---
<Base
  overlay
  title="Levelling tripods for liquid screed: the alternative | KREOX"
  description="Buying levelling tripods for liquid screed? KREOX plastic screed levellers do the same job: 20 g instead of about 1 kg, rust-free and cleaned with water."
  breadcrumbs={[{ name: 'Screed levellers', url: R.nivelacion }, { name: 'Levelling tripods', url }]}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Levelling tripods · comparison"
    title="An alternative to"
    accent="levelling tripods"
    lead={`Before you buy more metal tripods, do the maths: levelling 100 m² takes about ${n} level points. With metal tripods that is <strong>about ${(n * PRODUCTOS.tripode.pesoG) / 1000} kg</strong> to carry, clean and keep from rusting. With Insulation Screed Levellers, <strong>about ${(n * PRODUCTOS.piko.pesoG) / 1000} kg</strong> in one box.`}
    bg={imgHeroBg}
    crumbs={[{ name: 'Levelling', url: R.nivelacion }, { name: 'Levelling tripods', url }]}
  />
  <section class="section section--tight">
    <div class="container container--narrow">
      <h2>What a levelling tripod is</h2>
      <p class="lead">A levelling tripod is a three-legged metal stand with a threaded rod and a nut or plate that is wound up or down to the finished datum height. Tripods are spread across the floor, set with a laser and the liquid screed, cement-based or anhydrite, is poured up to their mark. They do the job, but they are heavy, all three legs have to be seated and the steel suffers in the screed.</p>
      <p>KREOX screed levellers do the same job point by point. The <a href={R.piko}>Insulation Screed Leveller</a> is pushed into the underfloor heating insulation board and the <a href={R.universal}>Universal Screed Leveller</a> rests on a slab, subfloor or existing floor.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <WeightBars />
      <div data-reveal><span class="eyebrow">Comparison table</span><h2>Point by point</h2><p class="lead">Weight, rust, cleaning, placement, transport, spare parts and price.</p></div>
    </div>
    <div class="container" style="margin-top:48px"><CompareTripode /></div>
  </section>

  <section class="section section--paper">
    <div class="container"><VsCards /></div>
  </section>

  <section class="section">
    <div class="container">
      <p class="lead">Working on a hard surface without insulation? The <a href={R.universal}>Universal Screed Leveller</a> offers the same advantages with a flat base.</p>
    </div>
  </section>

  <Faq faqs={faqs} />
  <CtaContacto tema="tripode" interes="piko" />
</Base>
<style>
</style>
