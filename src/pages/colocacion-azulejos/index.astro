---
import PageHero from '../../components/PageHero.astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import CtaTarifa from '../../components/CtaTarifa.astro';
import { AZULEJOS, SITE, NIVELACION, waTarifa } from '../../data/site';
import { TILE_PRODUCTS, TILE_FAQ } from '../../data/azulejos';
import { faqSchema } from '../../data/schema';
import imgSistema from '../../assets/img/sistema-nivelacion-azulejos-kreox.png';
---
<Base
  overlay
  title="Sistema de nivelación para colocación de azulejos | KREOX"
  description="Kalzo Separador, Kuña Niveladora, Kuña Antimanchas y Alikates KREOX: sistema de nivelación de baldosas fabricado en España con material reciclado."
  breadcrumbs={[{ name: 'Colocación de azulejos', url: AZULEJOS }]}
  schema={[faqSchema(TILE_FAQ)]}
>
  <PageHero
    eyebrow="Soluciones para"
    title="La colocación de"
    accent="azulejos"
    lead="Kalzos, Kuñas y Alikates diseñados y fabricados en España para colocar baldosas cerámicas de forma ágil, eficiente y precisa, con material reciclado y un agarre superior."
    product={imgSistema}
    productAlt="Kalzo y Kuña KREOX: material 100 % reciclado, mejor agarre y rotura limpia"
    crumbs={[{ name: 'Colocación de azulejos', url: AZULEJOS }]}
  >
    <div class="chips" style="margin-top:24px"><span class="chip chip--sand">Compatible con todas las kuñas</span><span class="chip">Rotura limpia</span><span class="chip">Losas de 3 a 15 mm</span></div>
    <div class="btn-row">
      <a class="btn btn--sand" href={waTarifa("azulejos")} target="_blank" rel="noopener">Pedir tarifa 2027<span class="visually-hidden"> (abre WhatsApp)</span></a>
      <a class="btn btn--ghost" href={SITE.tileCalculator}>Calculadora de piezas</a>
    </div>
  </PageHero>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head"><h2>Productos</h2></div>
      <div class="grid grid-4">
        {TILE_PRODUCTS.map((p) => (
          <a class="card prod" href={`${AZULEJOS}${p.slug}/`}>
            <Image src={p.img} alt={p.alt} widths={[300, 600]} sizes="(min-width: 900px) 260px, 45vw" />
            <h3>{p.name}</h3>
            <p class="muted">{p.intro}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>¿No sabes cuántas piezas necesitas?</h2>
        <p>Con nuestra calculadora estimas la cantidad de Kalzos y Kuñas para tu proyecto: introduce las dimensiones de la baldosa y el área total.</p>
        <a class="btn btn--dark" href={SITE.tileCalculator}>Abrir calculadora de piezas</a>
      </div>
      <div class="card">
        <h3>¿Trabajas también con mortero autonivelante?</h3>
        <p class="muted">Descubre PIKO y el Nivelador Universal, nuestros niveladores que sustituyen al trípode de acero.</p>
        <a href={NIVELACION}>Ver sistemas de nivelación para autonivelante →</a>
      </div>
    </div>
  </section>

  <Faq faqs={TILE_FAQ} />
  <CtaTarifa interes="azulejos" text="Escríbenos por WhatsApp y te enviamos la tarifa 2027 de Kalzos, Kuñas y Alikates." />
</Base>
<style>
  .hero-img { border-radius: 22px; width: 100%; }
  .prod { text-decoration: none; color: inherit; }
  .prod :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; margin-bottom: 14px; }
  .prod p { margin: 0; }
</style>
