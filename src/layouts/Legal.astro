---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import imgHeroBg from '../assets/img/fondo-piedra-productos-kreox.jpg';
interface Props { title: string; description: string; url: string; updated: string }
const { title, description, url, updated } = Astro.props;
import { useT } from '../i18n/ui';
const { t } = useT(Astro.url);
---
<Base overlay title={`${title} | ${t('legalSuffix')}`} description={description} breadcrumbs={[{ name: title, url }]}>
  <PageHero compact eyebrow={t('legalEyebrow')} title={title} lead={`${t('lastUpdated')}: ${updated}`} bg={imgHeroBg} crumbs={[{ name: title, url }]} />
  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>
</Base>
