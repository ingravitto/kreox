---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';
import { organizationSchema, websiteSchema, breadcrumbSchema } from '../data/schema';

interface Crumb { name: string; url: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article' | 'product';
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
}

const { title, description, image = '/img/og-kreox-niveladores.jpg', ogType = 'website', schema = [], breadcrumbs, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
// En el entorno de pruebas (staging) se publica con PUBLIC_NOINDEX=1 para que Google no lo indexe.
const robots = noindex || import.meta.env.PUBLIC_NOINDEX === '1' ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const crumbs = breadcrumbs ? [{ name: 'Inicio', url: '/' }, ...breadcrumbs] : undefined;
const graph = [organizationSchema(), websiteSchema(), ...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...schema];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1c1c1b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Noticias KREOX" href="/noticias/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KREOX" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <JsonLd data={{ '@context': 'https://schema.org', '@graph': graph }} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      {crumbs && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
