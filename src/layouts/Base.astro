---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import InViewVideos from '../components/InViewVideos.astro';
import seoOverrides from '../data/seo-overrides.json';
import f400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import f600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import f500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url';
import { SITE } from '../data/site';
import { organizationSchema, websiteSchema, breadcrumbSchema } from '../data/schema';
import { useT } from '../i18n/ui';
import { alternates } from '../i18n/routes';

interface Crumb { name: string; url: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article' | 'product';
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** La página empieza con un hero oscuro a sangre: la cabecera va transparente encima y las migas se pintan dentro del hero. */
  overlay?: boolean;
}

const { title: pTitle, description: pDescription, image = '/img/og-kreox-niveladores.jpg', ogType = 'website', schema = [], breadcrumbs, noindex = false, overlay = false } = Astro.props;
// Título y descripción personalizados desde el panel (/panel/ → SEO). Si no hay, los de la página.
const ov = (seoOverrides as Record<string, { title?: string; description?: string }>)[Astro.url.pathname];
const title = ov?.title || pTitle;
const description = ov?.description || pDescription;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
// En el entorno de pruebas (staging) se publica con PUBLIC_NOINDEX=1 para que Google no lo indexe.
const robots = noindex || import.meta.env.PUBLIC_NOINDEX === '1' ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const { lang, t, P } = useT(Astro.url);
// hreflang: versiones de esta página en cada idioma (x-default = español).
const alt = alternates(Astro.url.pathname);
const hreflang = Object.entries(alt).map(([l, href]) => ({ l, href: new URL(href, SITE.url).href }));
const xDefault = alt.es ? new URL(alt.es, SITE.url).href : undefined;
const crumbs = breadcrumbs ? [{ name: t('home'), url: P.home }, ...breadcrumbs] : undefined;
const graph = [organizationSchema(), websiteSchema(), ...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...schema];
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && hreflang.length > 1 && hreflang.map((h) => <link rel="alternate" hreflang={h.l} href={h.href} />)}
    {!noindex && hreflang.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#121211" />
    <link rel="preload" href={f600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={f400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={f500} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {lang === 'es' && <link rel="alternate" type="application/rss+xml" title={t('rssTitle')} href="/noticias/rss.xml" />}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KREOX" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    {hreflang.length > 1 && <meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <JsonLd data={{ '@context': 'https://schema.org', '@graph': graph }} />
    {/* Navegación casi instantánea: el navegador precarga la página al pasar el ratón o el dedo por un enlace interno. */}
    <script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: ['/panel/*', '/*.php', '/*\\?*'] } }] }, eagerness: 'moderate' }] })} />
    <slot name="head" />
  </head>
  <body class:list={[{ 'has-overlay': overlay }]}>
    <a class="skip" href="#contenido">{t('skip')}</a>
    <Header overlay={overlay} />
    <main id="contenido">
      {crumbs && !overlay && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <WhatsAppFloat />
    <InViewVideos />
    <script>
      // Entrada suave de bloques al hacer scroll (respeta prefers-reduced-motion vía CSS).
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
        // Si se baja muy rápido, el observador puede saltarse bloques: al parar el scroll se muestran los que ya están por encima o en pantalla.
        let t: number | undefined;
        const sweep = () => document.querySelectorAll('[data-reveal]:not(.is-in)').forEach((el) => { if (el.getBoundingClientRect().top < innerHeight) { el.classList.add('is-in'); io.unobserve(el); } });
        addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(sweep, 120); }, { passive: true });
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
<style is:global>
  main { padding-top: var(--header-h); }
  .has-overlay main { padding-top: 0; }
</style>
