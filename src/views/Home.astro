---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import Marquee from '../components/Marquee.astro';
import WeightBars from '../components/WeightBars.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import CtaContacto from '../components/CtaContacto.astro';
import AutoVideo from '../components/AutoVideo.astro';
import { PRODUCTOS, M2_POR_NIVELADOR, waConsulta } from '../data/site';
import { TILE_PRODUCTS } from '../data/azulejos';
import { TILE_PRODUCTS_EN } from '../data/en/tiles';
import { getNoticias, getNews } from '../data/noticias';
import { useT } from '../i18n/ui';

import imgHero from '../assets/img/hf-hero-video-poster.jpg';
import imgPiko from '../assets/img/piko-nivelador-suelo-radiante-kreox.png';
import imgUni from '../assets/img/nivelador-universal-recrecido-kreox.png';
import imgSuelo from '../assets/img/hf-piko-suelo-radiante-laser.jpg';
import imgUniVertido from '../assets/img/hf-universal-recrecido-vertido.jpg';
import imgArandela from '../assets/img/arandela-niveladora-recambio.png';
import imgBase from '../assets/img/base-niveladora-universal-recambio.png';
import imgAnilla from '../assets/img/anilla-metalica-niveladora-universal.png';
import imgLineas from '../assets/img/lineas-azulejos.jpg';
import imgFabrica from '../assets/img/niveladores-piko-universal-kreox.jpg';

// Portada compartida por / (español) y /en/ (inglés): mismo diseño, textos de T según el idioma de la URL.
const { lang, P } = useT(Astro.url);
const EN = lang === 'en';
const tiles = EN ? TILE_PRODUCTS_EN.map((p) => ({ ...p, href: `${P.azulejos}${p.slug}/` })) : TILE_PRODUCTS.map((p) => ({ ...p, href: `${P.azulejos}${p.slug}/` }));
const posts = EN ? await getNews() : await getNoticias();
const destacadas = [...posts.filter((n) => n.data.category === 'nivelacion'), ...posts.filter((n) => n.data.category !== 'nivelacion')].slice(0, 3);

const T = EN
  ? {
      title: 'Screed levellers for liquid screed & UFH | KREOX',
      description: 'Spanish manufacturer of screed levellers, PIKO and Nivelador Universal, and tile levelling systems. Message us on WhatsApp.',
      heroAlt: 'KREOX PIKO and Nivelador Universal levellers on freshly poured liquid screed',
      heroVideo: 'PIKO and Nivelador Universal on liquid screed',
      h1: 'Screed levellers', h1Accent: 'made in Spain',
      lead: 'PIKO and Nivelador Universal replace the metal tripod: <strong>up to 50 times lighter, rust-free and reusable</strong>.',
      discoverPiko: 'Discover PIKO', statPiko: 'One PIKO weighs', statTripod: 'One tripod weighs', statRust: 'Rust', statBox: 'PIKO per box',
      toLevelers: 'Go to the levellers',
      chooser: 'What are you levelling?',
      ch: [['Underfloor heating', 'PIKO →'], ['Screed on a slab or subfloor', 'Nivelador Universal →'], ['Tile installation', 'Kalzo and Kuñas →'], ['How many do I need?', 'Calculator →']],
      marquee: ['Patented product', 'Made in Spain', 'Recycled material', 'Rust-free', 'Reusable', 'Laser compatible', 'For underfloor heating and screeds'],
      prodEyebrow: 'Levelling with liquid screed', prodTitle: 'Two levellers. One method.',
      prodSide: 'Mark the level with a laser, adjust the ring and pour. Choose according to your substrate.',
      pikoAlt: 'KREOX PIKO, leveller for underfloor heating', pikoChip: 'Underfloor heating',
      pikoText: (g: number) => `Pushed into the insulation board. Replaces the tripod with just ${g} g.`, box: 'Box', seePiko: 'See PIKO',
      uniAlt: 'KREOX Nivelador Universal for screeds', uniChip: 'Screeds', uniText: 'Flat, reinforced base to rest it on any surface.', base: 'Base', seeUni: 'See Universal',
      tool: 'Tool', howMany: 'How many levellers do I need?', units: 'm² → units', calc: 'Calculate',
      partsEyebrow: 'Spare parts', partsTitle: 'Replace only the worn part', washer: 'Levelling washer', uniBase: 'Universal levelling base', ring: 'Universal metal levelling ring', seeParts: 'See spare parts',
      cmpEyebrow: 'Comparison', cmpTitle: 'PIKO versus the metal tripod', compare: 'Compare',
      wEyebrow: 'Goodbye to the metal tripod', wTitle: 'Less weight, zero rust, more work done.',
      wLead: 'Metal tripods weigh about 1 kg, corrode with the alkaline pH of the screed and all three legs must be seated. KREOX levellers are placed in seconds, cleaned with water and have a visual ring to check the level.',
      fullCmp: 'See the full comparison',
      howAlt: 'PIKO levellers pushed into underfloor heating with the laser line at the height of the rings',
      howEyebrow: 'How it works', howTitle: 'A perfect level in 4 steps', howText: 'No tripods to seat and no rust to clean. Works with a standard laser and with a laser with receiver.',
      steps: [
        { title: 'Place', text: `One leveller roughly every ${M2_POR_NIVELADOR} m²: PIKO pushed into the insulation or Universal resting on the substrate.` },
        { title: 'Mark with a laser', text: 'Standard laser or laser with receiver: both work.' },
        { title: 'Adjust the ring', text: 'Up to the laser line. The ring is your visual reference.' },
        { title: 'Pour and reuse', text: 'Screed up to the ring; remove, clean and on to the next job.' },
      ],
      reelAria: 'Video: how a floor is levelled with PIKO and Nivelador Universal', noVideo: 'Your browser cannot play this video.', download: 'Download it here', pause: 'Pause video', sound: 'Turn sound on',
      reelCap: 'How a floor is levelled, in 30 seconds',
      filmEyebrow: 'On site', filmTitle: 'The screed rises.', filmAccent: 'The ring rules.', filmSide: 'The liquid screed flows up to the ring of each leveller and stays flat. No tripods, no rust.',
      clipPiko: 'Pouring liquid screed over underfloor heating with PIKO levellers', clipPikoCap: 'Underfloor heating',
      clipUni: 'Pouring liquid screed over a slab with Nivelador Universal levellers', clipUniCap: 'Screeds', see: 'See',
      tilesEyebrow: 'Solutions for', tilesTitle: 'Tile installation', tilesAll: 'See all solutions',
      coEyebrow: 'Third generation', coTitle: 'A constant search for perfection.',
      coLead: 'Kreox was born from experience passed down over the years by three generations of our family. We are a Spanish manufacturer based in Ibi (Alicante).',
      coGen: 'Generation', coSpain: 'Made in Spain', coRecycled: 'Recycled material', coMeet: 'About us',
      fabAlt: 'KREOX PIKO and Nivelador Universal levellers, made in Ibi (Alicante, Spain)',
      newsEyebrow: 'News', newsTitle: 'The latest from KREOX', newsAll: 'All news',
      proEyebrow: 'For professionals', proTitle: 'Built for people who level floors every day.',
      pros: [
        { t: 'Underfloor heating installers', d: 'PIKO pushes into the insulation board without tools. Box of 100.', l: 'See PIKO', k: 'piko' },
        { t: 'Liquid screed applicators', d: 'Mark the level with a standard laser or a laser with receiver; the ring stays visible while pouring.', l: 'See levellers', k: 'nivelacion' },
        { t: 'Screeds and refurbishment', d: 'Nivelador Universal with a flat base for slabs, subfloors or existing floors.', l: 'See Universal', k: 'universal' },
        { t: 'Direct orders from the factory', d: 'We make and distribute everything ourselves from Ibi (Alicante), with spare parts sold separately.', l: 'Order on WhatsApp', k: 'whatsapp' },
      ],
    }
  : {
      title: 'KREOX · Niveladores para mortero autonivelante y azulejos',
      description: 'Fabricante español de niveladores para mortero autonivelante, PIKO y Universal, y de sistemas para colocar azulejos. Te asesoramos por WhatsApp.',
      heroAlt: 'Niveladores PIKO y Universal de KREOX sobre mortero autonivelante recién vertido',
      heroVideo: 'PIKO y Nivelador Universal sobre mortero autonivelante',
      h1: 'Niveladores para mortero autonivelante', h1Accent: 'fabricados en España',
      lead: 'PIKO y Nivelador Universal sustituyen al trípode de acero: <strong>hasta 50 veces más ligeros, sin óxido y reutilizables</strong>.',
      discoverPiko: 'Descubre PIKO', statPiko: 'Pesa un PIKO', statTripod: 'Pesa un trípode', statRust: 'Óxido', statBox: 'PIKO por caja',
      toLevelers: 'Ir a los niveladores',
      chooser: '¿Qué vas a nivelar?',
      ch: [['Suelo radiante', 'PIKO →'], ['Recrecido sobre forjado o solera', 'Nivelador Universal →'], ['Colocación de azulejos', 'Kalzo y Kuñas →'], ['¿Cuántos necesito?', 'Calculadora →']],
      marquee: ['Producto patentado', 'Fabricado en España', 'Material reciclado', 'Sin óxido', 'Reutilizable', 'Compatible con láser', 'Para suelo radiante y recrecidos'],
      prodEyebrow: 'Nivelación con mortero autonivelante', prodTitle: 'Dos niveladores. Un mismo método.',
      prodSide: 'Marca la cota con láser, ajusta la anilla y vierte. Elige según el soporte de tu obra.',
      pikoAlt: 'PIKO de KREOX, nivelador para suelo radiante', pikoChip: 'Suelo radiante',
      pikoText: (g: number) => `Se clava en la placa de aislamiento. Sustituye al trípode con solo ${g} g.`, box: 'Caja', seePiko: 'Ver PIKO',
      uniAlt: 'Nivelador Universal de KREOX para recrecidos', uniChip: 'Recrecidos', uniText: 'Base plana y reforzada para apoyarlo sobre cualquier superficie.', base: 'Base', seeUni: 'Ver Universal',
      tool: 'Herramienta', howMany: '¿Cuántos niveladores necesito?', units: 'm² → uds', calc: 'Calcular',
      partsEyebrow: 'Recambios', partsTitle: 'Cambia solo la pieza gastada', washer: 'Arandela niveladora', uniBase: 'Base niveladora universal', ring: 'Anilla metálica niveladora universal', seeParts: 'Ver recambios',
      cmpEyebrow: 'Comparativa', cmpTitle: 'PIKO frente al trípode de acero', compare: 'Comparar',
      wEyebrow: 'Adiós al trípode de acero', wTitle: 'Menos peso, cero óxido, más obra.',
      wLead: 'Los trípodes metálicos pesan cerca de 1 kg, se corroen con el pH alcalino del mortero y hay que asentar sus tres patas. Los niveladores KREOX se colocan en segundos, se limpian con agua y llevan una anilla visual para comprobar el nivel.',
      fullCmp: 'Ver comparativa completa',
      howAlt: 'Niveladores PIKO clavados en un suelo radiante con la línea del láser a la altura de las anillas',
      howEyebrow: 'Cómo funciona', howTitle: 'Nivelado perfecto en 4 pasos', howText: 'Sin trípodes que asentar ni óxido que limpiar. Compatible con láser habitual y con láser con receptor.',
      steps: [
        { title: 'Coloca', text: `Un nivelador cada ${M2_POR_NIVELADOR} m² aprox.: PIKO clavado en el aislamiento o Universal apoyado.` },
        { title: 'Marca con láser', text: 'Láser habitual o con receptor: los dos sirven.' },
        { title: 'Ajusta la anilla', text: 'Hasta la línea del láser. La anilla es tu referencia visual.' },
        { title: 'Vierte y reutiliza', text: 'Mortero hasta la anilla; retira, limpia y a la siguiente obra.' },
      ],
      reelAria: 'Vídeo: cómo se nivela un suelo con PIKO y Nivelador Universal', noVideo: 'Tu navegador no puede reproducir el vídeo.', download: 'Descárgalo aquí', pause: 'Pausar vídeo', sound: 'Activar sonido',
      reelCap: 'Cómo se nivela un suelo, en 30 segundos',
      filmEyebrow: 'En obra', filmTitle: 'El mortero sube.', filmAccent: 'La anilla manda.', filmSide: 'El autonivelante fluye hasta la anilla de cada nivelador y queda plano. Sin trípodes, sin óxido.',
      clipPiko: 'Vertido de mortero autonivelante sobre suelo radiante con niveladores PIKO', clipPikoCap: 'Suelo radiante',
      clipUni: 'Vertido de mortero autonivelante en un recrecido con Niveladores Universales', clipUniCap: 'Recrecidos', see: 'Ver',
      tilesEyebrow: 'Soluciones para', tilesTitle: 'La colocación de azulejos', tilesAll: 'Ver todas las soluciones',
      coEyebrow: 'Tercera generación', coTitle: 'Búsqueda constante de la perfección.',
      coLead: 'Kreox nace de la experiencia transmitida durante años por las tres generaciones de nuestra familia. Somos fabricantes nacionales, en Ibi (Alicante).',
      coGen: 'Generación', coSpain: 'Hecho en España', coRecycled: 'Material reciclado', coMeet: 'Conócenos',
      fabAlt: 'Niveladores PIKO y Universal de KREOX, fabricados en Ibi (Alicante)',
      newsEyebrow: 'Noticias', newsTitle: 'Lo último de KREOX', newsAll: 'Todas las noticias',
      proEyebrow: 'Para profesionales', proTitle: 'Pensado para quien nivela todos los días.',
      pros: [
        { t: 'Instaladores de suelo radiante', d: 'El PIKO se clava en la placa de aislamiento sin herramientas. Caja de 100 unidades.', l: 'Ver PIKO', k: 'piko' },
        { t: 'Aplicadores de mortero autonivelante', d: 'Cota con láser habitual o con receptor y anilla visible durante el vertido.', l: 'Ver niveladores', k: 'nivelacion' },
        { t: 'Recrecidos y rehabilitación', d: 'Nivelador Universal con base plana para forjado, solera o pavimento existente.', l: 'Ver Universal', k: 'universal' },
        { t: 'Pedidos directos de fábrica', d: 'Fabricamos y distribuimos nosotros mismos desde Ibi (Alicante), con recambios por pieza.', l: 'Pedir por WhatsApp', k: 'whatsapp' },
      ],
    };

---
<Base
  title={T.title}
  description={T.description}
  overlay
>
  <!-- HERO -->
  <section class="hero section--dark">
    <Image src={imgHero} alt={T.heroAlt} widths={[960, 1600, 1920]} sizes="100vw" class="hero-bg" loading="eager" fetchpriority="high" />
    <div class="hero-video"><AutoVideo src="/videos/hero-niveladores-kreox.mp4" poster={imgHero} label={T.heroVideo} /></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-in on-dark">
      <span class="eyebrow">Innovation for construction</span>
      <h1>{T.h1} <span class="sand">{T.h1Accent}</span></h1>
      <p class="lead" set:html={T.lead} />
      <div class="btn-row">
        <a class="btn btn--sand" href={P.piko}>{T.discoverPiko} <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
        <a class="btn btn--ghost" href={P.universal}>Nivelador Universal</a>
      </div>
      <dl class="stats">
        <div><dt><em>{PRODUCTOS.piko.pesoG}</em> g</dt><dd>{T.statPiko}</dd></div>
        <div><dt>≈ 1 kg</dt><dd>{T.statTripod}</dd></div>
        <div><dt><em>0</em></dt><dd>{T.statRust}</dd></div>
        <div><dt>{PRODUCTOS.piko.caja}</dt><dd>{T.statBox}</dd></div>
      </dl>
    </div>
    <a class="scroll" href="#niveladores" aria-label={T.toLevelers}><span></span></a>
  </section>

  <!-- SELECTOR RÁPIDO -->
  <section class="chooser" aria-labelledby="chooser-h">
    <div class="container">
      <h2 id="chooser-h" class="ch-h">{T.chooser}</h2>
      <ul class="ch-list">
        {[P.piko, P.universal, P.azulejos, P.calculadora].map((href, i) => (
          <li><a href={href}><span class="ch-k">{T.ch[i][0]}</span><span class="ch-v">{T.ch[i][1]}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Marquee items={T.marquee} />

  <!-- PRODUCTOS -->
  <section class="section" id="niveladores">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{T.prodEyebrow}</span>
          <h2>{T.prodTitle}</h2>
        </div>
        <p class="muted side" data-reveal>{T.prodSide}</p>
      </div>
      <div class="bento">
        <a class="prod p1" href={P.piko} data-reveal>
          <div class="pimg"><Image src={imgPiko} alt={T.pikoAlt} widths={[420, 640]} sizes="(min-width: 960px) 360px, 80vw" /></div>
          <div class="ptext">
            <span class="chip chip--sand">{T.pikoChip}</span>
            <h3>PIKO</h3>
            <p>{T.pikoText(PRODUCTOS.piko.pesoG)}</p>
            <ul class="specs-inline"><li>{PRODUCTOS.piko.medidas.altoMm} mm</li><li>{PRODUCTOS.piko.pesoG} g</li><li>{T.box} {PRODUCTOS.piko.caja}</li></ul>
            <span class="arrow-link">{T.seePiko}</span>
          </div>
        </a>
        <a class="prod p2" href={P.universal} data-reveal style="--d:.1s">
          <div class="pimg"><Image src={imgUni} alt={T.uniAlt} widths={[420, 640]} sizes="(min-width: 960px) 360px, 80vw" /></div>
          <div class="ptext">
            <span class="chip chip--sand">{T.uniChip}</span>
            <h3>Nivelador Universal</h3>
            <p>{T.uniText}</p>
            <ul class="specs-inline"><li>{T.base} Ø{PRODUCTOS.universal.medidas.baseMm} mm</li><li>{PRODUCTOS.universal.pesoG} g</li><li>{T.box} {PRODUCTOS.universal.caja}</li></ul>
            <span class="arrow-link">{T.seeUni}</span>
          </div>
        </a>
        <a class="mini m1" href={P.calculadora} data-reveal>
          <span class="eyebrow">{T.tool}</span>
          <h3>{T.howMany}</h3>
          <span class="big">{T.units}</span>
          <span class="arrow-link">{T.calc}</span>
        </a>
        <a class="mini m2" href={P.recambios} data-reveal style="--d:.1s">
          <span class="eyebrow">{T.partsEyebrow}</span>
          <h3>{T.partsTitle}</h3>
          <div class="parts">
            <Image src={imgArandela} alt={T.washer} widths={[160]} sizes="64px" />
            <Image src={imgBase} alt={T.uniBase} widths={[160]} sizes="64px" />
            <Image src={imgAnilla} alt={T.ring} widths={[160]} sizes="64px" />
          </div>
          <span class="arrow-link">{T.seeParts}</span>
        </a>
        <a class="mini m3" href={P.vsTripode} data-reveal style="--d:.2s">
          <span class="eyebrow">{T.cmpEyebrow}</span>
          <h3>{T.cmpTitle}</h3>
          <span class="big">1 kg → 20 g</span>
          <span class="arrow-link">{T.compare}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PESO -->
  <section class="section section--paper">
    <div class="container split">
      <div data-reveal>
        <span class="eyebrow">{T.wEyebrow}</span>
        <h2>{T.wTitle}</h2>
        <p class="lead">{T.wLead}</p>
        <div class="btn-row">
          <a class="btn btn--dark" href={P.vsTripode}>{T.fullCmp}</a>
        </div>
      </div>
      <WeightBars />
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="how section section--dark grain">
    <Image src={imgSuelo} alt={T.howAlt} widths={[960, 1920]} sizes="100vw" class="how-bg" />
    <div class="how-shade" aria-hidden="true"></div>
    <div class="container rel how-grid">
      <div>
        <div class="section-head" data-reveal>
          <span class="eyebrow">{T.howEyebrow}</span>
          <h2>{T.howTitle}</h2>
          <p>{T.howText}</p>
        </div>
        <Steps steps={T.steps} dark />
      </div>
      <figure class="reel" data-reveal>
        <div class="reel-v" data-inview-wrap>
        <video data-inview muted loop preload="none" playsinline data-poster="/videos/reel-kreox-piko-universal-poster.jpg" width="720" height="1280" aria-label={T.reelAria}>
          <source src="/videos/reel-kreox-piko-universal.mp4" type="video/mp4" />
          {T.noVideo} <a href="/videos/reel-kreox-piko-universal.mp4">{T.download}</a>.
        </video>
        <button type="button" class="av-toggle" data-av-toggle aria-label={T.pause} aria-pressed="false"><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor"/></svg><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor"/></svg></button>
        <button type="button" class="unmute" data-unmute><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9H3zm13.5 3a4.5 4.5 0 00-2.5-4v8a4.5 4.5 0 002.5-4zM14 3.2v2.1a7 7 0 010 13.4v2.1a9 9 0 000-17.6z" fill="currentColor"/></svg><span>{T.sound}</span></button>
        </div>
        <figcaption>{T.reelCap}</figcaption>
      </figure>
    </div>
  </section>

  <!-- EN OBRA (vídeos) -->
  <section class="section section--dark film">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{T.filmEyebrow}</span>
          <h2>{T.filmTitle} <span class="sand">{T.filmAccent}</span></h2>
        </div>
        <p class="muted side" data-reveal>{T.filmSide}</p>
      </div>
      <div class="film-grid">
        <a class="clip" href={P.piko} data-reveal>
          <AutoVideo src="/videos/piko-vertido-suelo-radiante.mp4" poster={imgSuelo} label={T.clipPiko} />
          <span class="clip-cap"><span class="chip chip--sand">PIKO</span> {T.clipPikoCap} <span class="arrow-link">{T.see}</span></span>
        </a>
        <a class="clip" href={P.universal} data-reveal style="--d:.1s">
          <AutoVideo src="/videos/universal-vertido-recrecido.mp4" poster={imgUniVertido} label={T.clipUni} />
          <span class="clip-cap"><span class="chip chip--sand">Universal</span> {T.clipUniCap} <span class="arrow-link">{T.see}</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- PARA PROFESIONALES -->
  <section class="section pros-sec" aria-labelledby="pros-h">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{T.proEyebrow}</span>
        <h2 id="pros-h">{T.proTitle}</h2>
      </div>
      <ul class="pros">
        {T.pros.map((p, i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}>
            <a href={p.k === 'whatsapp' ? waConsulta('nivelacion', lang) : P[p.k as 'piko' | 'nivelacion' | 'universal']} {...(p.k === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="pro-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="pro-b"><h3 class="pro-t">{p.t}</h3><span>{p.d}</span><span class="arrow-link">{p.l}{p.k === 'whatsapp' && <span class="visually-hidden">{lang === 'en' ? ' (opens WhatsApp)' : ' (abre WhatsApp)'}</span>}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- AZULEJOS -->
  <section class="tiles section section--paper">
    <Image src={imgLineas} alt="" widths={[960]} sizes="60vw" class="lineart" />
    <div class="container rel">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{T.tilesEyebrow}</span>
          <h2>{T.tilesTitle}</h2>
        </div>
        <a class="btn btn--ghost side" href={P.azulejos} data-reveal>{T.tilesAll}</a>
      </div>
      <div class="grid grid-4">
        {tiles.map((p, i) => (
          <a class="tile" href={p.href} data-reveal style={`--d:${i * 0.08}s`}>
            <div class="tile-img"><Image src={p.img} alt={p.alt} widths={[300, 600]} sizes="(min-width: 960px) 280px, 45vw" /></div>
            <h3>{p.name}</h3>
