---
// Preguntas frecuentes compartidas por /preguntas-frecuentes/ y /en/faq/: mismo buscador y diseño, datos según el idioma.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaContacto from '../components/CtaContacto.astro';
import imgHeroBg from '../assets/img/hf-niveladores-estudio-mortero.jpg';
import { FAQ_NIVELACION, FAQ_PIKO, FAQ_UNIVERSAL, FAQ_CALCULADORA, FAQ_TRIPODE } from '../data/faqs';
import { FAQ_NIVELACION_EN, FAQ_PIKO_EN, FAQ_UNIVERSAL_EN, FAQ_CALCULADORA_EN, FAQ_TRIPODE_EN } from '../data/en/faqs';
import { TILE_FAQ } from '../data/azulejos';
import { TILE_FAQ_EN } from '../data/en/tiles';
import { faqSchema } from '../data/schema';
import { useT } from '../i18n/ui';

const { lang, P } = useT(Astro.url);
const EN = lang === 'en';
const url = P.faq;
const grupos = EN
  ? [
      { id: 'levelling', title: 'Levelling with liquid screed', link: { href: P.nivelacion, label: 'Levelling systems' }, faqs: FAQ_NIVELACION_EN },
      { id: 'piko', title: 'Insulation Screed Leveller · underfloor heating', link: { href: P.piko, label: 'Product page' }, faqs: FAQ_PIKO_EN },
      { id: 'universal', title: 'Universal Screed Leveller · screeds', link: { href: P.universal, label: 'Product page' }, faqs: FAQ_UNIVERSAL_EN },
      { id: 'quantities', title: 'Quantities and calculation', link: { href: P.calculadora, label: 'Leveller calculator' }, faqs: FAQ_CALCULADORA_EN },
      { id: 'tripod', title: 'Levelling tripods and the alternative', link: { href: P.vsTripode, label: 'Levelling tripods compared' }, faqs: FAQ_TRIPODE_EN },
      { id: 'tiles', title: 'Tile installation', link: { href: P.azulejos, label: 'Tile levelling system' }, faqs: TILE_FAQ_EN },
    ]
  : [
      { id: 'nivelacion', title: 'Nivelación con mortero autonivelante', link: { href: P.nivelacion, label: 'Sistemas de nivelación' }, faqs: FAQ_NIVELACION },
      { id: 'piko', title: 'PIKO · suelo radiante', link: { href: P.piko, label: 'Ficha del PIKO' }, faqs: FAQ_PIKO },
      { id: 'universal', title: 'Nivelador Universal · recrecidos', link: { href: P.universal, label: 'Ficha del Nivelador Universal' }, faqs: FAQ_UNIVERSAL },
      { id: 'cantidades', title: 'Cantidades y cálculo', link: { href: P.calculadora, label: 'Calculadora de niveladores' }, faqs: FAQ_CALCULADORA },
      { id: 'tripode', title: 'Trípodes de nivelación (arañas) y su alternativa', link: { href: P.vsTripode, label: 'Comparativa con los trípodes' }, faqs: FAQ_TRIPODE },
      { id: 'azulejos', title: 'Colocación de azulejos', link: { href: P.azulejos, label: 'Sistema para azulejos' }, faqs: TILE_FAQ },
    ];
// Schema: cada pregunta una sola vez
const seen = new Set<string>();
const all = grupos.flatMap((g) => g.faqs).filter((f) => (seen.has(f.q) ? false : (seen.add(f.q), true)));
const T = EN
  ? {
      title: 'FAQ about screed levellers | KREOX',
      description: 'Clear answers about the Insulation and Universal Screed Levellers, how many per m², metal tripods, spare parts and the KREOX tile system.',
      crumb: 'FAQ', eyebrow: 'Help', heroTitle: 'Frequently asked', heroAccent: 'questions',
      lead: `${all.length} clear answers about our screed levellers and the tile levelling system.`,
      search: 'Search for a question', searchPh: 'E.g. underfloor heating, laser, m²…', topics: 'Topics',
      empty1: 'We could not find that question.', empty2: 'Write to us', empty3: 'and we will answer it.',
      result: 'result', results: 'results',
      ctaTitle: 'Can’t find your answer?', ctaText: 'Message us on WhatsApp: our sales team will advise you with no obligation.',
    }
  : {
      title: 'Preguntas frecuentes sobre niveladores | KREOX',
      description: 'Respuestas claras sobre PIKO, Nivelador Universal, cuántos niveladores por m², trípodes de acero, recambios y colocación de azulejos KREOX.',
      crumb: 'Preguntas frecuentes', eyebrow: 'Ayuda', heroTitle: 'Preguntas', heroAccent: 'frecuentes',
      lead: `${all.length} respuestas claras sobre nuestros niveladores para mortero autonivelante y el sistema de colocación de azulejos.`,
      search: 'Buscar una pregunta', searchPh: 'Ej.: suelo radiante, láser, m²…', topics: 'Temas',
      empty1: 'No hemos encontrado esa pregunta.', empty2: 'Escríbenos', empty3: 'y te respondemos.',
      result: 'resultado', results: 'resultados',
      ctaTitle: '¿No encuentras tu respuesta?', ctaText: 'Escríbenos por WhatsApp: nuestro departamento comercial te asesora sin compromiso.',
    };
---
<Base
  overlay
  title={T.title}
  description={T.description}
  breadcrumbs={[{ name: T.crumb, url }]}
  schema={[faqSchema(all)]}
>
  <PageHero
    compact
    eyebrow={T.eyebrow}
    title={T.heroTitle}
    accent={T.heroAccent}
    lead={T.lead}
    bg={imgHeroBg}
    crumbs={[{ name: T.crumb, url }]}
  />

  <section class="section">
    <div class="container layout">
      <aside class="side">
        <label class="search">
          <span>{T.search}</span>
          <input type="search" placeholder={T.searchPh} data-faq-search autocomplete="off" />
        </label>
        <p class="muted" aria-live="polite" data-faq-count data-l-one={T.result} data-l-many={T.results}></p>
        <nav aria-label={T.topics}>
          <ul>
            {grupos.map((g) => <li><a href={`#${g.id}`}>{g.title} <span>{g.faqs.length}</span></a></li>)}
          </ul>
        </nav>
      </aside>

      <div class="groups">
        {grupos.map((g) => (
          <section class="group" id={g.id} aria-labelledby={`h-${g.id}`} data-faq-group>
            <div class="ghead">
              <h2 id={`h-${g.id}`}>{g.title}</h2>
              <a class="arrow-link" href={g.link.href}>{g.link.label}</a>
            </div>
            {g.faqs.map((f) => (
              <details data-faq>
                <summary><h3>{f.q}</h3><span class="ic" aria-hidden="true"></span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        ))}
        <p class="empty" hidden data-faq-empty>{T.empty1} <a class="link" href={P.contacto}>{T.empty2}</a> {T.empty3}</p>
      </div>
    </div>
  </section>

  <CtaContacto title={T.ctaTitle} text={T.ctaText} />
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]')!;
  const count = document.querySelector<HTMLElement>('[data-faq-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-faq-empty]')!;
  const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq]')];
  const run = () => {
    const q = norm(input.value.trim());
    let n = 0;
    items.forEach((d) => {
      const hit = !q || norm(d.textContent || '').includes(q);
      d.hidden = !hit; if (hit) n++;
      if (q && hit) d.open = true;
    });
    document.querySelectorAll<HTMLElement>('[data-faq-group]').forEach((g) => { g.hidden = !g.querySelector('[data-faq]:not([hidden])'); });
    empty.hidden = n > 0;
    count.textContent = q ? `${n} ${n === 1 ? count.dataset.lOne : count.dataset.lMany}` : '';
  };
  input.addEventListener('input', run);
</script>

<style>
  .layout { display: grid; gap: 40px; }
  @media (min-width: 960px) { .layout { grid-template-columns: 300px 1fr; gap: 64px; align-items: start; } .side { position: sticky; top: calc(var(--header-h) + 24px); } }
  .search span { display: block; font-weight: 600; font-size: var(--fs-label); letter-spacing: var(--tr-label); text-transform: uppercase; color: var(--text-soft); margin-bottom: 8px; }
  .search input { width: 100%; font: inherit; font-size: 1.05rem; padding: 14px 16px; border: 1px solid #b9b3a9; border-radius: var(--radius-sm); background: var(--white); }
  .search input:focus { outline: 2px solid var(--sand-strong); outline-offset: 2px; }
  .side nav ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 2px; }
  .side nav a { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 10px; text-decoration: none; color: var(--ink); }
  .side nav a:hover { background: var(--paper); }
  .side nav a span { color: var(--text-soft); font-size: .85rem; }
  .group { margin-bottom: 56px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .ghead { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; margin-bottom: 8px; }
  .ghead h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: 0; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 20px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.05rem; font-weight: 500; }
  summary:hover h3 { color: var(--sand-strong); }
  .ic { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line); position: relative; }
  .ic::before, .ic::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: var(--ink); translate: -50% -50%; }
  .ic::after { rotate: 90deg; transition: rotate .3s var(--ease); }
  details[open] .ic { background: var(--sand); border-color: var(--sand); }
  details[open] .ic::after { rotate: 0deg; }
  details p { margin: 0 0 22px; color: var(--text); max-width: 680px; }
  .empty { font-size: 1.05rem; }
</style>
