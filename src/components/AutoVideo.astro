---
// Vídeo decorativo en bucle: sin sonido, se reproduce solo cuando está en pantalla y
// no arranca si el usuario tiene activado "reducir movimiento" (se queda el póster).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; poster: ImageMetadata; label: string; class?: string; eager?: boolean }
const { src, poster, label, class: cls, eager = false } = Astro.props;
const p = await getImage({ src: poster, width: 1920, format: 'webp', quality: 72 });
---
<video
  class:list={['av', cls]}
  data-autovideo
  muted
  loop
  playsinline
  preload={eager ? 'auto' : 'none'}
  poster={p.src}
  aria-label={label}
  width={poster.width}
  height={poster.height}
>
  <source src={src} type="video/mp4" />
</video>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('video[data-autovideo]').forEach((v) => {
    if (reduce) return;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { v.play().catch(() => {}); } else { v.pause(); }
    }, { threshold: 0.15 });
    io.observe(v);
  });
</script>
<style>
  .av { display: block; width: 100%; height: 100%; object-fit: cover; background: #000; }
</style>
