---
// Vídeo decorativo en bucle: sin sonido, se reproduce solo cuando está en pantalla,
// no arranca con "reducir movimiento" y tiene botón de pausa (WCAG 2.2.2).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; poster: ImageMetadata; label: string; class?: string; eager?: boolean }
const { src, poster, label, class: cls } = Astro.props;
const p = await getImage({ src: poster, width: 1920, format: 'webp', quality: 72 });
---
<div class="avw" data-autovideo-wrap>
  <video
    class:list={['av', cls]}
    data-autovideo
    muted
    loop
    playsinline
    preload="none"
    data-poster={p.src}
    aria-label={label}
    width={poster.width}
    height={poster.height}
  >
    <source src={src} type="video/mp4" />
  </video>
  <button type="button" class="av-toggle" data-av-toggle aria-label="Pausar vídeo" aria-pressed="false">
    <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor"/></svg>
    <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor"/></svg>
  </button>
</div>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  document.querySelectorAll<HTMLElement>('[data-autovideo-wrap]').forEach((w) => {
    const v = w.querySelector<HTMLVideoElement>('video')!;
    const btn = w.querySelector<HTMLButtonElement>('[data-av-toggle]')!;
    let userPaused = Boolean(reduce || saveData);
    const sync = () => {
      const paused = v.paused;
      btn.setAttribute('aria-label', paused ? 'Reproducir vídeo' : 'Pausar vídeo');
      btn.setAttribute('aria-pressed', String(paused));
      btn.classList.toggle('is-paused', paused);
    };
    v.addEventListener('play', sync); v.addEventListener('pause', sync); sync();
    btn.addEventListener('click', () => {
      if (v.paused) { userPaused = false; v.play().catch(() => {}); } else { userPaused = true; v.pause(); }
    });
    v.addEventListener('click', () => btn.click());
    // El póster se carga solo cuando el vídeo se acerca a la pantalla (no compite con la carga inicial).
    const near = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (v.dataset.poster) v.poster = v.dataset.poster; near.disconnect(); }
    }, { rootMargin: '600px 0px' });
    near.observe(v);
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused) v.play().catch(() => {}); else if (!e.isIntersecting) v.pause();
    }, { threshold: 0.15 });
    io.observe(v);
  });
</script>
<style>
  .avw { display: contents; }
  .av { display: block; width: 100%; height: 100%; object-fit: cover; background: #000; }
</style>
