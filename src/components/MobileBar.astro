---
import WaIcon from './WaIcon.astro';
import { SITE, waTarifa } from '../data/site';
---
<nav class="mbar" aria-label="Accesos rápidos">
  <a href={SITE.whatsapp} class="wa" target="_blank" rel="noopener" aria-label="WhatsApp (se abre en una nueva ventana)">
    <WaIcon size={18} />
    WhatsApp
  </a>
  <a href={waTarifa()} class="quote" target="_blank" rel="noopener">Nueva tarifa 2027<span class="visually-hidden"> (abre WhatsApp)</span></a>
</nav>
<style>
  .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1.25fr; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgba(18,18,17,.94); backdrop-filter: blur(10px); border-top: 1px solid var(--line-dark); }
  .mbar a { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 48px; border-radius: 999px; font-weight: 600; font-size: .9rem; text-decoration: none; white-space: nowrap; }
  .mbar svg { width: 18px; height: 18px; flex: none; }
  .wa { background: #075e54; color: #fff; }
  .quote { background: var(--sand); color: var(--ink); }
  @media (min-width: 960px) { .mbar { display: none; } }
  @media (max-width: 959px) { :global(body) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); } }
  @media (max-width: 359px) { .mbar a { font-size: .8rem; gap: 4px; } }
</style>
