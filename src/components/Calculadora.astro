---
import { PRODUCTOS, M2_POR_NIVELADOR } from '../data/site';
interface Props { compact?: boolean; defaultProduct?: 'piko' | 'universal' }
const { compact = false, defaultProduct = 'piko' } = Astro.props;
const data = {
  piko: { caja: PRODUCTOS.piko.caja, peso: PRODUCTOS.piko.pesoG, nombre: 'PIKO' },
  universal: { caja: PRODUCTOS.universal.caja, peso: PRODUCTOS.universal.pesoG, nombre: 'Nivelador Universal' },
  tripode: PRODUCTOS.tripode.pesoG,
  m2: M2_POR_NIVELADOR,
};
---
<form class:list={['calc', { compact }]} data-calc={JSON.stringify(data)} onsubmit="return false" aria-label="Calculadora de niveladores">
  <div class="fields">
    <label>
      <span>Superficie a nivelar (m²)</span>
      <input type="number" name="m2" min="1" step="1" value="100" inputmode="numeric" required />
    </label>
    <fieldset>
      <legend>Tipo de obra</legend>
      <label class="radio"><input type="radio" name="prod" value="piko" checked={defaultProduct === 'piko'} /> Suelo radiante (PIKO)</label>
      <label class="radio"><input type="radio" name="prod" value="universal" checked={defaultProduct === 'universal'} /> Recrecido (Universal)</label>
    </fieldset>
    {!compact && (
      <label>
        <span>m² por nivelador</span>
        <input type="number" name="dens" min="0.5" max="6" step="0.5" value={M2_POR_NIVELADOR} />
      </label>
    )}
  </div>
  <output class="result" aria-live="polite">
    <div><strong data-o="uds">50</strong><span>niveladores</span></div>
    <div><strong data-o="cajas">1</strong><span data-o="cajaTxt">caja de 100</span></div>
    <div><strong data-o="peso">1 kg</strong><span>de peso en obra</span></div>
    <div class="vs"><strong data-o="tri">50 kg</strong><span>con trípodes de acero</span></div>
  </output>
  <p class="muted note">Cálculo orientativo con un nivelador cada <span data-o="densTxt">{M2_POR_NIVELADOR}</span> m². Confirma las cantidades para tu obra con nuestro departamento comercial.</p>
</form>

<script>
  const fmt = (n: number, d = 1) => n.toLocaleString('es-ES', { maximumFractionDigits: d });
  document.querySelectorAll<HTMLFormElement>('form[data-calc]').forEach((form) => {
    const cfg = JSON.parse(form.dataset.calc || '{}');
    const out = (k: string) => form.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const run = () => {
      const m2 = Math.max(0, Number((form.elements.namedItem('m2') as HTMLInputElement).value) || 0);
      const densEl = form.elements.namedItem('dens') as HTMLInputElement | null;
      const dens = Math.max(0.5, Number(densEl?.value) || cfg.m2);
      const prod = (form.querySelector('input[name="prod"]:checked') as HTMLInputElement)?.value || 'piko';
      const p = cfg[prod];
      const uds = Math.ceil(m2 / dens);
      const cajas = Math.ceil(uds / p.caja);
      out('uds').textContent = fmt(uds, 0);
      out('cajas').textContent = fmt(cajas, 0);
      out('cajaTxt').textContent = `${cajas === 1 ? 'caja' : 'cajas'} de ${p.caja} uds`;
      out('peso').textContent = `${fmt((uds * p.peso) / 1000)} kg`;
      out('tri').textContent = `${fmt((uds * cfg.tripode) / 1000)} kg`;
      out('densTxt').textContent = fmt(dens);
    };
    form.addEventListener('input', run);
    run();
  });
</script>

<style>
  .calc { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 3vw, 32px); color: var(--ink-2); box-shadow: var(--shadow); }
  .fields { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); align-items: end; }
  label > span, legend { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 6px; color: var(--ink); }
  input[type='number'] { width: 100%; font: inherit; font-size: 1.15rem; padding: 12px 14px; border: 1px solid #cfc8bd; border-radius: var(--radius-sm); }
  fieldset { border: 0; padding: 0; margin: 0; }
  .radio { display: flex; gap: 8px; align-items: center; font-size: 0.95rem; padding: 3px 0; cursor: pointer; }
  .radio input { accent-color: var(--ink); width: 18px; height: 18px; }
  .result { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); margin-top: 22px; }
  .result div { background: var(--sand-soft); border-radius: var(--radius-sm); padding: 14px 16px; }
  .result strong { display: block; font-size: 1.6rem; color: var(--ink); line-height: 1.1; }
  .result span { font-size: 0.85rem; color: var(--ink-3); }
  .result .vs { background: #fbeeee; }
  .result .vs strong { color: #9b2c1f; }
  .note { margin: 14px 0 0; }
</style>
