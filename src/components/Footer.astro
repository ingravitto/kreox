---
import { Image } from 'astro:assets';
import logo from '../assets/img/kreox-logo-blanco.png';
import Partners from './Partners.astro';
import { SITE, waInfo } from '../data/site';
import { useT } from '../i18n/ui';
const { lang, t, P } = useT(Astro.url);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Image src={logo} alt="KREOX" width={120} densities={[1, 2]} class="flogo" />
        <p class="claim">Innovation for construction</p>
        <p>{t('footerAbout')}</p>
        <div class="made">
          <svg class="ene" viewBox="0 0 48 48" aria-hidden="true"><rect x="1.5" y="1.5" width="45" height="45" rx="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 15.5h18v3.2H15z" fill="currentColor"/><path d="M15.5 36V22.5h4.6v2.1c1.2-1.6 3-2.5 5.2-2.5 3.9 0 6.2 2.6 6.2 6.8V36h-4.7v-6.4c0-2.3-1.1-3.5-3-3.5-2.1 0-3.6 1.4-3.6 3.9v6z" fill="currentColor"/></svg>
          <span>{t('madeInSpain')}</span>
        </div>
      </div>
      <nav aria-label={t('footerLevelingAria')}>
        <h2>{t('footerLeveling')}</h2>
        <ul>
          <li><a href={P.piko}>{t('fPiko')}</a></li>
          <li><a href={P.universal}>{t('fUniversal')}</a></li>
          <li><a href={P.recambios}>{t('fParts')}</a></li>
          <li><a href={P.lamina}>{t('fSheet')}</a></li>
          <li><a href={P.calculadora}>{t('fCalc')}</a></li>
          <li><a href={P.vsTripode}>{t('fVs')}</a></li>
          <li><a href={P.faq}>{t('fFaq')}</a></li>
        </ul>
      </nav>
      <nav aria-label={t('footerTilesAria')}>
        <h2>{t('footerTiles')}</h2>
        <ul>
          <li><a href={P.kalzo}>{lang === 'en' ? 'Kalzo spacer clip' : 'Kalzo Separador'}</a></li>
          <li><a href={P.kunaNiveladora}>{lang === 'en' ? 'Kuña levelling wedge' : 'Kuña Niveladora'}</a></li>
          <li><a href={P.kunaAntimanchas}>{lang === 'en' ? 'Stain-resistant Kuña' : 'Kuña Antimanchas'}</a></li>
          <li><a href={P.alikates}>{lang === 'en' ? 'Alikates tile pliers' : 'Alikates'}</a></li>
          <li><a href={SITE.tileCalculator}>{t('fTileCalc')}</a></li>
        </ul>
      </nav>
      <div class="f-contact">
        <h2>{t('contact')}</h2>
        <address>
          {SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city} ({SITE.address.region})<br />
          <a href={SITE.phoneHref}>{SITE.phone}</a><br />
          WhatsApp: <a href={waInfo(lang)} target="_blank" rel="noopener">{SITE.whatsappDisplay}<span class="visually-hidden">{t('newWindow')}</span></a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          {t('export')}: <a href={`mailto:${SITE.emailExport}`}>{SITE.emailExport}</a>
        </address>
        <ul class="social">
          <li><a href={SITE.social.youtube} rel="me">YouTube</a></li>
          <li><a href={SITE.social.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={SITE.social.instagram} rel="me">Instagram</a></li>
          <li><a href={SITE.social.tiktok} rel="me">TikTok</a></li>
        </ul>
      </div>
    </div>
    <Partners />
  </div>
  <div class="giant" aria-hidden="true"><span class="wordmark">Kreox</span></div>
  <div class="container legal">
    <span>© {year} KREOX · {SITE.legalName}</span>
    <a href={P.avisoLegal}>{t('legalNotice')}</a>
    <a href={P.privacidad}>{t('privacy')}</a>
    <a href={P.cookies}>{t('cookies')}</a>
    {import.meta.env.PUBLIC_GA_ID && <button type="button" class="ck-open" data-ck-open>{t('cookieSettings')}</button>}
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--on-dark-soft); font-size: 0.92rem; padding-top: clamp(64px, 8vw, 110px); overflow: hidden; }
  .top { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  @media (min-width: 960px) { .top { grid-template-columns: 1.5fr 1fr 1fr 1.2fr; } }
  /* Móvil: las dos listas de enlaces lado a lado y enlaces con área táctil cómoda */
  @media (max-width: 959px) {
    .top { grid-template-columns: 1fr 1fr; gap: 36px 20px; }
    .brand, .f-contact { grid-column: 1 / -1; }
    ul:not(.social) { gap: 2px; }
    ul:not(.social) a { display: block; padding: 8px 0; }
  }
  .brand :global(.flogo) { width: 120px; height: auto; }
  .claim { margin: 14px 0 18px; font-size: var(--fs-label); letter-spacing: var(--tr-label); text-transform: uppercase; color: var(--sand); }
  .made { display: flex; align-items: centre; gap: 12px; color: var(--white); font-size: 0.88rem; margin-top: 22px; }
  .ene { width: 36px; height: 36px; flex: none; color: var(--sand); }
  h2 { color: var(--white); font-size: var(--fs-label); letter-spacing: var(--tr-label); text-transform: uppercase; font-weight: 600; margin-bottom: 18px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  a { color: var(--on-dark); text-decoration: none; transition: color .2s; }
  a:hover { color: var(--sand); }
  address { font-style: normal; line-height: 1.95; }
  .social { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .social a { display: inline-block; padding: 7px 14px; border: 1px solid var(--line-dark); border-radius: 999px; font-size: 0.78rem; }
  .social a:hover { border-color: var(--sand); }
  .giant { text-align: centre; margin-top: clamp(40px, 6vw, 80px); line-height: 0; }
  .giant .wordmark { display: inline-block; font-size: clamp(6rem, 26vw, 24rem); transform: translateY(12%); }
  .legal { display: flex; flex-wrap: wrap; gap: 20px; border-top: 1px solid var(--line-dark); padding-top: 22px; padding-bottom: 30px; font-size: 0.8rem; position: relative; background: var(--ink); }
  .legal span { margin-right: auto; }
  .ck-open { background: none; border: 0; padding: 0; font: inherit; color: inherit; text-decoration: underline; cursor: pointer; }
</style>
