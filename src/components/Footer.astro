---
import { Image } from 'astro:assets';
import logo from '../assets/img/kreox-logo-blanco.png';
import Partners from './Partners.astro';
import { SITE, NIVELACION, AZULEJOS } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Image src={logo} alt="KREOX" width={120} densities={[1, 2]} class="flogo" />
        <p class="claim">Innovation for construction</p>
        <p>Fabricantes de sistemas de nivelación para mortero autonivelante y para la colocación de azulejos. Empresa familiar de tercera generación en Ibi (Alicante).</p>
        <div class="made">
          <svg class="ene" viewBox="0 0 48 48" aria-hidden="true"><rect x="1.5" y="1.5" width="45" height="45" rx="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 15.5h18v3.2H15z" fill="currentColor"/><path d="M15.5 36V22.5h4.6v2.1c1.2-1.6 3-2.5 5.2-2.5 3.9 0 6.2 2.6 6.2 6.8V36h-4.7v-6.4c0-2.3-1.1-3.5-3-3.5-2.1 0-3.6 1.4-3.6 3.9v6z" fill="currentColor"/></svg>
          <span>Diseñado y fabricado en España</span>
        </div>
      </div>
      <nav aria-label="Nivelación autonivelante">
        <h2>Nivelación</h2>
        <ul>
          <li><a href={`${NIVELACION}piko/`}>PIKO · suelo radiante</a></li>
          <li><a href={`${NIVELACION}nivelador-universal/`}>Nivelador Universal</a></li>
          <li><a href={`${NIVELACION}recambios/`}>Recambios</a></li>
          <li><a href={`${NIVELACION}lamina-bajo-solera/`}>Lámina bajo solera</a></li>
          <li><a href={`${NIVELACION}calculadora/`}>Calculadora</a></li>
          <li><a href={`${NIVELACION}piko-vs-tripode/`}>PIKO vs trípode</a></li>
          <li><a href="/preguntas-frecuentes/">Preguntas frecuentes</a></li>
        </ul>
      </nav>
      <nav aria-label="Colocación de azulejos">
        <h2>Azulejos</h2>
        <ul>
          <li><a href={`${AZULEJOS}kalzo-separador/`}>Kalzo Separador</a></li>
          <li><a href={`${AZULEJOS}kuna-niveladora/`}>Kuña Niveladora</a></li>
          <li><a href={`${AZULEJOS}kuna-antimanchas/`}>Kuña Antimanchas</a></li>
          <li><a href={`${AZULEJOS}alikates/`}>Alikates</a></li>
          <li><a href={SITE.tileCalculator}>Calculadora de piezas</a></li>
        </ul>
      </nav>
      <div>
        <h2>Contacto</h2>
        <address>
          {SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city} ({SITE.address.region})<br />
          <a href={SITE.phoneHref}>{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          Exportación: <a href={`mailto:${SITE.emailExport}`}>{SITE.emailExport}</a>
        </address>
        <ul class="social">
          <li><a href={SITE.social.youtube} rel="me">YouTube</a></li>
          <li><a href={SITE.social.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={SITE.social.instagram} rel="me">Instagram</a></li>
          <li><a href={SITE.social.tiktok} rel="me">TikTok</a></li>
        </ul>
      </div>
    </div>
    <Partners />
  </div>
  <div class="giant" aria-hidden="true"><span class="wordmark">Kreox</span></div>
  <div class="container legal">
    <span>© {year} KREOX · {SITE.legalName}</span>
    <a href="/aviso-legal/">Aviso legal</a>
    <a href="/politica-privacidad/">Privacidad</a>
    <a href="/politica-cookies/">Cookies</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--on-dark-soft); font-size: 0.92rem; padding-top: clamp(64px, 8vw, 110px); overflow: hidden; }
  .top { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  @media (min-width: 960px) { .top { grid-template-columns: 1.5fr 1fr 1fr 1.2fr; } }
  .brand :global(.flogo) { width: 120px; height: auto; }
  .claim { margin: 14px 0 18px; font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--sand); }
  .made { display: flex; align-items: center; gap: 12px; color: var(--white); font-size: 0.88rem; margin-top: 22px; }
  .ene { width: 36px; height: 36px; flex: none; color: var(--sand); }
  h2 { color: var(--white); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 600; margin-bottom: 18px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  a { color: var(--on-dark); text-decoration: none; transition: color .2s; }
  a:hover { color: var(--sand); }
  address { font-style: normal; line-height: 1.95; }
  .social { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .social a { display: inline-block; padding: 7px 14px; border: 1px solid var(--line-dark); border-radius: 999px; font-size: 0.78rem; }
  .social a:hover { border-color: var(--sand); }
  .giant { text-align: center; margin-top: clamp(40px, 6vw, 80px); line-height: 0; }
  .giant .wordmark { display: inline-block; font-size: clamp(6rem, 26vw, 24rem); transform: translateY(12%); }
  .legal { display: flex; flex-wrap: wrap; gap: 20px; border-top: 1px solid var(--line-dark); padding-top: 22px; padding-bottom: 30px; font-size: 0.8rem; position: relative; background: var(--ink); }
  .legal span { margin-right: auto; }
</style>
