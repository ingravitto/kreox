---
// Comparativa trípode de acero vs. niveladores KREOX con los datos que publica KREOX.
import { PRODUCTOS, M2_POR_NIVELADOR } from '../data/site';
import { useT } from '../i18n/ui';
const { t, locale } = useT(Astro.url);
interface Props { only?: 'piko' | 'universal' }
const { only } = Astro.props;
const n100 = Math.ceil(100 / M2_POR_NIVELADOR);
const kg = (g: number) => ((g * n100) / 1000).toLocaleString(locale, { maximumFractionDigits: 1 });
const showPiko = only !== 'universal';
const showUni = only !== 'piko';
---
<div class="table-wrap">
  <table>
    <caption class="visually-hidden">{t('cmpCaption')}</caption>
    <thead>
      <tr>
        <th scope="col">{t('cmpFeature')}</th>
        <th scope="col">{t('cmpTripod')}</th>
        {showPiko && <th scope="col">{t('prodPiko')}</th>}
        {showUni && <th scope="col">{t('prodUni')}</th>}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">{t('cmpWeight')}</th>
        <td class="td-bad">≈ 1 kg</td>
        {showPiko && <td class="td-good">≈ {PRODUCTOS.piko.pesoG} g</td>}
        {showUni && <td class="td-good">≈ {PRODUCTOS.universal.pesoG} g</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpWeight100', { n: n100 })}</th>
        <td class="td-bad">≈ {kg(PRODUCTOS.tripode.pesoG)} kg</td>
        {showPiko && <td class="td-good">≈ {kg(PRODUCTOS.piko.pesoG)} kg</td>}
        {showUni && <td class="td-good">≈ {kg(PRODUCTOS.universal.pesoG)} kg</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpRust')}</th>
        <td class="td-bad">{t('cmpRustBad')}</td>
        {showPiko && <td class="td-good">{t('cmpRustGood')}</td>}
        {showUni && <td class="td-good">{t('cmpRustGood')}</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpClean')}</th>
        <td class="td-bad">{t('cmpCleanBad')}</td>
        {showPiko && <td class="td-good">{t('cmpCleanPiko')}</td>}
        {showUni && <td class="td-good">{t('cmpCleanUni')}</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpPlace')}</th>
        <td class="td-bad">{t('cmpPlaceBad')}</td>
        {showPiko && <td class="td-good">{t('cmpPlacePiko')}</td>}
        {showUni && <td class="td-good">{t('cmpPlaceUni')}</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpRef')}</th>
        <td class="td-bad">{t('cmpRefBad')}</td>
        {showPiko && <td class="td-good">{t('cmpRefGood')}</td>}
        {showUni && <td class="td-good">{t('cmpRefGood')}</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpTransport')}</th>
        <td class="td-bad">{t('cmpTransportBad')}</td>
        {showPiko && <td class="td-good">{t('cmpPerBox', { n: PRODUCTOS.piko.caja })}</td>}
        {showUni && <td class="td-good">{t('cmpPerBox', { n: PRODUCTOS.universal.caja })}</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpParts')}</th>
        <td class="td-bad">{t('cmpNo')}</td>
        {showPiko && <td class="td-good">{t('cmpPartsPiko')}</td>}
        {showUni && <td class="td-good">{t('cmpPartsUni')}</td>}
      </tr>
      <tr>
        <th scope="row">{t('cmpPrice')}</th>
        <td class="td-bad">{t('cmpPriceBad')}</td>
        {showPiko && <td class="td-good">{t('cmpPriceGood')}</td>}
        {showUni && <td class="td-good">{t('cmpPriceGood')}</td>}
      </tr>
    </tbody>
  </table>
</div>
<p class="muted">{t('cmpNote', { m2: M2_POR_NIVELADOR })}</p>
