---
import { Image } from 'astro:assets';
import { postCategory, postDate, postUrl, postIsEn, type Post } from '../data/noticias';
import fallback from '../assets/img/fondo-piedra-productos-kreox.jpg';
interface Props { n: Post }
const { n } = Astro.props;
const img = n.data.image ?? fallback;
---
<article class="nc" data-reveal>
  <div class="ph"><Image src={img} alt={n.data.image ? (n.data.imageAlt ?? '') : ''} widths={[400, 720]} sizes="(min-width: 960px) 380px, 92vw" /></div>
  <div class="meta"><span>{postCategory(n)}</span><time datetime={n.data.date.toISOString()}>{postDate(n)}</time></div>
  <h3><a href={postUrl(n)}>{n.data.title}</a></h3>
  <p>{n.data.description}</p>
  <span class="arrow-link" aria-hidden="true">{postIsEn(n) ? 'Read' : 'Leer'}</span>
</article>
<style>
  .nc { position: relative; display: flex; flex-direction: column; }
  .ph { border-radius: var(--radius); overflow: hidden; margin-bottom: 20px; background: var(--ink); }
  .ph :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .8s var(--ease), opacity .4s; }
  .nc:hover .ph :global(img) { transform: scale(1.05); }
  .meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: var(--fs-label); letter-spacing: var(--tr-label); text-transform: uppercase; color: var(--text-soft); margin-bottom: 12px; }
  .meta span { color: var(--sand-strong); font-weight: 600; }
  h3 { font-size: 1.15rem; line-height: 1.35; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .nc:hover h3 a { color: var(--sand-strong); }
  p { color: var(--text-soft); font-size: 0.93rem; margin-bottom: 16px; }
  .arrow-link { margin-top: auto; }
  /* Móvil: tarjeta compacta (miniatura + título) para que tres noticias no ocupen tres pantallas */
  @media (max-width: 639px) {
    .nc { display: grid; grid-template-columns: 104px 1fr; grid-template-areas: 'ph meta' 'ph title'; column-gap: 14px; align-items: start; }
    .ph { grid-area: ph; margin: 0; }
    .ph :global(img) { aspect-ratio: 1; }
    .meta { grid-area: meta; gap: 8px; margin: 2px 0 4px; }
    .meta time { display: none; }
    h3 { grid-area: title; font-size: 1rem; margin: 0; }
    p, .arrow-link { display: none; }
  }
</style>
