---
// Plantilla de ficha de nivelador (PIKO / Nivelador Universal), con el estilo de kreox.es:
// hero oscuro con foto de obra, plano técnico con cotas sobre gris claro, pasos, comparativa, recambios y FAQ.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Marquee from './Marquee.astro';
import ComoFunciona from './ComoFunciona.astro';
import AutoVideo from './AutoVideo.astro';
import CompareTripode from './CompareTripode.astro';
import WeightBars from './WeightBars.astro';
import Calculadora from './Calculadora.astro';
import Faq from './Faq.astro';
import CtaTarifa from './CtaTarifa.astro';
import { NIVELACION, SITE, waTarifa } from '../data/site';

interface Props {
  kind: 'piko' | 'universal';
  seo: { title: string; description: string; schema: Record<string, unknown>[]; image: string };
  hero: { eyebrow: string; title: string; accent: string; lead: string; bg: ImageMetadata; bgAlt: string; product: ImageMetadata; productAlt: string };
  kpis: { v: string; u?: string; l: string }[];
  plano: { img: ImageMetadata; alt: string };
  specs: [string, string][];
  steps: { title: string; text: string }[];
  stepsMedia?: { img: ImageMetadata; alt: string }[];
  video?: { src: string; poster: string; text: string; title?: string; eyebrow?: string; checks?: string[]; captions?: string; ratio?: string; duration?: number };
  film?: { src: string; poster: ImageMetadata; label: string; title: string; accent: string };
  gallery?: { img: ImageMetadata; alt: string; caption: string; good: boolean }[];
  parts: { img: ImageMetadata; alt: string; name: string; caja: string }[];
  other: { name: string; text: string; href: string; img: ImageMetadata; alt: string };
  faqs: { q: string; a: string }[];
  faqTitle: string;
  cta: { title: string; text: string };
  name: string;
}
const p = Astro.props;
const url = p.kind === 'piko' ? `${NIVELACION}piko/` : `${NIVELACION}nivelador-universal/`;
const filmThumb = p.film ? await getImage({ src: p.film.poster, width: 1280, format: 'jpeg' }) : undefined;
const howTo = {
  '@type': 'HowTo',
  name: `Cómo nivelar mortero autonivelante con ${p.name}`,
  description: `Proceso de nivelación de mortero autonivelante con ${p.name} de KREOX en ${p.steps.length} pasos.`,
  tool: [{ '@type': 'HowToTool', name: p.name }, { '@type': 'HowToTool', name: 'Láser nivelador (habitual o con receptor)' }],
  supply: [{ '@type': 'HowToSupply', name: 'Mortero autonivelante' }],
  step: p.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text, url: `${SITE.url}${url}#como-se-usa` })),
};
const schema = [
  ...p.seo.schema,
  howTo,
  ...(p.film && filmThumb
    ? [{
        '@type': 'VideoObject',
        name: `${p.name}: vertido de mortero autonivelante`,
        description: p.film.label,
        thumbnailUrl: new URL(filmThumb.src, SITE.url).href,
        contentUrl: new URL(p.film.src, SITE.url).href,
        uploadDate: '2026-11-12',
        publisher: { '@id': `${SITE.url}/#organization` },
      }]
    : []),
  ...(p.video
    ? [{
        '@type': 'VideoObject',
        name: p.video.title ? `${p.video.title} · ${p.name}` : `Instalación del ${p.name} en obra`,
        description: p.video.text,
        thumbnailUrl: new URL(p.video.poster, SITE.url).href,
        contentUrl: new URL(p.video.src, SITE.url).href,
        uploadDate: '2026-11-13',
        ...(p.video.duration ? { duration: `PT${p.video.duration}S` } : {}),
        publisher: { '@id': `${SITE.url}/#organization` },
      }]
    : []),
];
---
<Base title={p.seo.title} description={p.seo.description} ogType="product" image={p.seo.image} overlay breadcrumbs={[{ name: 'Nivelación autonivelante', url: NIVELACION }, { name: p.name, url }]} schema={schema}>
  <PageHero eyebrow={p.hero.eyebrow} title={p.hero.title} accent={p.hero.accent} lead={p.hero.lead} bg={p.hero.bg} bgAlt={p.hero.bgAlt} product={p.hero.product} productAlt={p.hero.productAlt} crumbs={[{ name: 'Nivelación', url: NIVELACION }, { name: p.name, url }]}>
    <div class="chips hero-chips"><span class="chip chip--sand">Producto patentado</span><span class="chip">Fabricado en España</span><span class="chip">Reutilizable</span></div>
    <div class="btn-row">
      <a class="btn btn--sand" href={waTarifa("nivelacion")} target="_blank" rel="noopener">Pedir tarifa 2027 <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span class="visually-hidden"> (abre WhatsApp)</span></a>
      <a class="btn btn--ghost" href="#calculadora">¿Cuántos necesito?</a>
    </div>
  </PageHero>

  <section class="kpis">
    <div class="container">
      <dl>
        {p.kpis.map((k, i) => <div data-reveal style={`--d:${i * 0.06}s`}><dt>{k.v}{k.u && <small>{k.u}</small>}</dt><dd>{k.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section section--paper" id="datos">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Ficha técnica · al milímetro</span>
        <h2>Datos técnicos del {p.name}</h2>
      </div>
      <div class="split split--top">
        <figure class="plano" data-reveal>
          <Image src={p.plano.img} alt={p.plano.alt} widths={[600, 1000, 1232]} sizes="(min-width: 960px) 600px, 92vw" />
          <figcaption>Medidas en milímetros según el plano del fabricante.</figcaption>
        </figure>
        <div data-reveal style="--d:.1s">
          <table class="specs">
            <tbody>{p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td set:html={v} /></tr>)}</tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="como-se-usa">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Cómo funciona</span>
        <h2>Así nivela {p.name}, <span class="sand">paso a paso.</span></h2>
        <p>Pulsa cada paso o baja con el scroll y verás el proceso en un corte de la obra.</p>
      </div>
      <ComoFunciona kind={p.kind} steps={p.steps} />
      {p.video && (
        <div class="install" data-reveal>
          <div class="install-copy on-dark">
            <span class="eyebrow">{p.video.eyebrow ?? 'Instalación real'}</span>
            <h3>{p.video.title ?? 'Así se coloca en obra'}</h3>
            <ul class="checks">
              {(p.video.checks ?? ['Marcado de la cota con láser con receptor.', 'También funciona con láser habitual.', 'Ajuste de la anilla hasta la línea marcada por el láser.']).map((c) => <li>{c}</li>)}
            </ul>
            <p class="muted">{p.video.text}</p>
          </div>
          <div class="install-video" data-inview-wrap>
            <div class="iv">
            <video data-inview controls muted loop preload="none" playsinline data-poster={p.video.poster} width="404" height="720" aria-label={`Vídeo de instalación del ${p.name}`}>
              <source src={p.video.src} type="video/mp4" />
              {p.video.captions && <track kind="captions" src={p.video.captions} srclang="es" label="Español" default />}
              Tu navegador no puede reproducir el vídeo. <a href={p.video.src}>Descárgalo aquí</a>.
            </video>
            <button type="button" class="unmute" data-unmute><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9H3zm13.5 3a4.5 4.5 0 00-2.5-4v8a4.5 4.5 0 002.5-4zM14 3.2v2.1a7 7 0 010 13.4v2.1a9 9 0 000-17.6z" fill="currentColor"/></svg>Activar sonido</button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  {p.film && (
    <section class="filmband">
      <AutoVideo src={p.film.src} poster={p.film.poster} label={p.film.label} />
      <div class="filmshade" aria-hidden="true"></div>
      <div class="container filmcopy on-dark" data-reveal>
        <span class="eyebrow">En obra</span>
        <h2>{p.film.title} <span class="sand">{p.film.accent}</span></h2>
      </div>
    </section>
  )}

  <Marquee dark items={['Sin óxido', 'Reutilizable', 'Láser habitual o con receptor', 'Anilla visual de nivel', 'Recambios por piezas', 'Producto patentado']} />

  <section class="section" id="comparativa">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <span class="eyebrow">Frente al trípode de acero</span>
          <h2>Lo mismo que un trípode, <span class="sand">sin sus problemas.</span></h2>
          <p class="lead">El trípode metálico pesa cerca de 1 kg, se oxida con el pH alcalino del mortero y obliga a asentar sus tres patas. {p.name} se coloca en segundos y se limpia con agua.</p>
        </div>
        <WeightBars />
      </div>
      {p.gallery && (
        <div class="gallery">
          {p.gallery.map((g, i) => (
            <figure data-reveal style={`--d:${i * 0.06}s`} class={g.good ? 'good' : 'bad'}>
              <Image src={g.img} alt={g.alt} widths={[316]} />
              <figcaption><span>{g.good ? '✓' : '✕'}</span>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
      <div class="cmp" data-reveal><CompareTripode only={p.kind} /></div>
    </div>
  </section>

  <section class="section section--dark grain">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Mejora continua · 2026</span>
          <h2>Anilla con fibra. <span class="sand">Recambios por piezas.</span></h2>
          <p>Más resistencia al uso continuo, nuevo color de alta visibilidad y, cuando una pieza se gasta, cambias solo esa pieza.</p>
        </div>
        <a class="btn btn--ghost" href={`${NIVELACION}recambios/`} data-reveal>Ver recambios</a>
      </div>
      <div class="grid grid-3">
        {p.parts.map((x, i) => (
          <a class="card part" href={`${NIVELACION}recambios/`} data-reveal style={`--d:${i * 0.08}s`}>
            <Image src={x.img} alt={x.alt} widths={[300, 600]} sizes="220px" />
            <h3>{x.name}</h3><p class="muted">{x.caja}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" id="calculadora">
    <div class="container split split--top">
      <div data-reveal>
        <span class="eyebrow">Calculadora</span>
        <h2>¿Cuántos necesitas para tu obra?</h2>
        <p class="lead">Introduce los metros cuadrados que vas a verter: te damos niveladores, cajas y el peso que te ahorras frente al trípode.</p>
        <a class="other" href={p.other.href}>
          <Image src={p.other.img} alt={p.other.alt} widths={[200, 400]} sizes="96px" />
          <span><strong>{p.other.name}</strong>{p.other.text}</span>
        </a>
      </div>
      <div data-reveal style="--d:.1s"><Calculadora compact defaultProduct={p.kind} /></div>
    </div>
  </section>

  <Faq faqs={p.faqs} title={p.faqTitle} />
  <CtaTarifa title={p.cta.title} text={p.cta.text} />
</Base>

<style>
  .hero-chips { margin-top: 26px; }
  .filmband { position: relative; min-height: min(80vh, 760px); display: flex; align-items: flex-end; overflow: hidden; background: #000; }
  .filmband :global(video) { position: absolute; inset: 0; }
  .filmshade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(18,18,17,.92) 0%, rgba(18,18,17,.2) 50%, rgba(18,18,17,0) 100%); }
  .filmcopy { position: relative; padding-block: clamp(48px, 7vw, 96px); }
  .filmcopy h2 { color: var(--white); max-width: 16ch; }
  .kpis { background: var(--ink); border-top: 1px solid var(--line-dark); }
  .kpis dl { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; }
  @media (min-width: 760px) { .kpis dl { grid-template-columns: repeat(4, 1fr); } }
  .kpis dl > div { padding: clamp(24px, 3vw, 40px) 20px; border-right: 1px solid var(--line-dark); }
  .kpis dl > div:last-child { border-right: 0; }
  .kpis dt { color: var(--white); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .kpis dt small { font-size: 0.45em; color: var(--sand); margin-left: 4px; letter-spacing: 0; }
  .kpis dd { margin: 10px 0 0; color: var(--on-dark-soft); font-size: 0.74rem; letter-spacing: .16em; text-transform: uppercase; }

  @media (min-width: 960px) { .plano { position: sticky; top: calc(var(--header-h) + 28px); } }
  .plano { margin: 0; background: #dcdcdc; border-radius: var(--radius-xl); padding: clamp(14px, 2vw, 24px); }
  .plano :global(img) { border-radius: var(--radius); width: 100%; }
  .plano figcaption { font-size: 0.82rem; color: #45443f; padding: 12px 6px 0; }
  .specs { background: transparent; }
  .specs th, .specs td { padding: 14px 0; border-color: #dcd7cf; }
  .specs th { width: 40%; padding-right: 16px; }
  .specs :global(a) { color: var(--sand-strong); }

  .install { display: grid; gap: 0; margin-top: clamp(40px, 6vw, 80px); background: var(--ink); border-radius: var(--radius-xl); overflow: hidden; }
  @media (min-width: 860px) { .install { grid-template-columns: 1.2fr 0.8fr; align-items: center; } }
  .install-copy { padding: clamp(28px, 4vw, 56px); }
  .install-copy h3 { color: var(--white); font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin-bottom: .8em; }
  .install-copy .checks { color: var(--on-dark); }
  .install-copy .muted { margin: 24px 0 0; }
  .install-video { padding: clamp(20px, 3vw, 36px); display: grid; place-items: center; background: radial-gradient(ellipse at center, #2a2a28, var(--ink) 70%); }
  .iv { position: relative; width: 100%; max-width: 300px; }
  .install-video video { width: 100%; max-width: 300px; aspect-ratio: 404 / 720; border-radius: 22px; background: #000; box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); }

  .gallery { display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); margin-top: clamp(40px, 5vw, 72px); }
  @media (min-width: 760px) { .gallery { grid-template-columns: repeat(4, 1fr); } }
  .gallery figure { margin: 0; }
  .gallery :global(img) { width: 100%; aspect-ratio: 316 / 190; object-fit: cover; border-radius: var(--radius); }
  .gallery figcaption { display: flex; gap: 10px; align-items: center; font-size: 0.85rem; margin-top: 10px; font-weight: 500; }
  .gallery figcaption span { display: inline-grid; place-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.7rem; flex: none; }
  .gallery .bad span { background: #f3dcd8; color: var(--bad); }
  .gallery .good span { background: var(--ink); color: var(--lime); }
  .cmp { margin-top: clamp(40px, 5vw, 72px); }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px; margin-bottom: clamp(36px, 5vw, 56px); }
  .head-row .section-head { margin-bottom: 0; }
  .part { text-align: center; }
  .part :global(img) { width: 160px; height: 150px; object-fit: contain; margin: 0 auto 18px; transition: transform .6s var(--ease); }
  .part:hover :global(img) { transform: scale(1.06) rotate(-3deg); }
  .part h3 { font-size: 1.05rem; margin-bottom: .2em; }
  .part p { margin: 0; }

  .other { display: flex; gap: 18px; align-items: center; margin-top: 32px; padding: 16px; border-radius: var(--radius); background: var(--white); text-decoration: none; transition: transform .3s var(--ease); }
  .other:hover { transform: translateX(6px); }
  .other :global(img) { width: 88px; height: 88px; object-fit: cover; border-radius: 12px; background: var(--ink); flex: none; }
  .other strong { display: block; color: var(--ink); }
  .other span { color: var(--text-soft); font-size: 0.9rem; }
</style>
