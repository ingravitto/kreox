---
// Plantilla de ficha de nivelador (PIKO / Nivelador Universal), con el estilo de kreox.es:
// hero oscuro con foto de obra, plano técnico con cotas sobre gris claro, pasos, comparativa, recambios y FAQ.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Marquee from './Marquee.astro';
import ComoFunciona from './ComoFunciona.astro';
import AutoVideo from './AutoVideo.astro';
import CompareTripode from './CompareTripode.astro';
import Calculadora from './Calculadora.astro';
import Faq from './Faq.astro';
import CtaContacto from './CtaContacto.astro';
import WaIcon from './WaIcon.astro';
import { SITE, waConsulta } from '../data/site';
import { useT } from '../i18n/ui';
import NoticiaCard from './NoticiaCard.astro';
import { getNoticias, getNews } from '../data/noticias';

interface Props {
  kind: 'piko' | 'universal';
  seo: { title: string; description: string; schema: Record<string, unknown>[]; image: string };
  hero: { eyebrow: string; title: string; accent: string; lead: string; bg: ImageMetadata; bgAlt: string; product: ImageMetadata; productAlt: string };
  kpis: { v: string; u?: string; l: string }[];
  plano: { img: ImageMetadata; alt: string };
  specs: [string, string][];
  steps: { title: string; text: string }[];
  stepsMedia?: { img: ImageMetadata; alt: string }[];
  video?: { src: string; poster: string; text: string; title?: string; eyebrow?: string; checks?: string[]; captions?: string; ratio?: string; duration?: number };
  film?: { src: string; poster: ImageMetadata; label: string; title: string; accent: string };
  gallery?: { img: ImageMetadata; alt: string; caption: string; good: boolean }[];
  parts: { img: ImageMetadata; alt: string; name: string; caja: string }[];
  other: { name: string; text: string; href: string; img: ImageMetadata; alt: string };
  faqs: { q: string; a: string }[];
  faqTitle: string;
  cta: { title: string; text: string };
  name: string;
}
const p = Astro.props;
const { lang, P } = useT(Astro.url);
const EN = lang === 'en';
const isPiko = p.kind === 'piko';
const nSteps = p.steps.length;
// Textos fijos de la plantilla en cada idioma
const L = EN
  ? {
      crumb: 'Liquid screed', crumbShort: 'Levelling', chips: ['Patented product', 'Made in Spain', 'Reusable'],
      ask: 'Ask us on WhatsApp', howMany: 'How many do I need?', opens: ' (opens WhatsApp)',
      onPage: 'On this page', secs: [['datos', 'Technical data'], ['como-se-usa', 'How to use'], ['comparativa', 'vs metal tripod'], ['calculadora', 'Calculator'], ['faq', 'FAQ']],
      dataEyebrow: 'Technical sheet · to the millimetre', dataTitle: `${p.name}: technical data`, plano: 'Dimensions in millimetres according to the manufacturer’s drawing.',
      howEyebrow: 'How it works', howTitle: isPiko ? 'From insulation board to datum height,' : 'From slab to datum height,', howAccent: `in ${nSteps} steps.`, howText: 'Tap each step or scroll down and you will see the process in a cross-section of the job.',
      installEyebrow: 'Real installation', installTitle: 'This is how it is placed on site',
      installChecks: ['Datum level marked with a laser with receiver.', 'Also works with a standard laser.', 'Ring adjusted to the line marked by the laser.'],
      videoAria: `${p.name} installation video`, noVideo: 'Your browser cannot play this video.', download: 'Download it here', pause: 'Pause video', sound: 'Turn sound on',
      onSite: 'On site',
      marquee: ['Rust-free', 'Reusable', 'Standard laser or laser with receiver', 'Visual level ring', 'Spare parts by piece', 'Patented product'],
      vsEyebrow: 'Versus the metal tripod', vsTitle: isPiko ? 'Why UFH installers' : 'On a slab,', vsAccent: isPiko ? 'are dropping the tripod.' : 'the tripod can stay in the van.',
      vsText: `The metal tripod weighs about 1 kg, rusts with the alkaline pH of the screed and all three legs must be firmly seated. The ${p.name} is placed in seconds and cleaned with water.`,
      impEyebrow: 'Spare parts', impTitle: 'If a part wears out,', impAccent: 'replace just that part.',
      impText: 'The ring is fibre-reinforced to stand up to daily use and comes in a high-visibility colour. Washers, bases and rings are sold separately.', seeParts: 'See spare parts',
      calcEyebrow: 'Calculator', calcTitle: isPiko ? 'Work out your boxes of insulation levellers' : 'Work out your boxes of universal levellers', calcText: 'Enter the square metres of the pour and you get the number of levellers and boxes.',
      guidesEyebrow: 'Guides and news', guidesTitle: 'Site guides',
      howToName: `How to level liquid screed with the ${p.name}`, howToDesc: `Levelling liquid screed with the KREOX ${p.name} in ${p.steps.length} steps.`,
      laserTool: 'Laser level (standard or with receiver)', screed: 'Liquid screed', filmName: `${p.name}: pouring liquid screed`, installName: `${p.name} installation on site`,
    }
  : {
      crumb: 'Nivelación autonivelante', crumbShort: 'Nivelación', chips: ['Producto patentado', 'Fabricado en España', 'Reutilizable'],
      ask: 'Consultar por WhatsApp', howMany: '¿Cuántos necesito?', opens: ' (abre WhatsApp)',
      onPage: 'En esta página', secs: [['datos', 'Datos técnicos'], ['como-se-usa', 'Cómo se usa'], ['comparativa', 'Frente al trípode'], ['calculadora', 'Calculadora'], ['preguntas-frecuentes', 'Preguntas']],
      dataEyebrow: 'Ficha técnica · al milímetro', dataTitle: `Datos técnicos del ${p.name}`, plano: 'Medidas en milímetros según el plano del fabricante.',
      howEyebrow: 'Cómo funciona', howTitle: isPiko ? 'Del aislamiento a la cota,' : 'De la solera a la cota,', howAccent: `en ${nSteps} pasos.`, howText: 'Pulsa cada paso o baja con el scroll y verás el proceso en un corte de la obra.',
      installEyebrow: 'Instalación real', installTitle: 'Así se coloca en obra',
      installChecks: ['Marcado de la cota con láser con receptor.', 'También funciona con láser habitual.', 'Ajuste de la anilla hasta la línea marcada por el láser.'],
      videoAria: `Vídeo de instalación del ${p.name}`, noVideo: 'Tu navegador no puede reproducir el vídeo.', download: 'Descárgalo aquí', pause: 'Pausar vídeo', sound: 'Activar sonido',
      onSite: 'En obra',
      marquee: ['Sin óxido', 'Reutilizable', 'Láser habitual o con receptor', 'Anilla visual de nivel', 'Recambios por piezas', 'Producto patentado'],
      vsEyebrow: 'Frente al trípode de acero', vsTitle: isPiko ? 'Por qué el instalador de suelo radiante' : 'En un recrecido,', vsAccent: isPiko ? 'ha dejado el trípode.' : 'el trípode se queda en la furgoneta.',
      vsText: `El trípode metálico pesa cerca de 1 kg, se oxida con el pH alcalino del mortero y obliga a asentar sus tres patas. ${p.name} se coloca en segundos y se limpia con agua.`,
      impEyebrow: 'Recambios', impTitle: 'Si una pieza se gasta,', impAccent: 'cambias solo esa.',
      impText: 'La anilla lleva fibra para aguantar el uso diario y un color de alta visibilidad. Arandelas, bases y anillas se venden sueltas.', seeParts: 'Ver recambios',
      calcEyebrow: 'Calculadora', calcTitle: isPiko ? 'Calcula tus cajas de PIKO' : 'Calcula tus cajas de Nivelador Universal', calcText: 'Pon los metros cuadrados del vertido y te sale el número de niveladores y de cajas.',
      guidesEyebrow: 'Guías y noticias', guidesTitle: 'Guías de obra',
      howToName: `Cómo nivelar mortero autonivelante con ${p.name}`, howToDesc: `Proceso de nivelación de mortero autonivelante con ${p.name} de KREOX en ${p.steps.length} pasos.`,
      laserTool: 'Láser nivelador (habitual o con receptor)', screed: 'Mortero autonivelante', filmName: `${p.name}: vertido de mortero autonivelante`, installName: `Instalación del ${p.name} en obra`,
    };
// Guías y noticias que mencionan este producto (enlazado interno hacia el contenido editorial)
const guias = (EN ? await getNews() : await getNoticias()).filter((n) => n.data.products.includes(p.kind)).slice(0, 3);
const url = p.kind === 'piko' ? P.piko : P.universal;
const filmThumb = p.film ? await getImage({ src: p.film.poster, width: 1280, format: 'jpeg' }) : undefined;
const howTo = {
  '@type': 'HowTo',
  name: L.howToName,
  description: L.howToDesc,
  inLanguage: lang,
  tool: [{ '@type': 'HowToTool', name: p.name }, { '@type': 'HowToTool', name: L.laserTool }],
  supply: [{ '@type': 'HowToSupply', name: L.screed }],
  step: p.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text, url: `${SITE.url}${url}#como-se-usa` })),
};
const schema = [
  ...p.seo.schema,
  howTo,
  ...(p.film && filmThumb
    ? [{
        '@type': 'VideoObject',
        name: L.filmName,
        description: p.film.label,
        thumbnailUrl: new URL(filmThumb.src, SITE.url).href,
        contentUrl: new URL(p.film.src, SITE.url).href,
        uploadDate: '2026-11-12',
        publisher: { '@id': `${SITE.url}/#organization` },
      }]
    : []),
  ...(p.video
    ? [{
        '@type': 'VideoObject',
        name: p.video.title ? `${p.video.title} · ${p.name}` : L.installName,
        description: p.video.text,
        thumbnailUrl: new URL(p.video.poster, SITE.url).href,
        contentUrl: new URL(p.video.src, SITE.url).href,
        uploadDate: '2026-11-13',
        ...(p.video.duration ? { duration: `PT${p.video.duration}S` } : {}),
        publisher: { '@id': `${SITE.url}/#organization` },
      }]
    : []),
];
---
<Base title={p.seo.title} description={p.seo.description} ogType="product" image={p.seo.image} overlay breadcrumbs={[{ name: L.crumb, url: P.nivelacion }, { name: p.name, url }]} schema={schema}>
  <PageHero eyebrow={p.hero.eyebrow} title={p.hero.title} accent={p.hero.accent} lead={p.hero.lead} bg={p.hero.bg} bgAlt={p.hero.bgAlt} product={p.hero.product} productAlt={p.hero.productAlt} crumbs={[{ name: L.crumbShort, url: P.nivelacion }, { name: p.name, url }]}>
    <div class="chips hero-chips"><span class="chip chip--sand">{L.chips[0]}</span><span class="chip">{L.chips[1]}</span><span class="chip">{L.chips[2]}</span></div>
    <div class="btn-row">
      <a class="btn btn--sand" href={waConsulta(p.kind, lang)} target="_blank" rel="noopener"><WaIcon size={16} /> {L.ask}<span class="visually-hidden">{L.opens}</span></a>
      <a class="btn btn--ghost" href="#calculadora">{L.howMany}</a>
    </div>
  </PageHero>

  <section class="kpis">
    <div class="container">
      <dl>
        {p.kpis.map((k, i) => <div data-reveal style={`--d:${i * 0.06}s`}><dt>{k.v}{k.u && <small>{k.u}</small>}</dt><dd>{k.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <nav class="secnav" aria-label={L.onPage} data-secnav>
    <div class="container"><ul>
      {L.secs.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ul></div>
  </nav>

  <section class="section section--paper" id="datos">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{L.dataEyebrow}</span>
        <h2>{L.dataTitle}</h2>
      </div>
      <div class="split split--top">
        <figure class="plano" data-reveal>
          <Image src={p.plano.img} alt={p.plano.alt} widths={[600, 1000, 1232]} sizes="(min-width: 960px) 600px, 92vw" />
          <figcaption>{L.plano}</figcaption>
        </figure>
        <div data-reveal style="--d:.1s">
          <table class="specs">
            <tbody>{p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td set:html={v} /></tr>)}</tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="como-se-usa">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{L.howEyebrow}</span>
        <h2>{L.howTitle} <span class="sand">{L.howAccent}</span></h2>
        <p>{L.howText}</p>
      </div>
      <ComoFunciona kind={p.kind} steps={p.steps} />
      {p.video && (
        <div class="install" data-reveal>
          <div class="install-copy on-dark">
            <span class="eyebrow">{p.video.eyebrow ?? L.installEyebrow}</span>
            <h3>{p.video.title ?? L.installTitle}</h3>
            <ul class="checks">
              {(p.video.checks ?? L.installChecks).map((c) => <li>{c}</li>)}
            </ul>
            <p class="muted">{p.video.text}</p>
          </div>
          <div class="install-video" data-inview-wrap>
            <div class="iv">
            <video data-inview muted loop preload="none" playsinline data-poster={p.video.poster} width="404" height="720" aria-label={L.videoAria}>
              <source src={p.video.src} type="video/mp4" />
              {p.video.captions && <track kind="captions" src={p.video.captions} srclang="es" label="Español" default />}
              {L.noVideo} <a href={p.video.src}>{L.download}</a>.
            </video>
            <button type="button" class="av-toggle" data-av-toggle aria-label={L.pause} aria-pressed="false"><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor"/></svg><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor"/></svg></button>
            <button type="button" class="unmute" data-unmute><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 9v6h4l5 4V5L7 9H3zm13.5 3a4.5 4.5 0 00-2.5-4v8a4.5 4.5 0 002.5-4zM14 3.2v2.1a7 7 0 010 13.4v2.1a9 9 0 000-17.6z" fill="currentColor"/></svg><span>{L.sound}</span></button>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  {p.film && (
    <section class="filmband">
      <AutoVideo src={p.film.src} poster={p.film.poster} label={p.film.label} />
      <div class="filmshade" aria-hidden="true"></div>
      <div class="container filmcopy on-dark" data-reveal>
        <span class="eyebrow">{L.onSite}</span>
        <h2>{p.film.title} <span class="sand">{p.film.accent}</span></h2>
      </div>
    </section>
  )}

  <Marquee dark items={L.marquee} />

  <section class="section" id="comparativa">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{L.vsEyebrow}</span>
        <h2>{L.vsTitle} <span class="sand">{L.vsAccent}</span></h2>
        <p class="lead">{L.vsText}</p>
      </div>
      {p.gallery && (
        <div class="gallery">
          {p.gallery.map((g, i) => (
            <figure data-reveal style={`--d:${i * 0.06}s`} class={g.good ? 'good' : 'bad'}>
              <Image src={g.img} alt={g.alt} widths={[316]} />
              <figcaption><span>{g.good ? '✓' : '✕'}</span>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
      <div class="cmp" data-reveal><CompareTripode only={p.kind} /></div>
    </div>
  </section>

  <section class="section section--dark grain">
    <div class="container">
      <div class="head-row">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{L.impEyebrow}</span>
          <h2>{L.impTitle} <span class="sand">{L.impAccent}</span></h2>
          <p>{L.impText}</p>
        </div>
        <a class="btn btn--ghost" href={P.recambios} data-reveal>{L.seeParts}</a>
      </div>
      <div class="grid grid-3">
        {p.parts.map((x, i) => (
          <a class="card part" href={P.recambios} data-reveal style={`--d:${i * 0.08}s`}>
            <Image src={x.img} alt={x.alt} widths={[300, 600]} sizes="220px" />
            <h3>{x.name}</h3><p class="muted">{x.caja}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper" id="calculadora">
    <div class="container split split--top">
      <div data-reveal>
        <span class="eyebrow">{L.calcEyebrow}</span>
        <h2>{L.calcTitle}</h2>
        <p class="lead">{L.calcText}</p>
        <a class="other" href={p.other.href}>
          <Image src={p.other.img} alt={p.other.alt} widths={[200, 400]} sizes="96px" />
          <span><strong>{p.other.name}</strong>{p.other.text}</span>
        </a>
      </div>
      <div data-reveal style="--d:.1s"><Calculadora compact defaultProduct={p.kind} /></div>
    </div>
  </section>

  <Faq faqs={p.faqs} title={p.faqTitle} />
  {guias.length > 0 && (
    <section class="section section--paper">
      <div class="container">
        <div class="section-head"><span class="eyebrow">{L.guidesEyebrow}</span><h2>{L.guidesTitle}</h2></div>
        <div class="grid grid-3">{guias.map((g) => <NoticiaCard n={g} />)}</div>
      </div>
    </section>
  )}
  <CtaContacto title={p.cta.title} text={p.cta.text} interes={p.kind} />
</Base>
<script>
  // Menú de secciones: marca la sección visible y mantiene su chip a la vista.
  const nav = document.querySelector<HTMLElement>('[data-secnav]');
  if (nav && 'IntersectionObserver' in window) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const map = new Map(links.map((a) => [a.hash.slice(1), a]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        const a = map.get(e.target.id);
        if (a) { a.setAttribute('aria-current', 'location'); a.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
      });
    }, { rootMargin: '-35% 0px -60% 0px' });
    map.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    // Por encima de la primera sección no hay ninguna marcada
    const first = document.getElementById(links[0]?.hash.slice(1) || '');
    addEventListener('scroll', () => {
      if (first && first.getBoundingClientRect().top > innerHeight * 0.4) {
        links.forEach((a) => a.removeAttribute('aria-current'));
        nav.querySelector('ul')?.scrollTo({ left: 0 });
      }
    }, { passive: true });
  }
</script>

<style>
  .hero-chips { margin-top: 26px; }
  .filmband { position: relative; min-height: min(80vh, 760px); display: flex; align-items: flex-end; overflow: hidden; background: #000; }
  .filmband :global(video) { position: absolute; inset: 0; }
  .filmshade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(18,18,17,.92) 0%, rgba(18,18,17,.2) 50%, rgba(18,18,17,0) 100%); }
  .filmcopy { position: relative; padding-block: clamp(48px, 7vw, 96px); }
  .filmcopy h2 { color: var(--white); max-width: 16ch; }
  .kpis { background: var(--ink); border-top: 1px solid var(--line-dark); }
  .kpis dl { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; }
  @media (min-width: 760px) { .kpis dl { grid-template-columns: repeat(4, 1fr); } }
  .kpis dl > div { padding: clamp(24px, 3vw, 40px) 20px; border-right: 1px solid var(--line-dark); }
  .kpis dl > div:last-child { border-right: 0; }
  .kpis dt { color: var(--white); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .kpis dt small { font-size: 0.45em; color: var(--sand); margin-left: 4px; letter-spacing: 0; }
  .kpis dd { margin: 10px 0 0; color: var(--on-dark-soft); font-size: var(--fs-label); letter-spacing: var(--tr-label); text-transform: uppercase; }

  @media (min-width: 960px) { .plano { position: sticky; top: calc(var(--header-h) + 28px); } }
  .plano { margin: 0; background: #dcdcdc; border-radius: var(--radius-xl); padding: clamp(14px, 2vw, 24px); }
  .plano :global(img) { border-radius: var(--radius); width: 100%; }
  .plano figcaption { font-size: 0.82rem; color: #45443f; padding: 12px 6px 0; }
  .specs { background: transparent; }
  .specs th, .specs td { padding: 14px 0; border-color: #dcd7cf; }
  .specs th { width: 40%; padding-right: 16px; }
  .specs :global(a) { color: var(--sand-strong); }

  .install { display: grid; gap: 0; margin-top: clamp(40px, 6vw, 80px); background: var(--ink); border-radius: var(--radius-xl); overflow: hidden; }
  @media (min-width: 860px) { .install { grid-template-columns: 1.2fr 0.8fr; align-items: center; } }
  .install-copy { padding: clamp(28px, 4vw, 56px); }
  .install-copy h3 { color: var(--white); font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin-bottom: .8em; }
  .install-copy .checks { color: var(--on-dark); }
  .install-copy .muted { margin: 24px 0 0; }
  .install-video { padding: clamp(20px, 3vw, 36px); display: grid; place-items: center; background: radial-gradient(ellipse at center, #2a2a28, var(--ink) 70%); }
  .iv { position: relative; width: 100%; max-width: 300px; }
  .install-video video { width: 100%; max-width: 300px; aspect-ratio: 404 / 720; border-radius: 22px; background: #000; box-shadow: 0 30px 60px -20px rgba(0,0,0,.7); }

  .gallery { display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); margin-top: clamp(40px, 5vw, 72px); }
  @media (min-width: 760px) { .gallery { grid-template-columns: repeat(4, 1fr); } }
  .gallery figure { margin: 0; }
  .gallery :global(img) { width: 100%; aspect-ratio: 316 / 190; object-fit: cover; border-radius: var(--radius); }
  .gallery figcaption { display: flex; gap: 10px; align-items: center; font-size: 0.85rem; margin-top: 10px; font-weight: 500; }
  .gallery figcaption span { display: inline-grid; place-content: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.7rem; flex: none; }
  .gallery .bad span { background: #f3dcd8; color: var(--bad); }
  .gallery .good span { background: var(--ink); color: var(--lime); }
  .cmp { margin-top: clamp(8px, 2vw, 24px); }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px; margin-bottom: clamp(36px, 5vw, 56px); }
  .head-row .section-head { margin-bottom: 0; }
  .part { text-align: center; }
  .part :global(img) { width: 160px; height: 150px; object-fit: contain; margin: 0 auto 18px; transition: transform .6s var(--ease); }
  .part:hover :global(img) { transform: scale(1.06) rotate(-3deg); }
  .part h3 { font-size: 1.05rem; margin-bottom: .2em; }
  .part p { margin: 0; }
