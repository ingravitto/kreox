---
// Preguntas frecuentes visibles. El mismo array se pasa a faqSchema() en la página,
// así lo que lee Google y las IA coincide siempre con lo que ve el usuario.
interface Props { faqs: { q: string; a: string }[]; title?: string; id?: string }
const { faqs, title = 'Preguntas frecuentes', id = 'preguntas-frecuentes' } = Astro.props;
---
<section class="section section--paper" id={id}>
  <div class="container split split--top">
    <div class="head">
      <span class="eyebrow">FAQ</span>
      <h2>{title}</h2>
      <p class="muted">¿No encuentras tu respuesta? Escríbenos y te contestamos.</p>
      <a class="arrow-link" href="/contacto/">Contactar</a>
    </div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary><h3>{f.q}</h3><span class="ic" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  @media (min-width: 960px) { .head { position: sticky; top: calc(var(--header-h) + 32px); } }
  .faq { display: grid; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 22px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.05rem; font-weight: 500; transition: color .2s; }
  summary:hover h3 { color: var(--sand-strong); }
  .ic { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line); position: relative; transition: transform .3s var(--ease), background .3s; }
  .ic::before, .ic::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: var(--ink); translate: -50% -50%; }
  .ic::after { rotate: 90deg; transition: rotate .3s var(--ease); }
  details[open] .ic { background: var(--sand); border-color: var(--sand); }
  details[open] .ic::after { rotate: 0deg; }
  details p { margin: 0 0 24px; color: var(--text-soft); max-width: 640px; }
</style>
