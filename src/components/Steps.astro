---
interface Props { steps: { title: string; text: string }[]; dark?: boolean }
const { steps, dark = false } = Astro.props;
---
<ol class:list={['steps', { dark }]}>
  {steps.map((s, i) => (
    <li data-reveal style={`--d:${i * 0.08}s`}>
      <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); border-top: 1px solid var(--line); }
  li { padding: 28px 26px 8px 0; position: relative; }
  li::before { content: ''; position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: var(--sand); }
  .n { display: block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.2em; color: var(--sand-strong); margin-bottom: 18px; }
  h3 { font-size: 1.2rem; margin-bottom: 0.5em; }
  p { margin: 0; color: var(--text-soft); font-size: 0.95rem; }
  .dark { border-color: var(--line-dark); }
  .dark .n { color: var(--sand); }
  .dark h3 { color: var(--white); }
  .dark p { color: var(--on-dark-soft); }
</style>
