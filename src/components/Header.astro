---
import { Image } from 'astro:assets';
import logo from '../assets/img/kreox-logo-blanco.png';
import { NAV, SITE, TARIFA, waTarifa } from '../data/site';
import WaIcon from './WaIcon.astro';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="container bar">
    <a href="/" class="logo" aria-label="KREOX, ir a la portada">
      <Image src={logo} alt="KREOX" width={112} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="desktop" aria-label="Principal">
      <ul class="menu">
        {NAV.map((item, idx) => (
          <li class={'children' in item ? 'has-sub' : ''} data-sub-li>
            <a href={item.href} class:list={[{ active: isActive(item.href), hl: 'highlight' in item }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
            {'children' in item && (
              <button type="button" class="sub-toggle" aria-expanded="false" aria-controls={`sub-${idx}`} aria-label={`Ver productos de ${item.label}`} data-sub-toggle>
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </button>
            )}
            {'children' in item && (
              <div class="sub" id={`sub-${idx}`}>
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>
                        <strong>{c.label}</strong>
                        {'note' in c && <span>{c.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={SITE.phoneHref} aria-label={`Llamar al ${SITE.phone}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1z" fill="currentColor"/></svg>
        <span>{SITE.phone}</span>
      </a>
      <a class="btn btn--sand cta" href={waTarifa()} target="_blank" rel="noopener">{TARIFA}<span class="visually-hidden"> (abre WhatsApp)</span></a>
    </div>

    <button type="button" class="m-open" aria-haspopup="dialog" aria-controls="m-menu" aria-expanded="false" data-m-open>
      <span class="m-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="m-open-label">Menú</span>
    </button>
  </div>
  <dialog id="m-menu" class="m-menu" aria-label="Menú principal" data-m-menu>
    <div class="m-head">
      <a href="/" class="logo" aria-label="KREOX, ir a la portada"><Image src={logo} alt="KREOX" width={112} densities={[1, 2]} loading="lazy" /></a>
      <button type="button" class="m-close" data-m-close>
        <span class="visually-hidden">Cerrar menú</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
      </button>
    </div>
    <nav class="m-nav" aria-label="Principal móvil">
      {NAV.map((item) => 'children' in item ? (
        <details class:list={['m-acc', { hl: 'highlight' in item }]} open={'highlight' in item || isActive(item.href) ? true : undefined}>
          <summary>
            <span>{item.label}</span>
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </summary>
          <ul>
            {item.children.map((c) => (
              <li>
                <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                  <strong>{c.label}</strong>
                  {'note' in c && <span>{c.note}</span>}
                </a>
              </li>
            ))}
            <li><a class="m-all" href={item.href} aria-current={path === item.href ? 'page' : undefined}>Ver todo en {item.label.toLowerCase()} →</a></li>
          </ul>
        </details>
      ) : (
        <a class="m-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="m-link" href="/contacto/" aria-current={isActive('/contacto/') ? 'page' : undefined}>Contacto</a>
    </nav>
    <div class="m-foot">
      <a class="m-wa" href={SITE.whatsapp} target="_blank" rel="noopener"><WaIcon size={18} />WhatsApp<span class="visually-hidden"> (se abre en una nueva ventana)</span></a>
      <a class="m-tarifa" href={waTarifa()} target="_blank" rel="noopener">Nueva {TARIFA.toLowerCase()}<span class="visually-hidden"> (abre WhatsApp)</span></a>
      <a class="m-phone" href={SITE.phoneHref}>{SITE.phone}</a>
    </div>
  </dialog>
</header>

<script>
  // Submenús accesibles: botón con aria-expanded, Escape cierra y devuelve el foco, clic fuera cierra.
  const lis = [...document.querySelectorAll<HTMLElement>('[data-sub-li]')];
  const closeAll = (except?: HTMLElement) => lis.forEach((li) => {
    if (li === except) return;
    li.classList.remove('open');
    li.querySelector('[data-sub-toggle]')?.setAttribute('aria-expanded', 'false');
  });
  lis.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-sub-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const open = !li.classList.contains('open');
      closeAll(li);
      li.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && li.classList.contains('open')) { li.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.focus(); }
    });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) { li.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); } });
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-sub-li]')) closeAll(); });
  // Menú móvil: <dialog> modal (foco atrapado, Escape cierra), bloquea el scroll de fondo.
  const dlg = document.querySelector<HTMLDialogElement>('[data-m-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-m-open]');
  if (dlg && openBtn) {
    const setOpen = (o: boolean) => { openBtn.setAttribute('aria-expanded', String(o)); document.documentElement.classList.toggle('m-lock', o); };
    openBtn.addEventListener('click', () => { dlg.showModal(); setOpen(true); });
    dlg.querySelector('[data-m-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => { setOpen(false); openBtn.focus(); });
    dlg.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href^="#"]')) dlg.close(); });
    window.matchMedia('(min-width: 1120px)').addEventListener('change', (m) => { if (m.matches && dlg.open) dlg.close(); });
    window.addEventListener('pageshow', () => { if (dlg.open) dlg.close(); });
  }
  const h = document.querySelector<HTMLElement>('[data-header]');
  if (h) {
    const on = () => h.classList.toggle('is-scrolled', window.scrollY > 24);
    requestAnimationFrame(on);
    window.addEventListener('scroll', on, { passive: true });
  }
</script>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; color: var(--white); background: rgba(18, 18, 17, 0.92); backdrop-filter: saturate(140%) blur(14px); -webkit-backdrop-filter: saturate(140%) blur(14px); border-bottom: 1px solid var(--line-dark); transition: background .35s var(--ease), border-color .35s var(--ease); }
  .site-header.overlay:not(.is-scrolled) { background: linear-gradient(180deg, rgba(0,0,0,.55), rgba(0,0,0,0)); border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .bar { display: flex; align-items: center; gap: 28px; height: var(--header-h); }
  .logo { flex: none; display: block; }
  .logo :global(img) { width: 112px; height: auto; }

  .desktop { display: none; margin-inline: auto; }
  .menu { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .menu > li { position: relative; display: flex; align-items: center; }
  .sub-toggle { display: inline-grid; place-content: center; width: 28px; height: 28px; margin-left: -8px; border: 0; border-radius: 50%; background: transparent; color: rgba(255,255,255,.75); cursor: pointer; }
  .sub-toggle:hover { background: rgba(255,255,255,.08); color: var(--white); }
  .sub-toggle svg { transition: transform .2s; }
  .open .sub-toggle svg { transform: rotate(180deg); }
  .menu > li > a { display: inline-flex; align-items: center; gap: 7px; color: rgba(255,255,255,.82); text-decoration: none; font-weight: 400; font-size: 0.9rem; padding: 10px 14px; border-radius: 999px; transition: color .2s, background .2s; }
  .menu > li > a:hover, .menu > li > a.active { color: var(--white); background: rgba(255,255,255,.07); }
  .menu > li > a.hl { color: var(--sand); }
  .sub { position: absolute; top: 100%; left: 50%; translate: -50% 0; padding-top: 12px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .25s var(--ease), transform .25s var(--ease), visibility .25s; }
  .has-sub:hover .sub, .has-sub.open .sub { opacity: 1; visibility: visible; transform: none; }
  .sub ul { list-style: none; margin: 0; padding: 10px; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: var(--radius); box-shadow: 0 30px 60px rgba(0,0,0,.45); min-width: 340px; }
  .sub a { display: block; padding: 12px 14px; border-radius: 12px; text-decoration: none; color: var(--white); transition: background .2s; }
  .sub a:hover { background: rgba(255,255,255,.06); }
  .sub strong { display: block; font-weight: 500; font-size: 0.92rem; }
  .sub span { display: block; font-size: 0.76rem; color: var(--sand); margin-top: 2px; }

  .actions { display: none; align-items: center; gap: 18px; }
  .phone { display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,.82); text-decoration: none; font-size: 0.86rem; white-space: nowrap; }
  .phone:hover { color: var(--sand); }
  .cta { padding: 0.95em 1.4em; }

  .m-open { margin-left: auto; display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 16px 0 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.28); background: rgba(18,18,17,.35); color: var(--white); font: 500 .9rem/1 var(--font); cursor: pointer; }
  .m-bars { display: grid; gap: 4px; }
  .m-bars i { display: block; width: 18px; height: 1.6px; background: currentColor; border-radius: 2px; }
  .m-bars i:nth-child(2) { width: 12px; }

  .m-menu { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: var(--ink); color: var(--white); overflow: hidden; }
  .m-menu[open] { display: flex; flex-direction: column; }
  .m-menu::backdrop { background: rgba(0,0,0,.6); }
  @media (prefers-reduced-motion: no-preference) { .m-menu[open] { animation: m-in .28s var(--ease); } }
  @keyframes m-in { from { opacity: 0; transform: translateY(-12px); } }
  .m-head { flex: none; display: flex; align-items: center; justify-content: space-between; height: var(--header-h); padding: 0 var(--gutter); border-bottom: 1px solid var(--line-dark); }
  .m-head .logo :global(img) { width: 112px; height: auto; }
  .m-close { width: 46px; height: 46px; display: grid; place-content: center; border-radius: 50%; border: 1px solid rgba(255,255,255,.28); background: transparent; color: var(--white); cursor: pointer; }
  .m-nav { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 8px var(--gutter) 24px; }
  .m-acc { border-bottom: 1px solid var(--line-dark); }
  .m-acc summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; cursor: pointer; font-weight: 600; font-size: 1.15rem; }
  .m-acc summary::-webkit-details-marker { display: none; }
  .m-acc.hl summary { color: var(--sand); }
  .m-acc summary svg { flex: none; transition: transform .2s; }
  .m-acc[open] summary svg { transform: rotate(180deg); }
  .m-acc ul { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 2px; }
  .m-acc li a { display: block; padding: 11px 14px; border-radius: 12px; text-decoration: none; color: var(--white); background: rgba(255,255,255,.04); }
  .m-acc li a strong { display: block; font-weight: 500; font-size: 1rem; }
  .m-acc li a span { display: block; font-size: .8rem; color: var(--on-dark-soft); margin-top: 2px; }
  .m-acc li a[aria-current='page'] { background: rgba(199,178,154,.16); box-shadow: inset 3px 0 0 var(--sand); }
  .m-acc .m-all { background: transparent; color: var(--sand); font-size: .92rem; }
  .m-link { display: flex; align-items: center; min-height: 60px; border-bottom: 1px solid var(--line-dark); color: var(--white); text-decoration: none; font-weight: 600; font-size: 1.15rem; }
  .m-link[aria-current='page'] { color: var(--sand); }
  .m-foot { flex: none; display: grid; grid-template-columns: 1fr 1.25fr; gap: 8px; padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line-dark); background: var(--ink-2); }
  .m-wa, .m-tarifa { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; border-radius: 999px; font-weight: 600; font-size: .92rem; text-decoration: none; white-space: nowrap; }
  .m-wa { background: #075e54; color: #fff; }
  .m-tarifa { background: var(--sand); color: var(--ink); }
  .m-phone { grid-column: 1 / -1; text-align: center; color: var(--on-dark-soft); font-size: .9rem; padding: 6px 0 0; }

  @media (min-width: 1120px) {
    .desktop, .actions { display: flex; }
    .m-open { display: none; }
  }
  @media (min-width: 1120px) and (max-width: 1260px) { .phone span { display: none; } }
</style>
