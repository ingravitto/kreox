---
import { Image } from 'astro:assets';
import logo from '../assets/img/kreox-logo-blanco.png';
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="KREOX, ir a la portada">
      <Image src={logo} alt="KREOX" width={150} loading="eager" />
    </a>

    <nav class="desktop" aria-label="Principal">
      <ul class="menu">
        {NAV.map((item) => (
          <li class={'children' in item ? 'has-sub' : ''}>
            <a href={item.href} class:list={[{ active: isActive(item.href), hl: 'highlight' in item }]}>
              {item.label}
              {'children' in item && <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>}
            </a>
            {'children' in item && (
              <div class="sub">
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>
                        <strong>{c.label}</strong>
                        {'note' in c && <span>{c.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={SITE.phoneHref}>{SITE.phone}</a>
      <a class="btn btn--lime cta" href="/contacto/">Pide tarifa 2026</a>
    </div>

    <details class="mobile">
      <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
      <nav aria-label="Principal móvil">
        {NAV.map((item) => (
          <div class="m-group">
            <a class="m-top" href={item.href}>{item.label}</a>
            {'children' in item && (
              <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
            )}
          </div>
        ))}
        <a class="btn btn--lime" href="/contacto/">Pide tarifa 2026</a>
        <a class="m-phone" href={SITE.phoneHref}>{SITE.phone}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--ink); color: var(--white); position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #2c2c2a; }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .logo { flex: none; display: block; }
  .logo :global(img) { width: 132px; height: auto; }

  .desktop { display: none; margin-left: auto; }
  .menu { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .menu > li { position: relative; }
  .menu > li > a { display: inline-flex; align-items: center; gap: 6px; color: #e7e4de; text-decoration: none; font-weight: 500; font-size: 0.93rem; padding: 10px 12px; border-radius: 8px; }
  .menu > li > a:hover, .menu > li > a.active { color: var(--white); background: #2a2a28; }
  .menu > li > a.hl { color: var(--lime); }
  .sub { position: absolute; top: 100%; left: 0; padding-top: 8px; display: none; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { display: block; }
  .sub ul { list-style: none; margin: 0; padding: 10px; background: var(--white); border-radius: var(--radius); box-shadow: 0 18px 40px rgba(0,0,0,.25); min-width: 320px; }
  .sub a { display: block; padding: 10px 12px; border-radius: 8px; text-decoration: none; color: var(--ink); }
  .sub a:hover { background: var(--sand-soft); }
  .sub strong { display: block; font-weight: 600; font-size: 0.95rem; }
  .sub span { display: block; font-size: 0.8rem; color: var(--ink-3); }

  .actions { display: none; align-items: center; gap: 16px; }
  .phone { color: #e7e4de; text-decoration: none; font-size: 0.9rem; white-space: nowrap; }
  .cta { padding: 0.7em 1.15em; font-size: 0.9rem; }

  .mobile { margin-left: auto; }
  .mobile summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; border-radius: 8px; }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile summary span { display: block; width: 22px; height: 2px; background: var(--white); }
  .mobile[open] summary { background: #2a2a28; }
  .mobile nav { position: absolute; left: 0; right: 0; top: 72px; background: var(--ink); padding: 8px var(--gutter) 24px; max-height: calc(100vh - 72px); overflow-y: auto; border-top: 1px solid #2c2c2a; }
  .m-group { border-bottom: 1px solid #2c2c2a; padding: 12px 0; }
  .m-top { color: var(--white); font-weight: 600; text-decoration: none; display: block; padding: 4px 0; }
  .m-group ul { list-style: none; padding: 0 0 0 12px; margin: 4px 0 0; }
  .m-group li a { color: #cfcbc4; text-decoration: none; display: block; padding: 6px 0; font-size: 0.95rem; }
  .mobile nav .btn { margin-top: 18px; width: 100%; }
  .m-phone { display: block; text-align: center; color: #cfcbc4; margin-top: 12px; }

  @media (min-width: 1080px) {
    .desktop, .actions { display: flex; }
    .mobile { display: none; }
  }
  @media (min-width: 1080px) and (max-width: 1240px) { .phone { display: none; } }
</style>
