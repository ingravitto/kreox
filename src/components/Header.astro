---
import { Image } from 'astro:assets';
import logo from '../assets/img/kreox-logo-blanco.png';
import { NAV, NAV_EN, SITE, waInfo } from '../data/site';
import { useT } from '../i18n/ui';
import { counterpart } from '../i18n/routes';
import WaIcon from './WaIcon.astro';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' || href === '/en/' ? path === href : path.startsWith(href));
const { lang, t, P } = useT(Astro.url);
const nav = lang === 'en' ? NAV_EN : NAV;
const pr = nav.products;
const prodActive = pr.groups.some((g) => path.startsWith(g.href));
// Selector de idioma: enlaza a la misma página en el otro idioma (o a su portada si no existe).
const langs = [
  { code: 'es', label: 'ES', name: 'Español', href: path.startsWith('/404') ? '/' : lang === 'es' ? path : counterpart(path, 'es') },
  { code: 'en', label: 'EN', name: 'English', href: lang === 'en' ? path : counterpart(path, 'en') },
] as const;
const other = langs.find((l) => l.code !== lang)!;
---
<header class:list={['site-header', { overlay }]} data-header>
  <div class="container bar">
    <a href={P.home} class="logo" aria-label={t('goHome')}>
      <Image src={logo} alt="KREOX" width={104} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="desktop" aria-label={t('navMain')}>
      <ul class="menu">
        <li class="has-sub" data-sub-li>
          <button type="button" class:list={['menu-btn', { active: prodActive }]} aria-expanded="false" aria-controls="mega" data-sub-toggle>
            {pr.label}
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </button>
          <div class="sub mega" id="mega">
            <div class="mega-in">
              {pr.groups.map((g) => (
                <div class:list={['mg-col', { 'mg-col--hl': 'highlight' in g }]}>
                  <p class="mg-h">{g.label}</p>
                  <ul>
                    {g.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                          <strong>{c.label}</strong>
                          {'note' in c && c.note && <span>{c.note}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="mg-all" href={g.href} aria-current={path === g.href ? 'page' : undefined}>{pr.seeAll}<span class="visually-hidden">: {g.label}</span> →</a>
                </div>
              ))}
              <a class="mg-tool" href={pr.tool.href} aria-current={path === pr.tool.href ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="4" y="2.5" width="16" height="19" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="7" y="5.5" width="10" height="4" rx="1" fill="currentColor" opacity=".35"/><path d="M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                <strong>{pr.tool.label}</strong>
                <span>{pr.tool.note}</span>
                <em>{pr.tool.cta} →</em>
              </a>
            </div>
          </div>
        </li>
        {nav.links.map((l) => (
          <li><a href={l.href} class:list={[{ active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <nav class="lang" aria-label={t('langSwitch')}>
        {langs.map((l) => <a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.label}<span class="visually-hidden"> · {l.name}</span></a>)}
      </nav>
    </div>

    <a class="m-lang" href={other.href} lang={other.code} hreflang={other.code}>{other.label}<span class="visually-hidden"> · {other.name}</span></a>
    <button type="button" class="m-open" aria-haspopup="dialog" aria-controls="m-menu" aria-expanded="false" data-m-open>
      <span class="m-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="m-open-label">{t('menu')}</span>
    </button>
  </div>
  <dialog id="m-menu" class="m-menu" aria-label={t('menuMain')} data-m-menu>
    <div class="m-head">
      <a href={P.home} class="logo" aria-label={t('goHome')}><Image src={logo} alt="KREOX" width={112} densities={[1, 2]} loading="lazy" /></a>
      <nav class="lang m-langs" aria-label={t('langSwitch')}>
        {langs.map((l) => <a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.label}<span class="visually-hidden"> · {l.name}</span></a>)}
      </nav>
      <button type="button" class="m-close" data-m-close>
        <span class="visually-hidden">{t('closeMenu')}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
      </button>
    </div>
    <nav class="m-nav" aria-label={t('navMobile')}>
      {pr.groups.map((g) => (
        <details class:list={['m-acc', { hl: 'highlight' in g }]} open={'highlight' in g || isActive(g.href) ? true : undefined}>
          <summary>
            <span>{g.label}</span>
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </summary>
          <ul>
            {g.children.map((c) => (
              <li>
                <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                  <strong>{c.label}</strong>
                  {'note' in c && c.note && <span>{c.note}</span>}
                </a>
              </li>
            ))}
            <li><a class="m-all" href={g.href} aria-current={path === g.href ? 'page' : undefined}>{t('seeAllIn')} {lang === 'en' ? g.label : g.label.toLowerCase()} →</a></li>
          </ul>
        </details>
      ))}
      <a class="m-tool" href={pr.tool.href} aria-current={path === pr.tool.href ? 'page' : undefined}><strong>{pr.tool.label}</strong><span>{pr.tool.note}</span></a>
      {nav.links.map((l) => (
        <a class="m-link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="m-foot">
      <a class="m-wa" href={waInfo(lang)} target="_blank" rel="noopener"><WaIcon size={18} />WhatsApp<span class="visually-hidden">{t('newWindow')}</span></a>
      <a class="m-call" href={SITE.phoneHref}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1z" fill="currentColor"/></svg>{t('callUs')}<span class="visually-hidden"> {SITE.phone}</span></a>
    </div>
  </dialog>
</header>

<script>
  // Submenús accesibles: botón con aria-expanded, Escape cierra y devuelve el foco, clic fuera cierra.
  const lis = [...document.querySelectorAll<HTMLElement>('[data-sub-li]')];
  const closeAll = (except?: HTMLElement) => lis.forEach((li) => {
    if (li === except) return;
    li.classList.remove('open');
    li.querySelector('[data-sub-toggle]')?.setAttribute('aria-expanded', 'false');
  });
  lis.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-sub-toggle]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const open = !li.classList.contains('open');
      closeAll(li);
      li.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && li.classList.contains('open')) { li.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.focus(); }
    });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) { li.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); } });
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-sub-li]')) closeAll(); });
  // Menú móvil: <dialog> modal (foco atrapado, Escape cierra), bloquea el scroll de fondo.
  const dlg = document.querySelector<HTMLDialogElement>('[data-m-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-m-open]');
  if (dlg && openBtn) {
    const setOpen = (o: boolean) => { openBtn.setAttribute('aria-expanded', String(o)); document.documentElement.classList.toggle('m-lock', o); };
    openBtn.addEventListener('click', () => { dlg.showModal(); setOpen(true); });
    dlg.querySelector('[data-m-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => { setOpen(false); openBtn.focus(); });
    dlg.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href^="#"]')) dlg.close(); });
    window.matchMedia('(min-width: 1120px)').addEventListener('change', (m) => { if (m.matches && dlg.open) dlg.close(); });
    window.addEventListener('pageshow', () => { if (dlg.open) dlg.close(); });
  }
  const h = document.querySelector<HTMLElement>('[data-header]');
  if (h) {
    const on = () => h.classList.toggle('is-scrolled', window.scrollY > 24);
    requestAnimationFrame(on);
    window.addEventListener('scroll', on, { passive: true });
  }
</script>

<style>
  /* Cabecera flotante en píldora: separada de los bordes, cristal oscuro y siempre visible al hacer scroll.
     --header-h (global) = hueco que ocupa: margen superior + altura de la píldora. */
  .site-header {
    --hd-top: 10px; --hd-bar: 60px;
    position: fixed; top: var(--hd-top); left: 10px; right: 10px; z-index: 50;
    max-width: calc(var(--container) - 24px); margin-inline: auto;
    color: var(--white); border-radius: 999px;
    background: rgba(20, 20, 19, 0.78);
    backdrop-filter: saturate(160%) blur(18px); -webkit-backdrop-filter: saturate(160%) blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: background .35s var(--ease), box-shadow .35s var(--ease), top .35s var(--ease), border-color .35s var(--ease);
  }
  .site-header:not(.overlay) { background: rgba(20, 20, 19, 0.94); }
  .site-header.overlay:not(.is-scrolled) { background: rgba(20, 20, 19, 0.38); border-color: rgba(255, 255, 255, 0.16); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12); }
  .site-header.is-scrolled { background: rgba(20, 20, 19, 0.88); box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.06); }
  .bar.container { max-width: none; padding-inline: 18px 7px; }
  .bar { display: flex; align-items: center; gap: 28px; height: var(--hd-bar); transition: height .35s var(--ease); }
  @media (min-width: 760px) { .site-header { --hd-top: 14px; --hd-bar: 62px; left: 16px; right: 16px; } .bar.container { padding-inline: 24px 9px; } }
  @media (min-width: 1120px) { .site-header.is-scrolled { --hd-top: 10px; } .is-scrolled .bar { height: 56px; } }
  .logo { flex: none; display: block; }
  .logo :global(img) { width: 104px; height: auto; }

  .bar { position: relative; }
  .desktop { display: none; margin-inline: auto; align-self: stretch; }
  .menu { list-style: none; display: flex; align-items: stretch; gap: 2px; height: 100%; margin: 0; padding: 0; }
  .menu > li { display: flex; align-items: center; }
  .menu > li > a, .menu-btn { white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,.82); text-decoration: none; font: 400 0.9rem/1.2 var(--font); padding: 10px 14px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; transition: color .2s, background .2s; }
  .menu > li > a:hover, .menu > li > a.active, .menu-btn:hover, .open .menu-btn { color: var(--white); background: rgba(255,255,255,.07); }
  .menu-btn { color: var(--sand); }
  .menu-btn.active { box-shadow: inset 0 0 0 1px rgba(199,178,154,.45); }
  .menu-btn svg { transition: transform .2s; }
  .open .menu-btn svg { transform: rotate(180deg); }

  /* Panel de productos: centrado bajo la barra, una columna por línea + calculadora */
  .sub { position: absolute; top: 100%; left: 50%; translate: -50% 0; width: min(980px, calc(100vw - 32px)); padding-top: 10px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .25s var(--ease), transform .25s var(--ease), visibility .25s; }
  .has-sub:hover .sub, .has-sub.open .sub { opacity: 1; visibility: visible; transform: none; }
  .mega-in { display: grid; grid-template-columns: 1.35fr 1fr .85fr; gap: 8px; padding: 12px; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: var(--radius); box-shadow: 0 30px 60px rgba(0,0,0,.45); }
  .mg-col { padding: 8px 6px; }
  .mg-col + .mg-col { border-left: 1px solid var(--line-dark); padding-left: 14px; }
  .mg-col { display: flex; flex-direction: column; }
  .mg-h { margin: 0; padding: 6px 10px 10px; color: var(--on-dark-soft); font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .mg-col--hl .mg-h { color: var(--sand); }
  .mg-all { align-self: flex-start; margin-top: auto; padding: 12px 10px 4px; color: var(--sand); text-decoration: none; font-size: .8rem; font-weight: 500; }
  .mg-all:hover { color: var(--white); }
  .mg-col ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 2px; }
  .mg-col li a { display: block; padding: 10px; border-radius: 12px; text-decoration: none; color: var(--white); transition: background .2s; }
  .mg-col li a:hover, .mg-col li a[aria-current='page'] { background: rgba(255,255,255,.06); }
  .mg-col strong { display: block; font-weight: 500; font-size: .92rem; }
  .mg-col li span { display: block; font-size: .76rem; color: var(--on-dark-soft); margin-top: 3px; line-height: 1.35; }
  .mg-tool { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: calc(var(--radius) - 6px); background: linear-gradient(160deg, rgba(199,178,154,.2), rgba(199,178,154,.06)); border: 1px solid rgba(199,178,154,.3); color: var(--white); text-decoration: none; transition: background .2s, border-color .2s; }
  .mg-tool:hover { border-color: var(--sand); background: linear-gradient(160deg, rgba(199,178,154,.28), rgba(199,178,154,.1)); }
  .mg-tool svg { color: var(--sand); margin-bottom: 6px; }
  .mg-tool strong { font-weight: 600; font-size: 1rem; }
  .mg-tool span { font-size: .84rem; color: var(--on-dark-soft); }
  .mg-tool em { margin-top: auto; padding-top: 10px; font-style: normal; font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--sand); }

  .actions { display: none; align-items: center; gap: 18px; }
  .cta { padding: 0.95em 1.4em; }

  .lang { display: flex; gap: 2px; padding: 3px; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; background: rgba(255,255,255,.04); }
  .lang a { min-width: 34px; padding: 6px 8px; border-radius: 999px; text-align: center; color: rgba(255,255,255,.82); text-decoration: none; font-size: .74rem; font-weight: 600; letter-spacing: .08em; line-height: 1; }
  .lang a:hover { color: var(--white); background: rgba(255,255,255,.08); }
  .lang a[aria-current] { background: var(--white); color: var(--ink); }
  .m-langs { margin-left: auto; margin-right: 12px; }
  .m-lang { margin-left: auto; display: inline-grid; place-content: center; min-width: 46px; height: 46px; padding: 0 12px; border-radius: 999px; border: 0; background: rgba(255,255,255,.09); color: var(--white); text-decoration: none; font-size: .8rem; font-weight: 600; letter-spacing: .08em; }
  .m-lang + .m-open { margin-left: 6px; }
  .m-lang:hover, .m-open:hover { background: rgba(255,255,255,.16); }
  .m-open { margin-left: auto; display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 16px 0 14px; border-radius: 999px; border: 0; background: rgba(255,255,255,.09); color: var(--white); font: 500 .9rem/1 var(--font); cursor: pointer; }
  .m-bars { display: grid; gap: 4px; }
  .m-bars i { display: block; width: 18px; height: 1.6px; background: currentColor; border-radius: 2px; }
  .m-bars i:nth-child(2) { width: 12px; }

  .m-menu { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: var(--ink); color: var(--white); overflow: hidden; }
  .m-menu[open] { display: flex; flex-direction: column; }
  .m-menu::backdrop { background: rgba(0,0,0,.6); }
  @media (prefers-reduced-motion: no-preference) { .m-menu[open] { animation: m-in .28s var(--ease); } }
  @keyframes m-in { from { opacity: 0; transform: translateY(-12px); } }
  .m-head { flex: none; display: flex; align-items: center; justify-content: space-between; height: var(--header-h); padding: 0 var(--gutter); border-bottom: 1px solid var(--line-dark); }
  .m-head .logo :global(img) { width: 112px; height: auto; }
  .m-close { width: 46px; height: 46px; display: grid; place-content: center; border-radius: 50%; border: 1px solid rgba(255,255,255,.28); background: transparent; color: var(--white); cursor: pointer; }
  .m-nav { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 8px var(--gutter) 24px; }
  .m-acc { border-bottom: 1px solid var(--line-dark); }
  .m-acc summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; cursor: pointer; font-weight: 600; font-size: 1.15rem; }
  .m-acc summary::-webkit-details-marker { display: none; }
  .m-acc.hl summary { color: var(--sand); }
  .m-acc summary svg { flex: none; transition: transform .2s; }
  .m-acc[open] summary svg { transform: rotate(180deg); }
  .m-acc ul { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 2px; }
  .m-acc li a { display: block; padding: 11px 14px; border-radius: 12px; text-decoration: none; color: var(--white); background: rgba(255,255,255,.04); }
  .m-acc li a strong { display: block; font-weight: 500; font-size: 1rem; }
  .m-acc li a span { display: block; font-size: .8rem; color: var(--on-dark-soft); margin-top: 2px; }
  .m-acc li a[aria-current='page'] { background: rgba(199,178,154,.16); box-shadow: inset 3px 0 0 var(--sand); }
  .m-acc .m-all { background: transparent; color: var(--sand); font-size: .92rem; }
  .m-tool { display: block; margin: 14px 0 6px; padding: 14px 16px; border-radius: 14px; background: rgba(199,178,154,.12); border: 1px solid rgba(199,178,154,.3); color: var(--white); text-decoration: none; }
  .m-tool strong { display: block; font-weight: 600; font-size: 1rem; }
  .m-tool span { display: block; font-size: .82rem; color: var(--on-dark-soft); margin-top: 2px; }
  .m-tool[aria-current='page'] { border-color: var(--sand); }
  .m-link { display: flex; align-items: center; min-height: 60px; border-bottom: 1px solid var(--line-dark); color: var(--white); text-decoration: none; font-weight: 600; font-size: 1.15rem; }
  .m-link[aria-current='page'] { color: var(--sand); }
  .m-foot { flex: none; display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px; padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line-dark); background: var(--ink-2); }
  .m-wa, .m-call { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; border-radius: 999px; font-weight: 600; font-size: .92rem; text-decoration: none; white-space: nowrap; }
  .m-wa { background: #075e54; color: #fff; }
  .m-call { background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,.4); }

  @media (min-width: 1120px) and (max-width: 1279px) { .bar { gap: 18px; } .menu > li > a, .menu-btn { padding: 10px 11px; font-size: .88rem; } }
  @media (min-width: 1120px) {
    .desktop, .actions { display: flex; }
    .m-open, .m-lang { display: none; }
  }
</style>
