---
import { Image } from 'astro:assets';
import bg from '../assets/img/fondo-piedra-productos-kreox.jpg';
import { SITE } from '../data/site';
interface Props { title?: string; text?: string; interes?: 'nivelacion' | 'azulejos' }
const {
  title = 'Pide la tarifa 2026',
  text = 'Te enviamos la tarifa y te asesoramos sobre cuántos niveladores necesitas para tu obra.',
  interes = 'nivelacion',
} = Astro.props;
---
<section class="cta section section--dark">
  <Image src={bg} alt="" widths={[960, 1920]} sizes="100vw" class="bg" />
  <div class="shade" aria-hidden="true"></div>
  <div class="container inner on-dark" data-reveal>
    <span class="eyebrow">Consigue nuestra tarifa</span>
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="btn-row">
      <a class="btn btn--sand" href={`/contacto/?interes=${interes}`}>Pedir tarifa <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
      <a class="btn btn--ghost" href={SITE.phoneHref}>{SITE.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta { overflow: hidden; }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .45; }
  .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18,18,17,.95) 10%, rgba(18,18,17,.6) 60%, rgba(18,18,17,.3)); }
  .inner { position: relative; max-width: var(--container); }
  h2 { max-width: 640px; }
  .lead { color: var(--on-dark); max-width: 560px; }
</style>
