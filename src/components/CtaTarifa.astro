---
import { SITE } from '../data/site';
interface Props { title?: string; text?: string; interes?: 'nivelacion' | 'azulejos' }
const {
  title = 'Pide la tarifa 2026',
  text = 'Te enviamos la tarifa y te asesoramos sobre cuántos niveladores necesitas para tu obra.',
  interes = 'nivelacion',
} = Astro.props;
---
<section class="section section--dark cta">
  <div class="container inner">
    <div>
      <span class="eyebrow">Departamento comercial</span>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--lime" href={`/contacto/?interes=${interes}`}>Pedir tarifa</a>
      <a class="btn btn--ghost" href={SITE.phoneHref}>Llamar {SITE.phone}</a>
    </div>
  </div>
</section>
<style>
  .inner { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 900px) { .inner { grid-template-columns: 1.4fr auto; } }
  h2 { margin-bottom: 0.3em; }
  p { margin: 0; }
</style>
