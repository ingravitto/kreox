---
interface Props { items: { name: string; url: string }[]; dark?: boolean }
const { items, dark = false } = Astro.props;
---
<nav class:list={['crumbs', { 'container': !dark, dark }]} aria-label="Migas de pan">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.url}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { padding-top: 22px; }
  .crumbs.dark { padding-top: 0; margin-bottom: 28px; }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-soft); }
  .dark ol { color: var(--on-dark-soft); }
  li:not(:last-child)::after { content: '/'; margin-left: 8px; color: var(--sand); }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--sand-strong); }
  .dark a:hover { color: var(--sand); }
  [aria-current] { color: var(--ink); }
  .dark [aria-current] { color: var(--white); }
</style>
